# The phone app's two build-time values. Copy to apps/mobile/.env for a
# laptop; a cloud build gets them from eas.json and the EAS environment
# instead, because Expo does not upload .env to EAS Build.

# Which deployment this build talks to.
#
# localhost works only for the simulator: ON A REAL PHONE, localhost IS
# THE PHONE. Testing on a device means the dev machine's LAN IP (e.g.
# http://192.168.1.20:3000) or a deployed URL — which is why the
# development EAS profile hardcodes nothing, and why lib/env.ts refuses
# to let a release build carrying localhost pretend it is simply offline.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# Clerk's publishable key, and THE INSTANCE IT BELONGS TO IS THE POINT.
# `pk_live_` is the Production instance (clerk.cstream.ai) and pairs with
# https://app.cstream.ai; `pk_test_` is Development (striking-jaybird…)
# and pairs with a preview or a local server. Crossing them gives a build
# that signs in against one company's users and reads another's data.
# Never commit a real value — see CLAUDE.md on the two Clerk instances.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=""

# ---------------------------------------------------------------------
# For a cloud build (EAS), set the pair per environment ONCE:
#
#   eas env:create --environment production \
#     --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_live_...
#   eas env:create --environment preview \
#     --name EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY --value pk_test_...
#   eas env:create --environment preview \
#     --name EXPO_PUBLIC_API_URL --value https://<the deployment to test>
#
# EXPO_PUBLIC_API_URL is in eas.json for development and production, where
# the answer never changes. Preview is deliberately left out of the file:
# a preview build has to be TOLD which deployment it is testing, because
# the convenient default — production — has testers writing real rows.
