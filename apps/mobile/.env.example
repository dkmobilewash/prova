# The mobile client's target API host. NOT localhost when testing on a real
# phone — use the dev machine's LAN IP (e.g. http://192.168.1.20:3000) or a
# deployed preview, so the phone can reach it.
EXPO_PUBLIC_API_URL="http://localhost:3000"

# The DEVELOPMENT Clerk instance's publishable key (striking-jaybird …).
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
