DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Used by generateWipNarrative (WIP narrative) and extractComplianceDocument
# (AI document extraction, see /compliance). From console.anthropic.com.
ANTHROPIC_API_KEY=""

# Vercel Blob store token for uploaded compliance documents (see
# uploadComplianceDocument). Create a Blob store on the Vercel project and
# copy its token, or run `vercel env pull` once one exists.
BLOB_READ_WRITE_TOKEN=""

# QuickBooks Online OAuth (see packages/integrations/src/quickbooks.ts).
# Client ID/Secret come from your Intuit Developer app's Keys page — never
# commit real values. Redirect URI must exactly match one registered on
# that app: <your deployed origin>/api/quickbooks/callback.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"

# Outbound email. All three are needed before the app can send anything;
# without them /messages shows a setup state and sending is refused rather
# than failing silently.
#
# OUTBOUND_EMAIL_FROM must be an address on YOUR OWN domain, verified with
# the provider. Sending as the vendor is what puts quotes in spam — that is
# the single most-repeated deliverability complaint in the competitor
# research, so there is deliberately no shared-sender fallback.
#
# Without RESEND_WEBHOOK_SECRET the delivery webhook rejects every event.
# That is intentional: an unverified "delivered" is worse than no event.
RESEND_API_KEY=
OUTBOUND_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# The nightly alert digest (see app/api/notifications/digest/route.ts and
# the `crons` entry in vercel.json). BOTH are required before anything
# unattended sends; the route returns 503 and sends nothing without either.
#
# CRON_SECRET is what Vercel puts in `Authorization: Bearer …` on a cron
# request, and it is the ONLY thing between that URL and a button anyone on
# the internet can press to mail every user of every company. Unset must
# mean the schedule does not work — never that it works for everybody.
#
# NOTIFY_BASE_URL is the origin every link in a scheduled email is built
# from. It is configuration and NOT a request header on purpose: this run
# mails other people, so a host taken from whatever triggered the cron
# would end up in their emails. There is no default — a working-looking
# email whose links go to the wrong deployment is worse than no email.
CRON_SECRET=
NOTIFY_BASE_URL="http://localhost:3000"
