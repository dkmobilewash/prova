DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
CLERK_SECRET_KEY="sk_test_..."
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL="/dashboard"
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL="/dashboard"

# Used by generateWipNarrative (WIP narrative), extractComplianceDocument
# (AI document extraction, see /compliance), draftEstimateLineItems, and the
# dashboard's Ask box (lib/ask — answers and commands). From
# console.anthropic.com. Needed on Vercel Preview too, or Ask cannot be
# clicked on a preview.
ANTHROPIC_API_KEY=""

# Vercel Blob store token for uploaded compliance documents (see
# uploadComplianceDocument). Create a Blob store on the Vercel project and
# copy its token, or run `vercel env pull` once one exists.
BLOB_READ_WRITE_TOKEN=""

# QuickBooks Online OAuth (see packages/integrations/src/quickbooks.ts).
# Client ID/Secret come from your Intuit Developer app's Keys page — never
# commit real values. Redirect URI must exactly match one registered on
# that app: <your deployed origin>/api/quickbooks/callback.
QUICKBOOKS_CLIENT_ID=""
QUICKBOOKS_CLIENT_SECRET=""
QUICKBOOKS_REDIRECT_URI="http://localhost:3000/api/quickbooks/callback"
QUICKBOOKS_ENVIRONMENT="sandbox"

# Outbound email. All three are needed before the app can send anything;
# without them /messages shows a setup state and sending is refused rather
# than failing silently.
#
# OUTBOUND_EMAIL_FROM must be an address on YOUR OWN domain, verified with
# the provider. Sending as the vendor is what puts quotes in spam — that is
# the single most-repeated deliverability complaint in the competitor
# research, so there is deliberately no shared-sender fallback.
#
# Without RESEND_WEBHOOK_SECRET the delivery webhook rejects every event.
# That is intentional: an unverified "delivered" is worse than no event.
RESEND_API_KEY=
OUTBOUND_EMAIL_FROM=
RESEND_WEBHOOK_SECRET=

# Inbound email -> the /intake tray ("forward documents to…"). Both unset
# means the feature is absent, not broken: /intake shows no address and the
# webhook answers 503.
#
# INTAKE_INBOUND_DOMAIN is the receiving subdomain (e.g. in.cstream.ai),
# MX'd to Resend — the domain half of every company's docs-<token> address.
# RESEND_INBOUND_WEBHOOK_SECRET is the signing secret of the SEPARATE
# Resend webhook endpoint for email.received events; it is not
# RESEND_WEBHOOK_SECRET, because the two endpoints have different secrets
# and pasting one into the other rejects every event. Attachment content is
# fetched with RESEND_API_KEY above.
INTAKE_INBOUND_DOMAIN=
RESEND_INBOUND_WEBHOOK_SECRET=

# Where "Help" in the topbar sends a contractor's question (lib/help-config.ts).
# OUR address, not theirs — the one a person actually reads.
#
# Unset means the help panel says plainly that nothing can reach us, which is
# the truth and is better than a Send button that goes nowhere. A typo means
# the same thing: the value is checked with looksLikeEmail and ignored unless
# it is an address, because a panel offering "mailto:suport@" is a dead end
# that LOOKS like a working one.
#
# The three above decide HOW it goes. With them set, the request is sent
# server-side from the contractor's own domain and lands in /messages with its
# delivery status. Without them there is no shared sender to fall back on, so
# the panel offers a mailto: to this address instead and says so — which is
# the state every brand-new customer is in.
SUPPORT_EMAIL=

# The nightly alert digest (see app/api/notifications/digest/route.ts and
# the `crons` entry in vercel.json). BOTH are required before anything
# unattended sends; the route returns 503 and sends nothing without either.
#
# CRON_SECRET is what Vercel puts in `Authorization: Bearer …` on a cron
# request, and it is the ONLY thing between that URL and a button anyone on
# the internet can press to mail every user of every company. Unset must
# mean the schedule does not work — never that it works for everybody.
#
# NOTIFY_BASE_URL is the origin every link in a scheduled email is built
# from. It is configuration and NOT a request header on purpose: this run
# mails other people, so a host taken from whatever triggered the cron
# would end up in their emails. There is no default — a working-looking
# email whose links go to the wrong deployment is worse than no email.
CRON_SECRET=
NOTIFY_BASE_URL="http://localhost:3000"

# Cold outbound (Smartlead). The nightly push (/api/cron/outbound-push, 14:00
# UTC) and the "Push leads now" button on /sales send nothing unless ALL of
# SMARTLEAD_API_KEY, SMARTLEAD_CAMPAIGN_ID, OUTBOUND_TOKEN_SECRET and
# NOTIFY_BASE_URL are set — the last two build the unsubscribe link every
# email must carry.
SMARTLEAD_API_KEY=
# The numeric campaign id from the campaign's URL in Smartlead.
SMARTLEAD_CAMPAIGN_ID=
# Leads pushed per rolling 24 hours, cron and button together. Blank = 50.
# This is the domain warm-up limit; raising it early is how a domain is burned.
OUTBOUND_DAILY_CAP=
# Signs /unsubscribe/<token> links. Any long random string. NEVER rotate it:
# every link already sent stops working.
OUTBOUND_TOKEN_SECRET=
# Verifies /api/webhooks/outbound (reply, bounce, unsubscribe events).
SMARTLEAD_WEBHOOK_SECRET=

# Push notifications to the phone (Expo). An access token minted at
# expo.dev; without it every push reports `configured: false` and is
# skipped — never thrown, never a failure of the email digest it rides
# with. Push additionally needs a NATIVE build (not Expo Go), because the
# token registration is a native module.
EXPO_ACCESS_TOKEN=

# ─────────────────────────────────────────────────────────────────────────
# THE SEVEN OAUTH INTEGRATIONS
#
# None of these was documented here until 2026-10-02, and QuickBooks above
# was the only one of eight that was. An audit of all eight found the cards
# are honest — every round trip closes in code — but nobody can SET one up
# without reading `lib/<provider>/setup.ts` to discover the variable names
# exist at all. That is the gap this block closes.
#
# WITH THESE UNSET THE APP IS CORRECT, NOT BROKEN. Each card renders a
# "Not set up" pill and no Connect button, and each start route refuses
# before anything leaves the app — so hand-typing the URL does not produce
# a half-finished OAuth flow either. If an integration looks dead, check
# here before reading any code.
#
# Every one of them additionally needs INTEGRATION_TOKEN_KEY, below.

# Encrypts every stored OAuth token (AES-256-GCM, lib/crypto.ts). ONE key
# for all seven: without it every card reads "Not set up" no matter what
# else is filled in. There is no plaintext token column anywhere, so losing
# this key means every connection must be re-authorised — it is not
# recoverable from the database.
INTEGRATION_TOKEN_KEY=

# Jobber — imports clients, jobs and open quotes. Read-only.
JOBBER_CLIENT_ID=
JOBBER_CLIENT_SECRET=
JOBBER_REDIRECT_URI=

# CompanyCam — imports job photos. Read-only (the client refuses any
# non-GET). Its API needs a PAID CompanyCam plan on the account, not just
# an app registration.
COMPANYCAM_CLIENT_ID=
COMPANYCAM_CLIENT_SECRET=
COMPANYCAM_REDIRECT_URI=

# DocuSign — sends contracts and change orders for signature and stores the
# executed copy. DOCUSIGN_ENV selects the host: "demo" for
# account-d.docusign.com, "production" for account.docusign.com.
# DOCUSIGN_CONNECT_HMAC_KEY verifies Connect webhooks; without it the
# webhook fails CLOSED and only the Refresh button updates a status.
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_REDIRECT_URI=
DOCUSIGN_ENV="demo"
DOCUSIGN_CONNECT_HMAC_KEY=

# Procore — reads a GC's drawings, RFIs and submittals onto our own pages.
# Read-only. PROCORE_ENVIRONMENT is optional: unset = production hosts,
# "sandbox" = Procore's sandbox. Production access additionally needs
# Procore Marketplace Partner verification, and the GC's company admin must
# install the app before a sub can see any of their projects.
PROCORE_CLIENT_ID=
PROCORE_CLIENT_SECRET=
PROCORE_REDIRECT_URI=
PROCORE_ENVIRONMENT=

# Autodesk Construction Cloud — RFIs and submittals only (sheets need the
# Model Derivative flow and are not built). There is no APS sandbox host,
# so testing needs a real ACC hub whose account admin has added the app as
# a Custom Integration. Note APS refresh tokens expire after 15 DAYS, and
# nothing refreshes unattended — a connection on a job nobody opens for a
# fortnight will need reconnecting.
ACC_CLIENT_ID=
ACC_CLIENT_SECRET=
ACC_REDIRECT_URI=

# Bluebeam — creates a Studio Session per job, pushes a PDF, reads back
# file and markup counts. BLUEBEAM_REGION is optional and must be one of
# US, UK, DE, SE, AU; anything else reads as not set up. Refresh tokens die
# after 7 days. Sandbox access needs a BBID plus a paid Bluebeam plan.
BLUEBEAM_CLIENT_ID=
BLUEBEAM_CLIENT_SECRET=
BLUEBEAM_REDIRECT_URI=
BLUEBEAM_REGION="US"

# Email finder (/sales) — Brave Search finds a lead's own website by name and
# city. Without it, Find email only works on leads whose website is typed in.
BRAVE_SEARCH_API_KEY=
# MillionVerifier checks a found or guessed address exists before it is saved
# as verified. Without it, addresses are saved as unverified guesses, and say so.
MILLIONVERIFIER_API_KEY=
