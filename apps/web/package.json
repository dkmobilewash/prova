{
  "name": "@prova/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test --config e2e/playwright.config.ts",
    "test:e2e:local": "node e2e/run.mjs",
    "test:e2e:public": "node e2e/run.mjs --public",
    "ask:eval": "vitest run --config vitest.eval.config.mts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.9.6",
    "@prova/db": "workspace:*",
    "@prova/integrations": "workspace:*",
    "@prova/ui": "workspace:*",
    "@vercel/blob": "^2.8.0",
    "next": "^15.1.3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@clerk/backend": "2.33.6",
    "@clerk/testing": "2.2.36",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "autoprefixer": "^10.4.20",
    "embedded-postgres": "16.14.0-beta.17",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.3",
    "eslint-plugin-react-hooks": "^5.1.0",
    "happy-dom": "^20.14.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  }
}
