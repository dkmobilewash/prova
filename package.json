{
  "name": "prova",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:db": "pnpm --filter @prova/web run test:db",
    "eval:addenda": "pnpm --filter @prova/web run eval:addenda",
    "eval:draft-lines": "pnpm --filter @prova/web run eval:draft-lines",
    "eval:bid-research": "pnpm --filter @prova/web run eval:bid-research",
    "eval:lead-search": "pnpm --filter @prova/web run eval:lead-search",
    "eval:symbols": "pnpm --filter @prova/web run eval:symbols",
    "test:e2e": "pnpm --filter @prova/web run test:e2e:local",
    "test:e2e:public": "pnpm --filter @prova/web run test:e2e:public",
    "db:generate": "pnpm --filter @prova/db generate",
    "db:migrate": "pnpm --filter @prova/db migrate:dev",
    "db:studio": "pnpm --filter @prova/db studio",
    "changelog:collect": "node scripts/changelog-collect.mjs",
    "changelog:check": "node scripts/changelog-collect.mjs --check"
  },
  "devDependencies": {
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "19.0.14"
    },
    "onlyBuiltDependencies": [
      "@embedded-postgres/darwin-arm64",
      "@embedded-postgres/darwin-x64",
      "@embedded-postgres/linux-arm64",
      "@embedded-postgres/linux-x64"
    ]
  }
}
