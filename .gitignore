# ── THE SMOKE TEST'S BUILD DIRECTORY ──
#
# `scripts/smoke-labeling.sh` builds into `.next-smoke` so it cannot clobber
# the `.next` a running labelling server is serving from. Unignored, three
# censuses walked its compiled bundles and reported them as database writers
# that skip their counter — a real finding about generated code nobody wrote.
.next-smoke
.expo
expo-env.d.ts
out
build

# env
.env.bak
.env.*.bak
*.bak
.env
.env.local
.env.*.local

# prisma
packages/db/node_modules

# misc
.DS_Store
*.log
coverage
*.tsbuildinfo

# playwright
apps/web/playwright-report
apps/web/test-results
# ...and the public suite's own two, which playwright.public.config.ts pins
# explicitly rather than letting Playwright default them — three places
# assuming the same default is how one of them ends up committing a report.
apps/web/playwright-report-public
apps/web/test-results-public
apps/web/playwright-report-lien-waiver
apps/web/test-results-lien-waiver
apps/web/blob-report

# expo prebuild output — generated from app.json + plugins/, never edited by hand
# and 1.2GB once built. `npx expo prebuild` writes these; anything that needs to
# persist belongs in app.json or a config plugin, which is the whole reason
# plugins/withSceneLifecycle.js exists rather than a patched AppDelegate.swift.
apps/mobile/ios
apps/mobile/android
