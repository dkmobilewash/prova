// Field operations: locations, vendors, equipment, punch lists.
// Cyrus's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum LocationType {
  HQ
  BRANCH_YARD
  WAREHOUSE
  TRAILER
}

/// A physical office/yard/warehouse. `state` is broken out from the
/// address specifically because it's what would eventually let the app
/// auto-derive which CompanyLicense/CompanyUnionAgreement applies to a
/// Job via Job.operatingLocationId — that derivation logic isn't built
/// yet, but the field exists for it.
model CompanyLocation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  locationType LocationType
  /// Friendly label ("Denver Yard") for picking a location in a list —
  /// not explicitly requested, but without one a picker would just show
  /// raw addresses.
  name         String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  primaryContactName  String?
  primaryContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([companyId])
}

/// A material supplier or service vendor the company buys from — the
/// "who" behind a material cost, which until now was just a dollar
/// amount with no source attached. Deliberately standalone for now: no
/// job, cost, or pricing-history linkage yet (WORK-SPLIT.md task 2), so
/// nothing existing depends on it and it can grow later.
model Vendor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name String
  /// Which trade this vendor supplies. Optional because plenty of
  /// vendors (fasteners, general hardware, equipment rental) serve every
  /// trade the company runs, and forcing a choice would be misleading.
  tradeScope  TradeScope?
  contactName String?
  phone       String?
  email       String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// Company-owned equipment — scaffolding, lifts, mixers, welders. Step one
/// is knowing what you own and where it is; equipment cost allocation into
/// job costing is a later phase and deliberately not modelled here.
model Equipment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name String
  /// Free text rather than an enum. The categories vary too much by trade
  /// to fix a list now, and guessing wrong would mean a migration to add
  /// the one type a contractor actually owns.
  type     String?
  /// Serial or asset tag. Optional — plenty of small equipment has neither.
  assetTag String?

  /// Where it is right now. Null means "in the yard / unassigned", which
  /// is a normal state, not missing data.
  assignedJobId String?
  assignedJob   Job?    @relation(fields: [assignedJobId], references: [id])

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([assignedJobId])
}

/// A punch list item — something that has to be fixed or finished before a
/// job closes out. `JobStatus` runs ESTIMATE → COMPLETE with nothing
/// tracking what's outstanding in between, so today a job is marked
/// complete on somebody's memory of the walkthrough.
model PunchListItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  description String

  /// Who raised it. Set from the signed-in user rather than a form field —
  /// on a walkthrough nobody types their own name. Nullable so deleting a
  /// user doesn't take the punch list with them.
  raisedByUserId String?
  raisedBy       User?   @relation(fields: [raisedByUserId], references: [id])

  /// Denormalised rather than derived from completedAt: "done" is the thing
  /// people filter and count on, and a boolean keeps that query trivial.
  isDone      Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobId])
}

/// One record per job per day: who was on site, what got done, weather and
/// delays. Weather and delays are the point — a delay claim or a schedule
/// dispute months later gets argued from these, and nothing captured them
/// before.
model DailyFieldReport {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// Date only in practice; stored as DateTime because Prisma has no date
  /// type on Postgres. Always written at UTC midnight so the uniqueness
  /// constraint below behaves.
  reportDate DateTime

  /// Free text rather than a link to JobAssignment. On a real site the crew
  /// that showed up rarely matches the roster exactly, and forcing it to
  /// would make people record the roster instead of the truth.
  crewPresent   String?
  workPerformed String
  weather       String?
  /// Anything that cost time: late delivery, another trade in the way,
  /// inspection no-show. Blank means the day ran clean.
  delays        String?

  filedByUserId String?
  filedBy       User?   @relation(fields: [filedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One report per job per day, enforced here rather than in code. Two
  /// people filing the same day would leave contradictory records of what
  /// happened, which is worse than one person having to edit an existing
  /// entry.
  @@unique([jobId, reportDate])
  @@index([companyId])
  @@index([jobId])
}

/// OSHA's recordability ladder, most severe first. Anything above
/// FIRST_AID_ONLY is recordable on the 300 log; FIRST_AID_ONLY is not.
/// Storing the outcome and deriving recordability from it beats a
/// "recordable?" checkbox somebody ticks wrong under pressure.
enum IncidentOutcome {
  DEATH
  DAYS_AWAY
  RESTRICTED_OR_TRANSFER
  OTHER_RECORDABLE
  FIRST_AID_ONLY
}

/// The six columns OSHA's 300 log classifies a case into.
enum IncidentClassification {
  INJURY
  SKIN_DISORDER
  RESPIRATORY_CONDITION
  POISONING
  HEARING_LOSS
  OTHER_ILLNESS
}

/// A recordable or first-aid safety incident. Shaped to OSHA's 300 log
/// rather than as a free-text diary: without case number, classification
/// and outcome you cannot generate the log later, and the log is what gets
/// audited.
/// Issues OSHA case numbers. Deliberately NOT derived from SafetyIncident
/// rows: any number computed from the rows that still exist (a count, or
/// max+1) is freed again when a case is deleted, so the next case reissues
/// it. Duplicate case numbers within one year on a filed log are a finding.
/// This row only ever increments, so a deleted case's number is retired for
/// good. Incrementing inside the same transaction that creates the incident
/// also settles the race where two people file at the same moment.
model SafetyCaseCounter {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  caseYear  Int

  lastCaseNumber Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([companyId, caseYear])
}

model SafetyIncident {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Optional on purpose: injuries happen in the yard and the shop, not
  /// only on jobs. Forcing a job would make people attach incidents to
  /// whatever job was handy, which corrupts the record.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  /// Sequential per company per calendar year, the way OSHA case numbers
  /// run. Issued by SafetyCaseCounter at creation and never reissued, even
  /// after the case is deleted.
  caseNumber Int
  caseYear   Int

  occurredAt DateTime
  /// Free text, not a User link — injured parties include day labour and
  /// apprentices who may never have an account.
  employeeName String
  jobTitle     String?
  /// Where on site, e.g. "3rd floor east corridor".
  location     String?

  description    String
  classification IncidentClassification
  outcome        IncidentOutcome
  /// Only meaningful for DAYS_AWAY / RESTRICTED_OR_TRANSFER. OSHA counts
  /// calendar days, not work days.
  daysAway       Int?
  daysRestricted Int?

  reportedByUserId String?
  reportedBy       User?   @relation(fields: [reportedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, caseYear, caseNumber])
  @@index([companyId])
  @@index([jobId])
}

/// A toolbox talk / tailgate safety meeting. Union agreements and GC
/// contracts commonly require these be held and documented; the record is
/// the deliverable.
model ToolboxTalk {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String?
  job       Job?    @relation(fields: [jobId], references: [id])

  heldOn    DateTime
  topic     String
  presenter String?
  /// Free text roster. A signature sheet photo is the real artifact on a
  /// jobsite; capturing names here is the searchable version of it.
  attendees String?
  notes     String?

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobId])
}

/// An RFI — a formal written question to the GC or architect, and their
/// written answer. For a subcontractor this log is evidence first and a
/// question-tracker second: an RFI sent on a date and answered late is the
/// documentation behind a delay claim or a change order, and "we asked and
/// nobody got back to us" is worth nothing without the dates.
model Rfi {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Required, unlike safety incidents. An RFI is always about a set of
  /// drawings on a specific job — there is no such thing as a general one.
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  /// Sequential per job, issued by RfiCounter and never reissued. GCs
  /// reference these by number in correspondence, so a number that comes
  /// back after a deletion points at two different questions.
  number Int

  subject  String
  question String

  /// Where in the documents the question comes from. Free text: drawing
  /// numbering is per-project and not worth modelling.
  drawingReference String?
  specSection      String?

  status RfiStatus @default(DRAFT)

  /// Dates are the point of the record. sentOn is when it left our hands;
  /// dueBy is the response date the contract calls for; answeredOn is when
  /// it actually came back. Overdue is derived from these, never stored.
  sentOn     DateTime?
  dueBy      DateTime?
  answeredOn DateTime?
  answer     String?

  /// Flagged by whoever reads the answer. These do not create a change
  /// order or move a schedule — they mark the RFIs worth revisiting when
  /// someone builds the claim.
  costImpact     Boolean @default(false)
  scheduleImpact Boolean @default(false)

  askedByUserId String?
  askedBy       User?   @relation(fields: [askedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, number])
  @@index([companyId])
  @@index([jobId])
}

/// Issues RFI numbers per job. Same reasoning as SafetyCaseCounter: a
/// number computed from the RFIs that still exist (a count, or max+1) is
/// freed again when one is deleted, and the next RFI reissues it. This row
/// only increments.
model RfiCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

enum RfiStatus {
  /// Written but not sent. Not yet evidence of anything.
  DRAFT
  /// Sent to the GC or architect, awaiting a written answer.
  SENT
  /// Answered in writing. The answer text is the record.
  ANSWERED
  /// Answered and acted on, or withdrawn. Off the open list.
  CLOSED
}

/// A shop drawing or product-data submittal: something we sent the GC or
/// architect for approval before we build from it. Like an RFI it is an
/// evidence record first — what we sent, when, what came back, and which
/// revision is the one it is now legal to build from. The identity fields
/// (job, number) are what the GC has in writing and are never editable.
model Submittal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Required, same reasoning as RFIs: a submittal is always against a
  /// specific job's drawings and spec sections.
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  /// Sequential per job, issued by SubmittalCounter and never reissued —
  /// same rule as RFI and safety case numbers: anything derived from the
  /// rows that still exist can be reissued, because deleting a row changes
  /// the answer.
  number Int

  title       String
  description String?

  /// Free text, same as RFIs: numbering schemes are per-project.
  specSection      String?
  drawingReference String?

  /// Revision numbers are issued from this row, incremented in the same
  /// transaction as the revision insert. Derived from nothing — revisions
  /// are never deletable, but the rule is cheaper to keep than to argue
  /// about, and it also closes the race of two people resubmitting at once.
  lastRevision Int @default(0)

  submittedByUserId String?
  submittedBy       User?   @relation(fields: [submittedByUserId], references: [id])

  revisions SubmittalRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, number])
  @@index([companyId])
  @@index([jobId])
}

/// One round trip to the GC: we sent this revision on a date, and it came
/// back (or hasn't) with a result. The submittal's current status is
/// DERIVED from its latest revision on every render, never stored — a
/// stored status can disagree with the revision that supposedly produced
/// it, and that contradiction is what gets a sub building from a
/// superseded drawing. Sent revisions are correspondence and are never
/// deleted or renumbered.
model SubmittalRevision {
  id          String    @id @default(cuid())
  submittalId String
  submittal   Submittal @relation(fields: [submittalId], references: [id])

  /// 1-based, issued by Submittal.lastRevision in the sending transaction.
  revisionNumber Int

  /// All three dates are entered, not stamped, and stored at UTC midnight
  /// — same rule as RFIs. Recording last month's submittal today must not
  /// read as sent today, or the turnaround evidence is fiction.
  sentOn     DateTime
  dueBack    DateTime?
  returnedOn DateTime?

  /// What the stamp said, recorded when returnedOn is. Null while the GC
  /// still has it.
  outcome SubmittalOutcome?

  /// What "approved as noted" actually noted, or why it bounced.
  responseNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submittalId, revisionNumber])
  @@index([submittalId])
}

/// Same shape and reason as RfiCounter and SafetyCaseCounter.
model SubmittalCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

enum SubmittalOutcome {
  /// Build from this revision.
  APPROVED
  /// Build from this revision, incorporating the reviewer's notes.
  APPROVED_AS_NOTED
  /// Fix and send again. The ball is back in our court.
  REVISE_AND_RESUBMIT
  /// Not acceptable. Also our court, but usually a bigger conversation.
  REJECTED
}
