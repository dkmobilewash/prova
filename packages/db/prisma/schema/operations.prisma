// Field operations: locations, vendors, equipment, punch lists.
// Cyrus's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum LocationType {
  HQ
  BRANCH_YARD
  WAREHOUSE
  TRAILER
}

/// A physical office/yard/warehouse. `state` is broken out from the
/// address specifically because it's what would eventually let the app
/// auto-derive which CompanyLicense/CompanyUnionAgreement applies to a
/// Job via Job.operatingLocationId — that derivation logic isn't built
/// yet, but the field exists for it.
model CompanyLocation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  locationType LocationType
  /// Friendly label ("Denver Yard") for picking a location in a list —
  /// not explicitly requested, but without one a picker would just show
  /// raw addresses.
  name         String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  primaryContactName  String?
  primaryContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([companyId])
}

/// A material supplier or service vendor the company buys from — the
/// "who" behind a material cost, which until now was just a dollar
/// amount with no source attached. Deliberately standalone for now: no
/// job, cost, or pricing-history linkage yet (WORK-SPLIT.md task 2), so
/// nothing existing depends on it and it can grow later.
model Vendor {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name        String
  /// Which trade this vendor supplies. Optional because plenty of
  /// vendors (fasteners, general hardware, equipment rental) serve every
  /// trade the company runs, and forcing a choice would be misleading.
  tradeScope  TradeScope?
  contactName String?
  phone       String?
  email       String?
  notes       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  materialOrders MaterialOrder[]
  priceQuotes    VendorPriceQuote[]

  @@index([companyId])
}

/// Company-owned equipment — scaffolding, lifts, mixers, welders. Step one
/// is knowing what you own and where it is; equipment cost allocation into
/// job costing is a later phase and deliberately not modelled here.
model Equipment {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  name     String
  /// Free text rather than an enum. The categories vary too much by trade
  /// to fix a list now, and guessing wrong would mean a migration to add
  /// the one type a contractor actually owns.
  type     String?
  /// Serial or asset tag. Optional — plenty of small equipment has neither.
  assetTag String?

  /// Where it is right now. Null means "in the yard / unassigned", which
  /// is a normal state, not missing data.
  assignedJobId String?
  assignedJob   Job?    @relation(fields: [assignedJobId], references: [id])

  notes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([assignedJobId])
}

/// A punch list item — something that has to be fixed or finished before a
/// job closes out. `JobStatus` runs ESTIMATE → COMPLETE with nothing
/// tracking what's outstanding in between, so today a job is marked
/// complete on somebody's memory of the walkthrough.
model PunchListItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  description String

  /// Who raised it. Set from the signed-in user rather than a form field —
  /// on a walkthrough nobody types their own name. Nullable so deleting a
  /// user doesn't take the punch list with them.
  raisedByUserId String?
  raisedBy       User?   @relation(fields: [raisedByUserId], references: [id])

  /// Denormalised rather than derived from completedAt: "done" is the thing
  /// people filter and count on, and a boolean keeps that query trivial.
  isDone      Boolean   @default(false)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobId])
}

/// One record per job per day: who was on site, what got done, weather and
/// delays. Weather and delays are the point — a delay claim or a schedule
/// dispute months later gets argued from these, and nothing captured them
/// before.
model DailyFieldReport {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// Date only in practice; stored as DateTime because Prisma has no date
  /// type on Postgres. Always written at UTC midnight so the uniqueness
  /// constraint below behaves.
  reportDate DateTime

  /// Free text rather than a link to JobAssignment. On a real site the crew
  /// that showed up rarely matches the roster exactly, and forcing it to
  /// would make people record the roster instead of the truth.
  crewPresent   String?
  workPerformed String
  weather       String?
  /// Anything that cost time: late delivery, another trade in the way,
  /// inspection no-show. Blank means the day ran clean.
  delays        String?

  filedByUserId String?
  filedBy       User?   @relation(fields: [filedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One report per job per day, enforced here rather than in code. Two
  /// people filing the same day would leave contradictory records of what
  /// happened, which is worse than one person having to edit an existing
  /// entry.
  @@unique([jobId, reportDate])
  @@index([companyId])
  @@index([jobId])
}

/// OSHA's recordability ladder, most severe first. Anything above
/// FIRST_AID_ONLY is recordable on the 300 log; FIRST_AID_ONLY is not.
/// Storing the outcome and deriving recordability from it beats a
/// "recordable?" checkbox somebody ticks wrong under pressure.
enum IncidentOutcome {
  DEATH
  DAYS_AWAY
  RESTRICTED_OR_TRANSFER
  OTHER_RECORDABLE
  FIRST_AID_ONLY
}

/// The six columns OSHA's 300 log classifies a case into.
enum IncidentClassification {
  INJURY
  SKIN_DISORDER
  RESPIRATORY_CONDITION
  POISONING
  HEARING_LOSS
  OTHER_ILLNESS
}

/// A recordable or first-aid safety incident. Shaped to OSHA's 300 log
/// rather than as a free-text diary: without case number, classification
/// and outcome you cannot generate the log later, and the log is what gets
/// audited.
/// Issues OSHA case numbers. Deliberately NOT derived from SafetyIncident
/// rows: any number computed from the rows that still exist (a count, or
/// max+1) is freed again when a case is deleted, so the next case reissues
/// it. Duplicate case numbers within one year on a filed log are a finding.
/// This row only ever increments, so a deleted case's number is retired for
/// good. Incrementing inside the same transaction that creates the incident
/// also settles the race where two people file at the same moment.
model SafetyCaseCounter {
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  caseYear  Int

  lastCaseNumber Int @default(0)

  updatedAt DateTime @updatedAt

  @@id([companyId, caseYear])
}

model SafetyIncident {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Optional on purpose: injuries happen in the yard and the shop, not
  /// only on jobs. Forcing a job would make people attach incidents to
  /// whatever job was handy, which corrupts the record.
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  /// Sequential per company per calendar year, the way OSHA case numbers
  /// run. Issued by SafetyCaseCounter at creation and never reissued, even
  /// after the case is deleted.
  caseNumber Int
  caseYear   Int

  occurredAt   DateTime
  /// Free text, not a User link — injured parties include day labour and
  /// apprentices who may never have an account.
  employeeName String
  jobTitle     String?
  /// Where on site, e.g. "3rd floor east corridor".
  location     String?

  description    String
  classification IncidentClassification
  outcome        IncidentOutcome
  /// Only meaningful for DAYS_AWAY / RESTRICTED_OR_TRANSFER. OSHA counts
  /// calendar days, not work days.
  daysAway       Int?
  daysRestricted Int?

  reportedByUserId String?
  reportedBy       User?   @relation(fields: [reportedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, caseYear, caseNumber])
  @@index([companyId])
  @@index([jobId])
}

/// A toolbox talk / tailgate safety meeting. Union agreements and GC
/// contracts commonly require these be held and documented; the record is
/// the deliverable.
model ToolboxTalk {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String?
  job       Job?    @relation(fields: [jobId], references: [id])

  heldOn    DateTime
  topic     String
  presenter String?
  /// Free text roster. A signature sheet photo is the real artifact on a
  /// jobsite; capturing names here is the searchable version of it.
  attendees String?
  notes     String?

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobId])
}

/// An RFI — a formal written question to the GC or architect, and their
/// written answer. For a subcontractor this log is evidence first and a
/// question-tracker second: an RFI sent on a date and answered late is the
/// documentation behind a delay claim or a change order, and "we asked and
/// nobody got back to us" is worth nothing without the dates.
model Rfi {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Required, unlike safety incidents. An RFI is always about a set of
  /// drawings on a specific job — there is no such thing as a general one.
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  /// Sequential per job, issued by RfiCounter and never reissued. GCs
  /// reference these by number in correspondence, so a number that comes
  /// back after a deletion points at two different questions.
  number Int

  subject  String
  question String

  /// Where in the documents the question comes from. Free text: drawing
  /// numbering is per-project and not worth modelling.
  drawingReference String?
  specSection      String?

  status RfiStatus @default(DRAFT)

  /// Dates are the point of the record. sentOn is when it left our hands;
  /// dueBy is the response date the contract calls for; answeredOn is when
  /// it actually came back. Overdue is derived from these, never stored.
  sentOn     DateTime?
  dueBy      DateTime?
  answeredOn DateTime?
  answer     String?

  /// Flagged by whoever reads the answer. These do not create a change
  /// order or move a schedule — they mark the RFIs worth revisiting when
  /// someone builds the claim.
  costImpact     Boolean @default(false)
  scheduleImpact Boolean @default(false)

  askedByUserId String?
  askedBy       User?   @relation(fields: [askedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, number])
  @@index([companyId])
  @@index([jobId])
}

/// Issues RFI numbers per job. Same reasoning as SafetyCaseCounter: a
/// number computed from the RFIs that still exist (a count, or max+1) is
/// freed again when one is deleted, and the next RFI reissues it. This row
/// only increments.
model RfiCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

enum RfiStatus {
  /// Written but not sent. Not yet evidence of anything.
  DRAFT
  /// Sent to the GC or architect, awaiting a written answer.
  SENT
  /// Answered in writing. The answer text is the record.
  ANSWERED
  /// Answered and acted on, or withdrawn. Off the open list.
  CLOSED
}

/// A shop drawing or product-data submittal: something we sent the GC or
/// architect for approval before we build from it. Like an RFI it is an
/// evidence record first — what we sent, when, what came back, and which
/// revision is the one it is now legal to build from. The identity fields
/// (job, number) are what the GC has in writing and are never editable.
model Submittal {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Required, same reasoning as RFIs: a submittal is always against a
  /// specific job's drawings and spec sections.
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  /// Sequential per job, issued by SubmittalCounter and never reissued —
  /// same rule as RFI and safety case numbers: anything derived from the
  /// rows that still exist can be reissued, because deleting a row changes
  /// the answer.
  number Int

  title       String
  description String?

  /// Free text, same as RFIs: numbering schemes are per-project.
  specSection      String?
  drawingReference String?

  /// Revision numbers are issued from this row, incremented in the same
  /// transaction as the revision insert. Derived from nothing — revisions
  /// are never deletable, but the rule is cheaper to keep than to argue
  /// about, and it also closes the race of two people resubmitting at once.
  lastRevision Int @default(0)

  submittedByUserId String?
  submittedBy       User?   @relation(fields: [submittedByUserId], references: [id])

  revisions SubmittalRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, number])
  @@index([companyId])
  @@index([jobId])
}

/// One round trip to the GC: we sent this revision on a date, and it came
/// back (or hasn't) with a result. The submittal's current status is
/// DERIVED from its latest revision on every render, never stored — a
/// stored status can disagree with the revision that supposedly produced
/// it, and that contradiction is what gets a sub building from a
/// superseded drawing. Sent revisions are correspondence and are never
/// deleted or renumbered.
model SubmittalRevision {
  id          String    @id @default(cuid())
  submittalId String
  submittal   Submittal @relation(fields: [submittalId], references: [id])

  /// 1-based, issued by Submittal.lastRevision in the sending transaction.
  revisionNumber Int

  /// All three dates are entered, not stamped, and stored at UTC midnight
  /// — same rule as RFIs. Recording last month's submittal today must not
  /// read as sent today, or the turnaround evidence is fiction.
  sentOn     DateTime
  dueBack    DateTime?
  returnedOn DateTime?

  /// What the stamp said, recorded when returnedOn is. Null while the GC
  /// still has it.
  outcome SubmittalOutcome?

  /// What "approved as noted" actually noted, or why it bounced.
  responseNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([submittalId, revisionNumber])
  @@index([submittalId])
}

/// Same shape and reason as RfiCounter and SafetyCaseCounter.
model SubmittalCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

enum SubmittalOutcome {
  /// Build from this revision.
  APPROVED
  /// Build from this revision, incorporating the reviewer's notes.
  APPROVED_AS_NOTED
  /// Fix and send again. The ball is back in our court.
  REVISE_AND_RESUBMIT
  /// Not acceptable. Also our court, but usually a bigger conversation.
  REJECTED
}

/// A material order placed with a vendor for a job.
///
/// This is a LOGISTICS record: what was ordered, who owes it, when they
/// promised it, and when it actually showed up. It is deliberately NOT a
/// money record and NOT a scope record.
///
/// It carries no quantity and no unit price on purpose. A
/// `MaterialOrderLineItem` with quantity and price would be a second live
/// copy of line-item data, which is the one thing this codebase does not
/// do — see ARCHITECTURE.md. Material cost already has a home
/// (`CostEntry` against a `JobLineItem`) and scope already has a home
/// (`JobLineItem` itself). This model answers a question neither of those
/// can: is it here yet, and if not, who is late.
///
/// A link from an order to a specific `JobLineItem` was considered and
/// deferred — it would be a pure addition, but it touches the unified
/// line-item model, which is the other lane's core surface.
model MaterialOrder {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// Issued by MaterialOrderCounter inside the same transaction as the
  /// insert. Never max(number)+1 and never count()+1: anything derived
  /// from the rows that still exist gets reissued when a row is deleted,
  /// and two orders sharing a number on one job is a purchasing dispute
  /// nobody can settle.
  number Int

  /// Who owes the material. Required — an order with nobody on the hook
  /// for it can't answer the question this model exists to answer.
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id])

  /// Which SOV line this material is for. ATTRIBUTION ONLY — nullable, and
  /// nothing may ever sum money through it. Material cost lives on
  /// `CostEntry` against the same `JobLineItem`; this exists so a late
  /// delivery can be tied to the scope it holds up, not so an order can
  /// become a second source of line-item cost. Agreed with Diego
  /// 2026-08-28 on exactly those terms. See ARCHITECTURE.md.
  lineItemId String?
  lineItem   JobLineItem? @relation(fields: [lineItemId], references: [id], onDelete: SetNull)

  description     String
  /// The vendor's own order/PO number, so a phone call about it can open
  /// with the number they'll recognise rather than ours.
  vendorReference String?
  notes           String?

  /// Entered, not stamped. Logging an order you placed last Tuesday must
  /// not record it as ordered today — the gap between ordered, promised
  /// and delivered is the entire value of the record.
  orderedOn   DateTime
  /// What the vendor committed to. Optional: plenty of orders are placed
  /// before anyone will commit to a date, and a guessed date is worse
  /// than no date, because "late" would then be measured against a guess.
  promisedFor DateTime?

  orderedByUserId String?
  orderedBy       User?   @relation(fields: [orderedByUserId], references: [id])

  deliveries MaterialOrderDelivery[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, number])
  @@index([companyId])
  @@index([jobId])
  @@index([vendorId])
}

/// One delivery against an order. Partial deliveries are the normal case —
/// half the studs on Tuesday, the rest whenever — so this is a list, not a
/// pair of columns on the order.
model MaterialOrderDelivery {
  id      String        @id @default(cuid())
  orderId String
  order   MaterialOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// The date it actually arrived, entered by whoever received it.
  deliveredOn    DateTime
  /// Whether this delivery closed the order out. The order's state is
  /// derived from its deliveries on every read rather than stored on the
  /// order, because a stored status can disagree with the deliveries
  /// underneath it — and then "still waiting on it" and "it's all here"
  /// are both on screen at once.
  completesOrder Boolean  @default(false)
  notes          String?

  createdAt DateTime @default(now())

  @@index([orderId])
}

/// Per-job material order numbers. Same rule as RfiCounter and
/// SubmittalCounter: a row that only ever increments.
model MaterialOrderCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

/// A drawing set for a job — "Architectural", "Structural", "Life Safety".
/// The thing a foreman means by "the drawings".
///
/// Sets are per job because the same discipline on two jobs has nothing to
/// do with each other, and because the question this answers is always
/// asked about one job: which sheet is it legal to build from today.
model DrawingSet {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// Free text rather than an enum. Disciplines vary by project and by
  /// architect — "A", "Architectural", "AD-Series", "Life Safety" are all
  /// real, and an enum would force a wrong choice on the first job that
  /// doesn't fit.
  name        String
  description String?

  revisions DrawingRevision[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, name])
  @@index([companyId])
  @@index([jobId])
}

/// One issue of a drawing set from the architect or GC.
///
/// NOTE THE DIFFERENCE FROM RFIs, SUBMITTALS AND MATERIAL ORDERS: those
/// carry a number this company issues, from a counter row that only
/// increments. This one does NOT. "Rev 3", "ASI-12", "Bulletin 5" are the
/// ARCHITECT'S labels, printed on a title block we don't control. There is
/// no counter here on purpose — issuing our own number for someone else's
/// document would invent a second identity for a sheet the whole job
/// already refers to by its real one.
model DrawingRevision {
  id    String     @id @default(cuid())
  setId String
  set   DrawingSet @relation(fields: [setId], references: [id], onDelete: Cascade)

  /// Exactly as printed on the title block.
  label String

  /// The date on the drawing itself — entered, not stamped. Backdating the
  /// revisions already on site must not record them all as issued today.
  /// This is what "current" is derived from.
  issuedOn   DateTime
  /// When it actually reached us. Null means it hasn't — and that is the
  /// state worth seeing, because a revision that exists and isn't in the
  /// trailer means the crew is building from paper that is already
  /// superseded. The gap between the two dates is the exposure.
  receivedOn DateTime?

  /// What changed. The reason anyone opens a superseded revision later.
  description String?

  /// Optional. A record that Rev 3 was issued on a date and reached us on
  /// another is worth keeping even when nobody has the PDF to hand.
  fileUrl  String?
  fileName String?

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([setId, label])
  @@index([setId])
}

/// One line of a job's closeout checklist — final lien waiver, as-builts,
/// O&M manuals, warranty letter, final certified payroll.
///
/// There is no stored "closeout complete" flag anywhere. A job's closeout
/// is complete when every REQUIRED item has a completion date, derived on
/// every read. A stored flag can disagree with the items underneath it,
/// and "we closed that job out" is exactly the claim someone makes when
/// chasing final payment.
model CloseoutItem {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  name       String
  /// Optional items exist — some GCs want as-builts, some don't. Only
  /// required items decide whether closeout is done.
  isRequired Boolean @default(true)
  note       String?

  /// Entered, not stamped. Backfilling a checklist for a job that closed
  /// out in March must not record every item as done today.
  completedOn DateTime?

  /// Where the signed document lives. A link rather than an upload, same
  /// reason as drawing sets: a Server Action body caps around 1MB.
  documentUrl  String?
  documentName String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([jobId, name])
  @@index([companyId])
  @@index([jobId])
}

/// The warranty clock on a completed job. One per job.
///
/// `startsOn` is entered rather than read from `Job.substantialCompletionDate`
/// on purpose. That field already drives retainage release forecasting, and
/// the warranty clock and the retainage clock are not always the same date —
/// warranty commonly runs from final completion or from owner acceptance.
/// Reusing one date for both would silently move one whenever the other was
/// corrected.
///
/// Expiry is DERIVED from startsOn + months, never stored. A stored expiry
/// date is wrong the moment either input is corrected.
model WarrantyPeriod {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String  @unique
  job       Job     @relation(fields: [jobId], references: [id])

  startsOn DateTime
  /// Months rather than an end date, because that is how the contract
  /// states it ("one year from substantial completion").
  months   Int
  note     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

/// A callback after completion — a crack, a door that won't latch, water
/// where there shouldn't be.
///
/// Belongs to the Job rather than to the WarrantyPeriod, because calls
/// arrive whether or not a warranty was ever recorded, and one arriving
/// AFTER the period expired is the most important kind to have written
/// down. Whether a call fell inside the warranty is derived by comparing
/// its reported date to the derived expiry.
model WarrantyServiceRequest {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// Entered, not stamped — logging last month's calls must not date them
  /// all today.
  reportedOn  DateTime
  description String
  reportedBy  String?

  /// Whose problem it turned out to be. Starts UNDETERMINED because that
  /// is the honest state when the call comes in, and deciding it later is
  /// the actual work.
  responsibility WarrantyResponsibility @default(UNDETERMINED)

  resolvedOn     DateTime?
  resolutionNote String?

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([jobId])
}

enum WarrantyResponsibility {
  /// Our defect, our cost to put right.
  OURS
  /// Someone else's trade, owner damage, or normal wear — recorded so the
  /// callback history doesn't read as our defect list.
  NOT_OURS
  /// Not decided yet. The default, and the honest state on the day the
  /// call comes in.
  UNDETERMINED
}

/// What a vendor said something costs, on a date.
///
/// The gap this fills: until now a material price existed in exactly two
/// places, and neither could be estimated from. `CostEntry` holds a lump
/// amount after the fact, with no vendor and no unit behind it.
/// `MaterialOrder` deliberately carries no price at all — putting one
/// there would make an order a second source of line-item cost, which
/// ARCHITECTURE.md forbids and Diego and I agreed on in those words. So
/// the question an estimator actually asks — "what is board going for,
/// from whom, and is it moving?" — had no answer anywhere.
///
/// This is not line-item data and must not become it. A quote belongs to
/// a VENDOR and a DATE, never to a job or a `JobLineItem`. Nothing here
/// may ever be summed into a job's cost: that is what `CostEntry` is for,
/// and two places holding job cost is the exact anti-pattern the unified
/// `JobLineItem` exists to prevent. Read this as reference data for
/// pricing work, in the same family as `LineItemCatalogEntry`.
model VendorPriceQuote {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Required. A price with nobody behind it answers none of the
  /// questions this model exists for — you cannot ring up "the market".
  vendorId String
  vendor   Vendor @relation(fields: [vendorId], references: [id], onDelete: Cascade)

  /// Optional link to the catalog template this price is for, so an
  /// estimator pricing that item can see what it really costs. Optional
  /// because a vendor quotes plenty of things that were never catalog
  /// items, and refusing to record those would make the history a
  /// partial one — worse than none, because nobody would know it was
  /// partial.
  catalogEntryId String?
  catalogEntry   LineItemCatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)

  /// What was priced, in the VENDOR'S words. Kept even when a catalog
  /// entry is linked: "5/8 Type X 4x12" and the catalog's wording are
  /// rarely identical, and when a price is queried it is the vendor's
  /// description that has to be read back to them.
  description String

  /// The vendor's unit, never converted to ours. A vendor who quotes by
  /// the MSF has not quoted by the SF, and inventing the factor between
  /// them is inventing a price. Comparison across vendors only ever
  /// happens within one unit — see `bestCurrentPrice` in
  /// `components/vendorPricing.ts`.
  unit      String?
  unitPrice Decimal @db.Decimal(12, 2)

  /// Entered, not stamped. Logging Tuesday's quote on Friday must record
  /// Tuesday, or every movement calculation over this data is wrong by
  /// however long the paperwork sat. Same rule as every other date here.
  quotedOn DateTime

  /// What the vendor said the price holds until. Optional because plenty
  /// of prices are given with no expiry, and a guessed one is worse than
  /// none: "expired" would then be our invention presented as theirs.
  validUntil DateTime?

  source VendorPriceSource @default(QUOTE)
  notes  String?

  recordedByUserId String?
  recordedBy       User?   @relation(fields: [recordedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([vendorId])
  @@index([catalogEntryId])
}

/// Where the number came from. Recorded because the four are not equally
/// trustworthy and an estimator is entitled to know which they are
/// looking at — a price read off an invoice is what was actually charged,
/// a number from a phone call is what someone remembers being told.
enum VendorPriceSource {
  /// A written quote for this job or this request.
  QUOTE
  /// Taken off an invoice — what was actually charged, after the fact.
  INVOICE
  /// From a published or emailed price list covering many items.
  PRICE_LIST
  /// Told to someone over the phone or at the counter.
  VERBAL
}
