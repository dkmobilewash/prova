// Estimating and bidding: versions, the reusable catalog, bid invitations.
// Diego's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum BidInvitationStatus {
  INVITED
  SUBMITTED
  WON
  LOST
  DECLINED
}

/// A GC inviting this company to bid on a project — tracked from
/// invitation through outcome, independent of Job: most invitations are
/// declined or lost and never become one. When a bid is won, the PM
/// creates the Job normally through the existing estimate flow.
///
/// LINKING A WON BID FORWARD TO ITS JOB WAS "a future refinement, not built
/// here" UNTIL 2026-09-24, and the sentence was load-bearing in the wrong
/// direction: without the link there was no way to put what a job was BID at
/// beside what it actually COST, so the one number an estimator most needs to
/// learn from could not be computed at all. Every feedback loop the app had
/// was narrower — `catalog-actuals.ts` per catalog entry, `phase-code-rollup`
/// per phase code, `bid-pipeline` win/loss only. `wonJobId` below is that
/// link, and `lib/bid-outcome.ts` is the comparison it makes possible.
model BidInvitation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  contactId String
  contact   Contact @relation(fields: [contactId], references: [id])

  projectName String
  dueDate     DateTime?
  status      BidInvitationStatus @default(INVITED)
  notes       String?

  /// Which trade this bid is for, and what was actually bid — together
  /// these are what turn a plain invitation log into a historical bid
  /// database: "what have we bid on similar EIFS work before, and at what
  /// price" is just filtering/reading this table, not a separate one.
  tradeScope TradeScope?
  bidAmount  Decimal?    @db.Decimal(12, 2)

  /// The quotes this company collected from its own suppliers and subs for
  /// this bid, for levelling — see bid-levelling.prisma. Distinct from
  /// VendorPriceQuote, which is price history and carries no bid.
  quotes BidQuote[]

  /// The pre-bid pursuit this invitation came out of, if one was being
  /// chased — see pursuits.prisma. The FK lives on BidPursuit.
  pursuit BidPursuit?

  /// The alternates, unit prices and allowances this bid carries — see
  /// bid-lines.prisma. A bid is rarely one number; these are the rest of it.
  lines BidLine[]

  /// The paperwork that decides whether anybody reads the number — see
  /// bid-compliance.prisma. Addenda the GC issued and whether each has been
  /// acknowledged, plus the ITB items only a person can confirm. A bid that
  /// misses one of these is rejected unread, however good the price was.
  addenda      BidAddendum[]
  requirements BidRequirement[]

  /// THE JOB THIS BID BECAME, when it was won and somebody linked it.
  ///
  /// Nullable and SET NULL, never required: most invitations never become a
  /// job at all, a won bid may be linked days after the job is created, and a
  /// job deleted in cleanup must not take the bid record with it — the bid is
  /// the history of what was quoted, and it stays true whatever happens to
  /// the job afterwards.
  ///
  /// UNIQUE, because two bids claiming the same job would make "what was this
  /// job bid at" a question with two answers. Re-bidding a project that was
  /// lost and re-tendered is a second BidInvitation; the link moves.
  ///
  /// NOT set automatically, and that is the design rather than a gap. Nothing
  /// in the data says which job a bid became — the names rarely match, the
  /// dates rarely line up, and a fuzzy match here would attach a bid amount
  /// to the wrong job's costs and then teach the estimator from it. A person
  /// picks it, the same posture `JobLineItem.sourceCatalogEntryId` takes
  /// ("deliberately NOT backfilled by fuzzy-matching descriptions").
  wonJobId String? @unique
  wonJob   Job?    @relation("BidInvitationWonJob", fields: [wonJobId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([contactId])
}

/// A manual checkpoint of a job's line items while it's still an
/// ESTIMATE — "save version" on the current JobLineItem rows, not an
/// automatic log of every edit. `snapshot` is a plain JSON copy (same
/// pattern as SignatureRequest.snapshot): estimate versioning needs to
/// answer "what did we price this at before the scope changed," which a
/// point-in-time copy answers directly, without a parallel line-item
/// history table to keep in sync with every edit JobLineItem ever makes.
model EstimateVersion {
  id            String @id @default(cuid())
  jobId         String
  job           Job    @relation(fields: [jobId], references: [id])
  versionNumber Int

  note     String?
  snapshot Json

  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@unique([jobId, versionNumber])
  @@index([jobId])
}

/// Issues EstimateVersion numbers per job. Same shape and same reasoning as
/// ContractDocumentVersionCounter and InvoiceCounter — issue #289, and the
/// last sequence in the product that was still `MAX(versionNumber) + 1`.
///
/// WHAT THIS REPLACED, and which half of it was actually reachable.
/// `saveEstimateVersion` read the highest surviving version outside any
/// transaction and added one. Two people saving a checkpoint on the same
/// job at once — an estimator and whoever is checking the numbers with
/// them, or simply two tabs — both read the same max and the second
/// violated `@@unique([jobId, versionNumber])`. Measured against a real
/// Postgres 16 before the fix: 49 of 50 rounds at two concurrent saves.
/// The action returns void and does not catch, so that throw reached the
/// person as a redacted production digest and their checkpoint was gone.
///
/// The reissue-after-delete failure the counter rule usually warns about
/// was NOT reachable here and is recorded so nobody re-argues it: nothing
/// in the product deletes an EstimateVersion. The only `deleteMany` calls
/// are in clean-scratch-data.mjs and seed-demo.mjs, both teardown. The
/// counter is still correct to have — it removes the race, and it means a
/// delete path added later cannot quietly reintroduce the other half.
///
/// BACKFILLED from MAX(versionNumber) per job when created, for the same
/// reason InvoiceCounter and ContractDocumentVersionCounter were: starting
/// at zero would make every job with saved versions collide with its own
/// history on the first save after the migration.
model EstimateVersionCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

/// The five WWCCA trade families a wall-and-ceiling specialty subcontractor
/// self-performs. A flat categorization tag, not a hierarchy — a company
/// may hold several of these in-house and job costing needs to separate
/// them. Deliberately not a self-performed-vs-subcontracted model or full
/// CSI MasterFormat coding: this ICP is a narrow-trade-family sub, not a
/// diversified GC coordinating many subs.
enum TradeScope {
  METAL_FRAMING_DRYWALL
  LATH_PLASTER
  EIFS
  ACOUSTICAL_CEILINGS
  FIREPROOFING
}

/// Which trade scopes a Company actually holds/self-performs — reuses the
/// TradeScope enum above rather than a parallel reference table, so there's
/// one source of truth for "what are the five trade scopes." A company may
/// add a trade scope later as it grows rather than holding all five from
/// day one, hence `activeSince` rather than assuming everything started at
/// company creation.
model CompanyTradeScope {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  tradeScope  TradeScope
  isPrimary   Boolean    @default(false)
  activeSince DateTime?
  createdAt   DateTime   @default(now())

  @@unique([companyId, tradeScope])
  @@index([companyId])
}

/// A reusable line item, scoped to the company, not any one job —
/// "Add from catalog" on a new estimate inserts an ordinary JobLineItem
/// pre-filled from here (same jobLineItem.create path every other line
/// goes through; a catalog entry is a template for that call, not a
/// second live copy of estimate data to keep in sync). Built up over
/// time from real estimates ("save as catalog item" on an existing line)
/// rather than requiring separate manual data entry.
model LineItemCatalogEntry {
  id          String      @id @default(cuid())
  companyId   String
  company     Company     @relation(fields: [companyId], references: [id])
  description String
  unit        String?
  tradeScope  TradeScope?

  defaultUnitPrice        Decimal?             @db.Decimal(12, 2)
  defaultBudgetedUnitCost Decimal?             @db.Decimal(12, 2)

  /// FLAT hours for one line, copied onto an estimate line unchanged at every
  /// quantity. NOT a per-unit figure — `catalog-line.test.ts` pins that at
  /// quantity 1 AND quantity 100, because at quantity 1 the two readings are
  /// indistinguishable and that is how the ambiguity survived.
  ///
  /// Kept exactly as it is. `Decimal(8, 2)` cannot hold a per-unit rate
  /// anyway — 0.012 stores as 0.01 — so reinterpreting this column would be
  /// both a silent change of meaning and lossy in the direction nobody checks.
  defaultLaborHours       Decimal?             @db.Decimal(8, 2)

  /// UNITS PER HOUR — the same thing, the same name and the same direction as
  /// `JobLineItem.productionRate` and `WallTypeComponent.productionRate`.
  /// "This crew hangs 62.5 SF/hr". Hours are `quantity / productionRate`
  /// (`lib/labor-productivity.ts`), so a LARGER number is FASTER work.
  ///
  /// WHY THIS IS A SECOND COLUMN RATHER THAN A REINTERPRETATION of
  /// `defaultLaborHours` above: a flat figure somebody entered on purpose must
  /// not silently become a rate. The two are not convertible without knowing
  /// which was meant, and nothing recorded that.
  ///
  /// #435 put this column on `JobLineItem` and `WallTypeComponent` and not
  /// here, which left the one artefact that ACCUMULATES this company's
  /// productivity knowledge unable to hold it — and `jobs.prisma`'s own
  /// comment on that column points straight at this gap. An estimate line
  /// created from a catalog entry now inherits the rate, so the
  /// actual-productivity back-check has something to compare against on work
  /// priced from the price book.
  ///
  /// BOTH COLUMNS MAY BE SET, and the flat hours WIN. That is not a rule
  /// invented here: `estimatedHours()` (lib/labor-productivity.ts) takes
  /// `laborHours` as the override and derives from the rate only when it is
  /// absent, so an entry carrying both produces a line whose rate is inert.
  /// The catalog deliberately mirrors `JobLineItem`'s precedence rather than
  /// growing a second one — a pair of columns that means one thing on the
  /// line and another on the template is worse than either reading. Every
  /// screen showing the pair says which wins.
  ///
  /// ⚠️ A PRICE LIST'S "HOURS" COLUMN IS NOT NECESSARILY THIS NUMBER. Some
  /// carry HOURS PER UNIT (0.012 hr/SF) and some carry UNITS PER HOUR
  /// (83.33 SF/hr), and the two are reciprocals — so writing one into the
  /// other overstates labor by 1/x²: 600 SF at 0.012 read as a rate is
  /// 50,000 hours instead of 7.2, and inverting a file that really meant
  /// 60 SF/hr gives 36,000. Both blind rules are catastrophic.
  ///
  /// `importCatalogEntries` therefore ASKS, and refuses an import that has
  /// not been answered: `lib/catalog-import-labor.ts` states what each
  /// reading would do to a row out of the person's own file ("100 SF would
  /// take 1.2 hours / 8,333 hours / 0.01 hours") and writes ONE of the two
  /// columns from the answer, never both. Which convention a file uses is a
  /// fact about the file, not something any code can derive. Issue #514.
  productionRate          Decimal?             @db.Decimal(10, 4)

  craftClassificationId   String?
  craftClassification     CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  /// Lines created from this entry. Read-only history for the actuals
  /// feedback loop on /catalog — how work priced from this template
  /// actually costed. Never a live link back into those rows.
  jobLineItems JobLineItem[]

  /// Wall-type components priced from this entry. A template link only.
  wallTypeComponents WallTypeComponent[]

  /// Estimate-template items pointing at this entry — see
  /// estimate-templates.prisma. A template link only, and SET NULL on
  /// delete: removing a catalog entry leaves the template item standing as
  /// plain text rather than taking the template down with it.
  estimateTemplateItems EstimateTemplateItem[]

  /// What vendors have quoted for this item. Reference data for pricing,
  /// in the same family as this entry's own defaults. Cyrus, Sheet 19.
  ///
  /// NOTHING HERE IS EVER SUMMED INTO A JOB, and that half of this comment is
  /// permanent: a quote is what a vendor said something costs on a date, and
  /// job cost lives on `CostEntry` against a `JobLineItem`. Two paths to a
  /// job's money is the anti-pattern ARCHITECTURE.md exists to prevent.
  ///
  /// AMENDED 2026-09-22. This line used to read "a quote never writes a price
  /// back into this template", which was too absolute in one direction and is
  /// why the other half of the feature went unbuilt for weeks. `/vendors/pricing`
  /// has always ended its own warning with "updating the catalog is a decision
  /// about your own pricing, and it belongs on the catalog" — a link to a
  /// button that did not exist. It exists now
  /// (`priceCatalogEntryFromQuotes`): owner-only, one click, the figure
  /// re-derived server-side from the cheapest LIVE quote in this entry's own
  /// unit, and never across units. What stays true is the part that was always
  /// the point: nothing automatic moves a price, and no quote reaches a job.
  priceQuotes VendorPriceQuote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([craftClassificationId])
}
