// The unified Job / JobLineItem object and everything hanging off it.
// See /ARCHITECTURE.md before adding a model that looks like it duplicates
// line-item data.
//
// Part of the multi-file Prisma schema in this folder.

enum JobStatus {
  ESTIMATE
  CONTRACTED
  IN_PROGRESS
  COMPLETE
}

/// The unified object. A Job's `lineItems` ARE the estimate, the budget, the
/// contract content, and the job-costing structure — there is no separate
/// table for any of those views. See /ARCHITECTURE.md.
model Job {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id])
  name      String
  scope     String?
  status    JobStatus @default(ESTIMATE)
  // Single start/end dates on the Job itself — properties of the job, not a
  // list of entries, so (unlike CostEntry/ChangeOrder) this doesn't need a
  // separate table. Nullable: most jobs start unscheduled.
  startDate DateTime?
  endDate   DateTime?

  /// Which office/yard is running this job. Nullable: most existing jobs
  /// predate this and there's no backfill source. This is a place to
  /// RECORD the operating location only — nothing yet reads it to
  /// auto-derive the applicable license or union agreement; that's real
  /// application logic for a future phase, not built here.
  operatingLocationId String?
  operatingLocation   CompanyLocation? @relation(fields: [operatingLocationId], references: [id])

  /// This job's retainage rate — usually pre-filled from
  /// Contact.defaultRetainagePercent at contract time but independently
  /// editable per job, since a GC's standing terms are a starting point,
  /// not a binding value. Null means retainage isn't withheld on this job
  /// (or hasn't been set yet). New invoices snapshot this rate into
  /// Invoice.retainageWithheld at creation — changing it here later never
  /// rewrites past invoices, same reasoning as JobLineItem.budgetedUnitCost.
  retainagePercent Decimal? @db.Decimal(5, 2)

  /// The anchor date for retainage release forecasting — when this job is
  /// expected to reach substantial completion, the point GCs typically
  /// release retainage. A plain field, not a JobStatus stage: closeout/
  /// warranty tracking (JobStatus stopping at COMPLETE today) is a
  /// separate, not-yet-built phase.
  substantialCompletionDate DateTime?

  /// Where the project is, in the person's words ("Portland, OR", "SE 13th
  /// and Tacoma"). Free text, not an address model: it is what a person
  /// said when starting the bid, and the only thing that reads it is the job
  /// page and the web research the Ask box runs on a new bid.
  projectLocation String?
  /// Where the work physically is — the street address a daily report's
  /// weather is looked up for. Entered on the job page. `siteLatitude`,
  /// `siteLongitude` and `siteTimeZone` are what that address resolved to
  /// (US Census geocoder for a street address, Open-Meteo's place search for
  /// a city), filled in when the address is saved and cleared when it
  /// changes. Null coordinates mean "not found": the report falls back to
  /// typed weather and says why.
  siteAddress     String?
  siteLatitude    Float?
  siteLongitude   Float?
  siteTimeZone    String?
  siteGeocodedAt  DateTime?
  /// When the bid is due, as the person ENTERED it — stored at UTC midnight
  /// like every other date here. Never set from the web: a bid date found
  /// online stays in `bidResearch` with its source, because a date read off
  /// a stranger's page is a weaker claim than one the GC gave.
  bidDueDate DateTime?
  /// Public-web facts about the project that a PERSON kept on a confirm card
  /// when starting the bid from the Ask box: `[{ field, label, value,
  /// sources: [{ title, url }] }]`. Only what they left ticked is written,
  /// and only after they tapped. Shown on the job page with its links and
  /// the note that it came from the web.
  bidResearch Json?

  /// Four ENTERED public-works facts, recorded on the job's Compliance tab.
  /// Nothing derives them: the geocoder guesses a county and a prevailing-
  /// wage determination area is not a guess; whether a job is public works
  /// is what the awarding body said, not what the GC's name suggests.
  ///
  /// The site's county, as written on the call for bids.
  siteCounty      String?
  /// Whether this is public works (paid in whole or in part out of public
  /// funds, Labor Code 1720). Null = not recorded, which is NOT "private".
  publicWorks     Boolean?
  /// The awarding body's first advertisement for bids — the date that picks
  /// which prevailing-wage determination governs the whole job (8 CCR
  /// 16000; DIR's FAQ). ENTERED from the call for bids, UTC midnight, never
  /// stamped. `lib/determination-standing.ts` reads it; nothing writes it
  /// but a person.
  bidAdvertisedOn DateTime?
  /// The awarding body, as written on the call for bids. Free text.
  awardingBody    String?

  /// The Jobber job or quote this was imported from (Jobber ids are global
  /// and name their type, so one column holds both). Null for everything
  /// else. See jobberId on Contact.
  jobberId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems                      JobLineItem[]
  changeOrders                   ChangeOrder[]
  changeOrderCounter             ChangeOrderCounter?
  assignments                    JobAssignment[]
  crewScheduleDays               CrewScheduleDay[]
  lienDeadlines                  LienDeadline[]
  procoreProjectLink             ProcoreProjectLink?
  accProjectLink                 AccProjectLink?
  companycamProjectLink          CompanyCamProjectLink?
  bluebeamStudioSession          BluebeamStudioSession?
  signatureRequests              SignatureRequest[]
  docuSignEnvelopes              DocuSignEnvelope[]
  invoices                       Invoice[]
  complianceDocuments            ComplianceDocument[]
  equipment                      Equipment[]
  equipmentAssignments           EquipmentAssignment[]
  estimateVersions               EstimateVersion[]
  estimateVersionCounter         EstimateVersionCounter?
  contractDocuments              ContractDocument[]
  timeEntries                    TimeEntry[]
  dispatchSlips                  DispatchSlip[]
  prevailingWageDeterminations   PrevailingWageDetermination[]
  retainageReleases              RetainageRelease[]
  punchListItems                 PunchListItem[]
  tmTickets                      TmTicket[]
  timesheetSignoffs              TimesheetSignoff[]
  delayEvents                    DelayEvent[]
  dailyFieldReports              DailyFieldReport[]
  media                          JobMedia[]
  takeoffPlans                   TakeoffPlan[]
  /// Documents dropped into `/intake` and filed against this job. Optional
  /// on that side, so this is SET NULL rather than a blocker — see
  /// intake.prisma.
  documentIntakes                DocumentIntake[]
  safetyIncidents                SafetyIncident[]
  toolboxTalks                   ToolboxTalk[]
  rfis                           Rfi[]
  invoiceCounter                 InvoiceCounter?
  contractDocumentVersionCounter ContractDocumentVersionCounter?
  wh347PayrollNumbers            Wh347PayrollNumber[]
  wh347PayrollCounter            Wh347PayrollCounter?
  das140Notices                  Das140Notice[]
  das142Requests                 Das142Request[]
  rfiCounter                     RfiCounter?
  submittals                     Submittal[]
  submittalCounter               SubmittalCounter?
  materialOrders                 MaterialOrder[]
  materialOrderCounter           MaterialOrderCounter?
  drawingSets                    DrawingSet[]
  closeoutItems                  CloseoutItem[]
  warrantyPeriod                 WarrantyPeriod?
  warrantyServiceRequests        WarrantyServiceRequest[]
  backcharges                    Backcharge[]
  backchargeCounter              BackchargeCounter?
  closeoutSubmissions            CloseoutSubmission[]
  closeoutSubmissionCounter      CloseoutSubmissionCounter?
  outboundMessages               OutboundMessage[]
  proposalClauses                JobProposalClause[]
  wallRuns                       WallRun[]
  bidRecap                       JobBidRecap?

  @@index([companyId])
  @@index([contactId])
  @@index([operatingLocationId])
  @@unique([companyId, jobberId])
}

/// A single line item, referenced everywhere: estimate, contract summary,
/// budget total, and job costing. A change order mutates rows in this table
/// (or adds new ones) — it never forks them into a parallel shape.
model JobLineItem {
  id          String  @id @default(cuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id])
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unit        String?

  /// Optional — a categorization dimension on top of the cost/WIP fields
  /// below, not a prerequisite for them.
  tradeScope TradeScope?

  /// Estimated labor hours for this line, optionally tied to which craft
  /// classification would perform it (journeyman/apprentice/foreman by
  /// local — see CraftClassification). Both optional: a material-only or
  /// lump-sum line has neither. Fed into a burdened labor cost by
  /// lib/estimate-labor-cost.ts when a FringeRateSchedule is effective.
  laborHours            Decimal?             @db.Decimal(8, 2)
  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  /// What KIND of cost this line is — material, self-performed labor,
  /// subcontracted work, or other. Nullable with NO backfill, for the same
  /// reason phaseCodeId below is: inferring "material" from a description
  /// string is exactly the guess this column replaces, and a line nobody has
  /// typed must read as uncoded rather than be filed under whatever matched.
  ///
  /// It is what lets the bid recap mark material up at a different rate from
  /// labor (see bid-recap.prisma). An uncategorised line is REPORTED by the
  /// recap and marked up at nothing — never at some default.
  ///
  /// Equipment has no member of CostCategory today and sits under OTHER; the
  /// enum is keyed on by the QuickBooks account mapping (billing.prisma), so
  /// adding one is a change in another lane.
  costCategory CostCategory?

  /// Units per hour — the estimator's productivity assumption ("this crew
  /// hangs 62.5 SF/hr"). When set, estimated hours = quantity / productionRate
  /// unless laborHours is entered directly (which overrides). This is the
  /// number the actual-productivity back-check (lib/labor-productivity.ts)
  /// compares actuals against. Decimal(10,4), not the (8,2) that already
  /// cannot hold a per-unit rate on LineItemCatalogEntry.defaultLaborHours.
  productionRate Decimal? @db.Decimal(10, 4)

  /// The company's own cost code for this line. Nullable with NO backfill,
  /// for the same reason craftClassificationId above is: inferring a phase
  /// from a description string is exactly the guess this column exists to
  /// replace, and a line nobody has coded must read as uncoded rather than
  /// be quietly filed under whatever matched.
  phaseCodeId String?
  phaseCode   PhaseCode? @relation(fields: [phaseCodeId], references: [id])

  /// Nullable: a cost-only budget line (general conditions, overhead,
  /// contingency) has no client-facing sale price. Contract value /
  /// invoicing totals treat a null unitPrice as $0 revenue — the line still
  /// carries quantity and cost fields, it just isn't billed directly.
  unitPrice Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)

  /// The estimated unit cost at the time this line was priced (estimate
  /// approval). Set once, stays put as the historical baseline for WIP
  /// reporting — never silently overwritten by later re-forecasting.
  budgetedUnitCost Decimal? @db.Decimal(12, 2)

  /// The PM's current forecast of unit cost, re-estimated as the job
  /// progresses. Defaults to budgetedUnitCost at creation (app-level, not a
  /// DB default) but is independently mutable afterward. This is what
  /// feeds the live percent-complete calculation — see lib/wip.ts.
  currentEstimatedUnitCost Decimal? @db.Decimal(12, 2)

  /// PM override for cost-to-complete. When null, it's derived mechanically
  /// as (currentEstimatedUnitCost * quantity) - actual costs to date. When
  /// set, it overrides that mechanical number — e.g. the PM knows a sub is
  /// behind schedule or a change order is coming before the cost data
  /// reflects it. See lib/wip.ts.
  estimatedCostToComplete Decimal? @db.Decimal(12, 2)

  /// Soft delete: a change order can remove scope without losing history.
  /// Deleted line items are excluded from budget/contract totals.
  isDeleted Boolean @default(false)

  /// True when this row came from draftEstimateLineItems (Claude reading
  /// free-text scope of work) rather than being typed in directly. A
  /// "please verify" signal for the UI, same as ComplianceDocument's
  /// aiExtracted — never a lock, and never auto-approved into a contract.
  aiDrafted Boolean @default(false)

  /// Where a suggested price actually came from. `aiDrafted` alone says a
  /// machine produced the row; it doesn't say whether the number behind it
  /// is this company's own catalog price or Claude inventing one from
  /// general market knowledge. Those deserve very different amounts of
  /// trust, and one undifferentiated "AI-drafted" badge for both is how a
  /// well-grounded number and a guess end up looking identical.
  ///
  /// Null on rows typed in by hand — the contractor's own number needs no
  /// provenance label.
  priceBasis PriceBasis?

  /// The catalog entry this line was created from, when it was. Set by
  /// addLineItemFromCatalog (and by accepting an AI draft that matched a
  /// catalog entry), null for everything else — including every row that
  /// predates this field. Deliberately NOT backfilled by fuzzy-matching
  /// descriptions: a wrong link here would feed a wrong actual cost back
  /// into the catalog default, which is the one thing this must not do.
  ///
  /// A reference for reporting, never a live link: the catalog entry is a
  /// template, and changing its defaults must never reach back and alter
  /// this row (see ARCHITECTURE.md).
  sourceCatalogEntryId String?
  sourceCatalogEntry   LineItemCatalogEntry? @relation(fields: [sourceCatalogEntryId], references: [id])

  /// Set when this line was GENERATED from the job's wall schedule — the
  /// component it totals, across every run of that wall type. It is how a
  /// re-sync finds the line to update instead of adding a second one.
  /// SET NULL if the component is deleted: the line stays, now ordinary.
  wallTypeComponentId String?
  wallTypeComponent   WallTypeComponent? @relation(fields: [wallTypeComponentId], references: [id], onDelete: SetNull)

  /// Set only when this row was created BY a change order (added scope).
  /// Null for line items that were part of the original estimate.
  originChangeOrderId String?
  originChangeOrder   ChangeOrder? @relation("OriginChangeOrder", fields: [originChangeOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edits            ChangeOrderLineItemEdit[]
  costEntries      CostEntry[]
  timeEntries      TimeEntry[]
  invoiceLineItems InvoiceLineItem[]
  proposedChanges  ChangeOrderProposal[]     @relation("ProposedChangeTarget")
  /// Attribution only — see the note on MaterialOrder.lineItem. No money
  /// is ever summed through this relation; cost stays on CostEntry.
  materialOrders   MaterialOrder[]

  @@index([jobId])
  @@index([originChangeOrderId])
  @@index([craftClassificationId])
  @@index([sourceCatalogEntryId])
  @@index([phaseCodeId])
  @@index([wallTypeComponentId])
}

/// A change order groups: (a) newly added JobLineItems (via
/// JobLineItem.originChangeOrderId), and (b) edits to existing JobLineItems
/// (logged in ChangeOrderLineItemEdit). It never stores its own copy of
/// line-item data.
/// Where the price on a line item came from, so the UI can say how much to
/// trust it. Ordered most to least grounded in this company's own data.
enum PriceBasis {
  /// Matched an existing LineItemCatalogEntry — this company's own price
  /// for work it has priced before.
  COMPANY_CATALOG

  /// Informed by what this company actually bid on similar past work
  /// (a won BidInvitation in the same trade scope).
  HISTORICAL_BID

  /// Claude's own estimate from general market knowledge, with no company
  /// data behind it. The weakest basis, and the one most in need of a
  /// visibly weaker badge.
  GENERAL_KNOWLEDGE
}

model ChangeOrder {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  number      Int
  title       String
  description String?
  createdAt   DateTime @default(now())

  /// Nothing before APPROVED touches JobLineItem. See ChangeOrderProposal.
  status ChangeOrderStatus @default(DRAFT)

  /// Entered, not stamped. A PCO logged after the fact has to record the
  /// date it actually went to the GC — stamping `now()` would make every
  /// backfilled change order look same-day, and the turnaround evidence
  /// that justifies a delay claim would be fiction. Same rule as RFIs.
  submittedOn DateTime?
  decidedOn   DateTime?

  /// The GC's stated reason, on an approval or a rejection.
  decisionNotes String?

  /// When this change order's proposals were written onto JobLineItem.
  /// Non-null means the scope is live; it is what stops the same change
  /// order being applied to the budget twice. Cleared by reopenChangeOrder,
  /// which is what allows a reopened change order to be approved again.
  appliedAt DateTime?

  /// Set when an APPROVED change order was unwound back to DRAFT. Kept
  /// rather than silently reset so the history still shows that this
  /// change order was once approved and taken back.
  reopenedAt DateTime?
  reopenNote String?

  /// A change order raised to correct an earlier one. The original stays
  /// APPROVED -- it was approved, and it did move the contract value, so
  /// saying otherwise would be a lie. This link is the documentary trail
  /// between the two.
  ///
  /// A revision holds ordinary proposals against the CURRENT state of the
  /// job, not a delta against the original: to correct a line the original
  /// priced at $250 to $300, the revision carries an EDIT proposal setting
  /// $300. That keeps one set of apply mechanics rather than a second,
  /// subtly different one for revisions.
  supersedesId String?
  supersedes   ChangeOrder?  @relation("ChangeOrderRevision", fields: [supersedesId], references: [id])
  revisions    ChangeOrder[] @relation("ChangeOrderRevision")

  addedLineItems JobLineItem[]             @relation("OriginChangeOrder")
  edits          ChangeOrderLineItemEdit[]
  proposals      ChangeOrderProposal[]
  docuSignEnvelopes DocuSignEnvelope[]
  /// Delays this change order was drafted from (DelayEvent.changeOrderId).
  delayEvents    DelayEvent[]

  @@unique([jobId, number])
  @@index([jobId])
  @@index([jobId, status])
  @@index([supersedesId])
}

/// Where a change order sits between "we think this is extra work" and
/// "the GC agreed to pay for it".
///
/// Only APPROVED has touched JobLineItem. That matters more than it looks:
/// contract value, WIP, retainage and pay applications are all
/// `SUM(job.lineItems WHERE isDeleted = false)`, so if a pending change
/// order wrote to JobLineItem, every one of those figures would silently
/// include money the GC has not agreed to pay — across ten separate read
/// sites that each filter `isDeleted` by hand. Keeping proposals out of
/// JobLineItem entirely means none of those call sites need to know this
/// lifecycle exists.
enum ChangeOrderStatus {
  /// Being written. Not sent, no dates, freely editable or deleted.
  DRAFT

  /// Sent to the GC, awaiting a decision. This is the PCO state.
  SUBMITTED

  /// The GC agreed. Proposals have been applied to JobLineItem and the
  /// budget has moved. Terminal.
  APPROVED

  /// The GC declined. Never applied, kept as the record that it was asked
  /// for and refused — which is exactly the evidence a claim needs.
  REJECTED

  /// Withdrawn by us before a decision. Distinct from REJECTED: nobody
  /// said no, we stopped asking.
  VOID
}

/// Issues change order numbers per job. Same reasoning as RfiCounter and
/// SafetyCaseCounter: a number computed from the change orders that still
/// exist (max+1) is freed again when one is discarded, so the next draft
/// reissues it -- and two different documents end up having been called
/// CO #3. This row only increments.
model ChangeOrderCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

enum ChangeOrderChangeType {
  ADD
  EDIT
  REMOVE
}

/// The proposed content of a change order, held here while it is DRAFT or
/// SUBMITTED so that nothing in the job's live figures can see it.
///
/// This is intent, not value. Nothing computes a contract total, a WIP
/// figure or a pay application from this table — `approveChangeOrder` is
/// the single place it is read for anything other than display, and all it
/// does there is apply each row to JobLineItem and write the matching
/// ChangeOrderLineItemEdit audit rows. After that, JobLineItem is once
/// again the only place the numbers live, exactly as before this lifecycle
/// existed.
///
/// Deliberately NOT the same table as ChangeOrderLineItemEdit: that one is
/// an after-the-fact audit log of what a change order did (old -> new),
/// and it stays audit-only. This one is a before-the-fact statement of
/// what it would do. Collapsing them would make the audit log load-bearing.
model ChangeOrderProposal {
  id            String                @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder           @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  changeType    ChangeOrderChangeType

  /// Null for ADD — the line item does not exist yet and is created on
  /// approval. Set for EDIT and REMOVE.
  lineItemId String?
  lineItem   JobLineItem? @relation("ProposedChangeTarget", fields: [lineItemId], references: [id])

  /// ADD: the line item to create. EDIT: the new values, where null means
  /// "leave this field alone". Unused for REMOVE. Types mirror
  /// JobLineItem exactly so applying a proposal is a straight copy.
  description              String?
  unit                     String?
  quantity                 Decimal?    @db.Decimal(12, 2)
  unitPrice                Decimal?    @db.Decimal(12, 2)
  budgetedUnitCost         Decimal?    @db.Decimal(12, 2)
  currentEstimatedUnitCost Decimal?    @db.Decimal(12, 2)
  tradeScope               TradeScope?

  /// What this proposal replaced, captured at the moment it was applied.
  /// Null until then.
  ///
  /// This exists so reopenChangeOrder can put the line item back without
  /// reading ChangeOrderLineItemEdit. That table is an audit log and stays
  /// audit-only -- deriving live values from it would make deleting a log
  /// row change the contract value, which is exactly what the audit-only
  /// rule in ARCHITECTURE.md prevents. A snapshot of what was overwritten
  /// is a different thing from a log of what happened.
  previousQuantity  Decimal? @db.Decimal(12, 2)
  previousUnitPrice Decimal? @db.Decimal(12, 2)
  previousIsDeleted Boolean?

  createdAt DateTime @default(now())

  @@index([changeOrderId])
  @@index([lineItemId])
}

/// Audit log only. Records what a change order changed on an EXISTING
/// JobLineItem (old value -> new value). The live value always lives on
/// JobLineItem itself — nothing reads totals from this table.
model ChangeOrderLineItemEdit {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id])
  lineItemId    String
  lineItem      JobLineItem @relation(fields: [lineItemId], references: [id])
  field         String
  oldValue      String
  newValue      String
  createdAt     DateTime    @default(now())

  @@index([changeOrderId])
  @@index([lineItemId])
}

/// A company's own cost-coding vocabulary — what a contractor calls a phase
/// code or a cost code, and what its budget report is grouped by.
///
/// THIS IS NOT A SECOND COPY OF LINE-ITEM DATA, which ARCHITECTURE.md
/// forbids. It is a CLASSIFICATION that the one line-item table points at,
/// exactly like CraftClassification — company-scoped, nullable FK, no
/// backfill. JobLineItem remains the single place a line item lives.
///
/// Why it exists: every document a real contractor produces is organised by
/// this code. The change-order request prices labour under it, the weekly
/// budget report groups by it, and a purchase order codes each line to it —
/// the same code reconciling across three documents that have to agree.
/// Without it, "what did we make on 04112 across every job this year" has
/// no answer, because a JobLineItem's description is free text and belongs
/// to one job.
///
/// `code` is FREE TEXT and deliberately not validated against MasterFormat.
/// Contractors rename these so their reports match what they already read —
/// "we can rename our phase codes just so the way they appear in our budget,
/// they look the same". A product that refuses a code for not being in a
/// standard list is a product nobody can enter their own budget into.
model PhaseCode {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// As the company writes it on its own paperwork — "04112".
  code String

  /// What it is, in their words — "Plywood - SF".
  name String

  /// How the phase is measured: SF, LF, EA, HR. Nullable, because a phase
  /// can be a dollar bucket with no natural unit (general conditions).
  unit String?

  /// Whether hours are coded to this phase at all, or only dollars. A real
  /// budget report has both: "some of these have labor codes, some are just
  /// cost codes". Nothing is inferred from it yet; it is recorded here so a
  /// labour report can tell an unphased hour from one that never takes any.
  tracksLabor Boolean @default(true)

  /// Retired rather than deleted. A phase code that has priced work is
  /// evidence of how that work was coded, and deleting it would rewrite the
  /// history of a job that is already invoiced.
  isActive Boolean @default(true)

  /// The order the company reads them in, which is not alphabetical and is
  /// not the code order either.
  sortOrder Int @default(0)

  lineItems JobLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

enum CostCategory {
  LABOR
  MATERIAL
  SUBCONTRACTOR
  OTHER
}

/// An actual expense logged against a JobLineItem — references the line
/// item rather than duplicating it, the same way ChangeOrder does.
///
/// ACTUAL COST PER LINE ITEM IS *NOT* SUM(costEntries.amount). This comment
/// said it was, for months after it stopped being true, and it is the first
/// place anyone reads when they ask the question. Issue #287: a CostEntry is
/// created in exactly one place in the product — the manual "log a cost"
/// form — so on a self-performed framing or drywall line this table holds
/// the materials and none of the crew, which for that trade is most of the
/// money.
///
/// Actual cost is cost entries PLUS the burdened labor on the TimeEntry rows
/// that name the line, composed by apps/web/lib/labor-job-cost.ts. Still
/// computed at read time, still stored nowhere — deriving CostEntry rows
/// from time entries would both store derived state and double-count against
/// a manual labor cost somebody had already typed.
///
/// `category` is load-bearing where the two meet. The app ADDS both, and on
/// a ledger (/jobs/[id]) a duplicate is allowed to stand, because nothing
/// can tell a duplicate from two real costs. But a LABOR-category entry
/// sitting beside logged hours makes that line unreadable as a unit cost, so
/// /catalog — which LEARNS a rate and writes it into
/// LineItemCatalogEntry.defaultBudgetedUnitCost — excludes it from its
/// sample and says so. See hasAmbiguousLaborCost in lib/catalog-actuals.ts.
///
/// Unlike change orders, logging a cost isn't gated by job status: real
/// spending happens throughout the job, especially once work is in
/// progress.
model CostEntry {
  id          String       @id @default(cuid())
  lineItemId  String
  lineItem    JobLineItem  @relation(fields: [lineItemId], references: [id])
  description String
  amount      Decimal      @db.Decimal(12, 2)
  category    CostCategory @default(OTHER)

  /// Independent of the parent JobLineItem's tradeScope — a "general
  /// conditions" line can carry cost entries spanning several trades, so
  /// this is tagged per-expense, not just inherited from the line item.
  tradeScope TradeScope?
  incurredAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  @@index([lineItemId])
}

/// Crew assignment: which company Users are on a Job. Genuinely many-to-many
/// (a job can have several people, a person can be on several jobs), so —
/// unlike startDate/endDate — this needs a join table. References Job and
/// User directly; never duplicates their data.
model JobAssignment {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}
