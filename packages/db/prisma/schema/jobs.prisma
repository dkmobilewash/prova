// The unified Job / JobLineItem object and everything hanging off it.
// See /ARCHITECTURE.md before adding a model that looks like it duplicates
// line-item data.
//
// Part of the multi-file Prisma schema in this folder.

enum JobStatus {
  ESTIMATE
  CONTRACTED
  IN_PROGRESS
  COMPLETE
}

/// The unified object. A Job's `lineItems` ARE the estimate, the budget, the
/// contract content, and the job-costing structure — there is no separate
/// table for any of those views. See /ARCHITECTURE.md.
model Job {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id])
  name      String
  scope     String?
  status    JobStatus @default(ESTIMATE)
  // Single start/end dates on the Job itself — properties of the job, not a
  // list of entries, so (unlike CostEntry/ChangeOrder) this doesn't need a
  // separate table. Nullable: most jobs start unscheduled.
  startDate DateTime?
  endDate   DateTime?

  /// Which office/yard is running this job. Nullable: most existing jobs
  /// predate this and there's no backfill source. This is a place to
  /// RECORD the operating location only — nothing yet reads it to
  /// auto-derive the applicable license or union agreement; that's real
  /// application logic for a future phase, not built here.
  operatingLocationId String?
  operatingLocation   CompanyLocation? @relation(fields: [operatingLocationId], references: [id])

  /// This job's retainage rate — usually pre-filled from
  /// Contact.defaultRetainagePercent at contract time but independently
  /// editable per job, since a GC's standing terms are a starting point,
  /// not a binding value. Null means retainage isn't withheld on this job
  /// (or hasn't been set yet). New invoices snapshot this rate into
  /// Invoice.retainageWithheld at creation — changing it here later never
  /// rewrites past invoices, same reasoning as JobLineItem.budgetedUnitCost.
  retainagePercent Decimal? @db.Decimal(5, 2)

  /// The anchor date for retainage release forecasting — when this job is
  /// expected to reach substantial completion, the point GCs typically
  /// release retainage. A plain field, not a JobStatus stage: closeout/
  /// warranty tracking (JobStatus stopping at COMPLETE today) is a
  /// separate, not-yet-built phase.
  substantialCompletionDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lineItems                    JobLineItem[]
  changeOrders                 ChangeOrder[]
  changeOrderCounter           ChangeOrderCounter?
  assignments                  JobAssignment[]
  signatureRequests            SignatureRequest[]
  invoices                     Invoice[]
  complianceDocuments          ComplianceDocument[]
  equipment                    Equipment[]
  estimateVersions             EstimateVersion[]
  contractDocuments            ContractDocument[]
  timeEntries                  TimeEntry[]
  dispatchSlips                DispatchSlip[]
  prevailingWageDeterminations PrevailingWageDetermination[]
  retainageReleases            RetainageRelease[]
  punchListItems               PunchListItem[]
  dailyFieldReports            DailyFieldReport[]
  safetyIncidents              SafetyIncident[]
  toolboxTalks                 ToolboxTalk[]
  rfis                         Rfi[]
  rfiCounter                   RfiCounter?

  @@index([companyId])
  @@index([contactId])
  @@index([operatingLocationId])
}

/// A single line item, referenced everywhere: estimate, contract summary,
/// budget total, and job costing. A change order mutates rows in this table
/// (or adds new ones) — it never forks them into a parallel shape.
model JobLineItem {
  id          String  @id @default(cuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id])
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unit        String?

  /// Optional — a categorization dimension on top of the cost/WIP fields
  /// below, not a prerequisite for them.
  tradeScope TradeScope?

  /// Estimated labor hours for this line, optionally tied to which craft
  /// classification would perform it (journeyman/apprentice/foreman by
  /// local — see CraftClassification). Both optional: a material-only or
  /// lump-sum line has neither. Not yet fed into a burdened labor cost —
  /// that needs FringeRateSchedule wired in, a separate future step.
  laborHours            Decimal?             @db.Decimal(8, 2)
  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  /// Nullable: a cost-only budget line (general conditions, overhead,
  /// contingency) has no client-facing sale price. Contract value /
  /// invoicing totals treat a null unitPrice as $0 revenue — the line still
  /// carries quantity and cost fields, it just isn't billed directly.
  unitPrice Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)

  /// The estimated unit cost at the time this line was priced (estimate
  /// approval). Set once, stays put as the historical baseline for WIP
  /// reporting — never silently overwritten by later re-forecasting.
  budgetedUnitCost Decimal? @db.Decimal(12, 2)

  /// The PM's current forecast of unit cost, re-estimated as the job
  /// progresses. Defaults to budgetedUnitCost at creation (app-level, not a
  /// DB default) but is independently mutable afterward. This is what
  /// feeds the live percent-complete calculation — see lib/wip.ts.
  currentEstimatedUnitCost Decimal? @db.Decimal(12, 2)

  /// PM override for cost-to-complete. When null, it's derived mechanically
  /// as (currentEstimatedUnitCost * quantity) - actual costs to date. When
  /// set, it overrides that mechanical number — e.g. the PM knows a sub is
  /// behind schedule or a change order is coming before the cost data
  /// reflects it. See lib/wip.ts.
  estimatedCostToComplete Decimal? @db.Decimal(12, 2)

  /// Soft delete: a change order can remove scope without losing history.
  /// Deleted line items are excluded from budget/contract totals.
  isDeleted Boolean @default(false)

  /// True when this row came from draftEstimateLineItems (Claude reading
  /// free-text scope of work) rather than being typed in directly. A
  /// "please verify" signal for the UI, same as ComplianceDocument's
  /// aiExtracted — never a lock, and never auto-approved into a contract.
  aiDrafted Boolean @default(false)

  /// Set only when this row was created BY a change order (added scope).
  /// Null for line items that were part of the original estimate.
  originChangeOrderId String?
  originChangeOrder   ChangeOrder? @relation("OriginChangeOrder", fields: [originChangeOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edits             ChangeOrderLineItemEdit[]
  costEntries       CostEntry[]
  timeEntries       TimeEntry[]
  invoiceLineItems  InvoiceLineItem[]
  proposedChanges   ChangeOrderProposal[]     @relation("ProposedChangeTarget")

  @@index([jobId])
  @@index([originChangeOrderId])
  @@index([craftClassificationId])
}

/// A change order groups: (a) newly added JobLineItems (via
/// JobLineItem.originChangeOrderId), and (b) edits to existing JobLineItems
/// (logged in ChangeOrderLineItemEdit). It never stores its own copy of
/// line-item data.
model ChangeOrder {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  number      Int
  title       String
  description String?
  createdAt   DateTime @default(now())

  /// Nothing before APPROVED touches JobLineItem. See ChangeOrderProposal.
  status ChangeOrderStatus @default(DRAFT)

  /// Entered, not stamped. A PCO logged after the fact has to record the
  /// date it actually went to the GC — stamping `now()` would make every
  /// backfilled change order look same-day, and the turnaround evidence
  /// that justifies a delay claim would be fiction. Same rule as RFIs.
  submittedOn DateTime?
  decidedOn   DateTime?

  /// The GC's stated reason, on an approval or a rejection.
  decisionNotes String?

  /// When this change order's proposals were written onto JobLineItem.
  /// Non-null means the scope is live; it is what stops the same change
  /// order being applied to the budget twice. Cleared by reopenChangeOrder,
  /// which is what allows a reopened change order to be approved again.
  appliedAt DateTime?

  /// Set when an APPROVED change order was unwound back to DRAFT. Kept
  /// rather than silently reset so the history still shows that this
  /// change order was once approved and taken back.
  reopenedAt DateTime?
  reopenNote String?

  /// A change order raised to correct an earlier one. The original stays
  /// APPROVED -- it was approved, and it did move the contract value, so
  /// saying otherwise would be a lie. This link is the documentary trail
  /// between the two.
  ///
  /// A revision holds ordinary proposals against the CURRENT state of the
  /// job, not a delta against the original: to correct a line the original
  /// priced at $250 to $300, the revision carries an EDIT proposal setting
  /// $300. That keeps one set of apply mechanics rather than a second,
  /// subtly different one for revisions.
  supersedesId String?
  supersedes   ChangeOrder?  @relation("ChangeOrderRevision", fields: [supersedesId], references: [id])
  revisions    ChangeOrder[] @relation("ChangeOrderRevision")

  addedLineItems JobLineItem[]             @relation("OriginChangeOrder")
  edits          ChangeOrderLineItemEdit[]
  proposals      ChangeOrderProposal[]

  @@unique([jobId, number])
  @@index([jobId])
  @@index([jobId, status])
  @@index([supersedesId])
}

/// Where a change order sits between "we think this is extra work" and
/// "the GC agreed to pay for it".
///
/// Only APPROVED has touched JobLineItem. That matters more than it looks:
/// contract value, WIP, retainage and pay applications are all
/// `SUM(job.lineItems WHERE isDeleted = false)`, so if a pending change
/// order wrote to JobLineItem, every one of those figures would silently
/// include money the GC has not agreed to pay — across ten separate read
/// sites that each filter `isDeleted` by hand. Keeping proposals out of
/// JobLineItem entirely means none of those call sites need to know this
/// lifecycle exists.
enum ChangeOrderStatus {
  /// Being written. Not sent, no dates, freely editable or deleted.
  DRAFT

  /// Sent to the GC, awaiting a decision. This is the PCO state.
  SUBMITTED

  /// The GC agreed. Proposals have been applied to JobLineItem and the
  /// budget has moved. Terminal.
  APPROVED

  /// The GC declined. Never applied, kept as the record that it was asked
  /// for and refused — which is exactly the evidence a claim needs.
  REJECTED

  /// Withdrawn by us before a decision. Distinct from REJECTED: nobody
  /// said no, we stopped asking.
  VOID
}

/// Issues change order numbers per job. Same reasoning as RfiCounter and
/// SafetyCaseCounter: a number computed from the change orders that still
/// exist (max+1) is freed again when one is discarded, so the next draft
/// reissues it -- and two different documents end up having been called
/// CO #3. This row only increments.
model ChangeOrderCounter {
  jobId      String @id
  job        Job    @relation(fields: [jobId], references: [id])
  lastNumber Int    @default(0)

  updatedAt DateTime @updatedAt
}

enum ChangeOrderChangeType {
  ADD
  EDIT
  REMOVE
}

/// The proposed content of a change order, held here while it is DRAFT or
/// SUBMITTED so that nothing in the job's live figures can see it.
///
/// This is intent, not value. Nothing computes a contract total, a WIP
/// figure or a pay application from this table — `approveChangeOrder` is
/// the single place it is read for anything other than display, and all it
/// does there is apply each row to JobLineItem and write the matching
/// ChangeOrderLineItemEdit audit rows. After that, JobLineItem is once
/// again the only place the numbers live, exactly as before this lifecycle
/// existed.
///
/// Deliberately NOT the same table as ChangeOrderLineItemEdit: that one is
/// an after-the-fact audit log of what a change order did (old -> new),
/// and it stays audit-only. This one is a before-the-fact statement of
/// what it would do. Collapsing them would make the audit log load-bearing.
model ChangeOrderProposal {
  id            String                @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder           @relation(fields: [changeOrderId], references: [id], onDelete: Cascade)
  changeType    ChangeOrderChangeType

  /// Null for ADD — the line item does not exist yet and is created on
  /// approval. Set for EDIT and REMOVE.
  lineItemId String?
  lineItem   JobLineItem? @relation("ProposedChangeTarget", fields: [lineItemId], references: [id])

  /// ADD: the line item to create. EDIT: the new values, where null means
  /// "leave this field alone". Unused for REMOVE. Types mirror
  /// JobLineItem exactly so applying a proposal is a straight copy.
  description              String?
  unit                     String?
  quantity                 Decimal?    @db.Decimal(12, 2)
  unitPrice                Decimal?    @db.Decimal(12, 2)
  budgetedUnitCost         Decimal?    @db.Decimal(12, 2)
  currentEstimatedUnitCost Decimal?    @db.Decimal(12, 2)
  tradeScope               TradeScope?

  /// What this proposal replaced, captured at the moment it was applied.
  /// Null until then.
  ///
  /// This exists so reopenChangeOrder can put the line item back without
  /// reading ChangeOrderLineItemEdit. That table is an audit log and stays
  /// audit-only -- deriving live values from it would make deleting a log
  /// row change the contract value, which is exactly what the audit-only
  /// rule in ARCHITECTURE.md prevents. A snapshot of what was overwritten
  /// is a different thing from a log of what happened.
  previousQuantity  Decimal? @db.Decimal(12, 2)
  previousUnitPrice Decimal? @db.Decimal(12, 2)
  previousIsDeleted Boolean?

  createdAt DateTime @default(now())

  @@index([changeOrderId])
  @@index([lineItemId])
}

/// Audit log only. Records what a change order changed on an EXISTING
/// JobLineItem (old value -> new value). The live value always lives on
/// JobLineItem itself — nothing reads totals from this table.
model ChangeOrderLineItemEdit {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id])
  lineItemId    String
  lineItem      JobLineItem @relation(fields: [lineItemId], references: [id])
  field         String
  oldValue      String
  newValue      String
  createdAt     DateTime    @default(now())

  @@index([changeOrderId])
  @@index([lineItemId])
}

enum CostCategory {
  LABOR
  MATERIAL
  SUBCONTRACTOR
  OTHER
}

/// An actual expense logged against a JobLineItem — references the line
/// item rather than duplicating it, the same way ChangeOrder does. Actual
/// cost per line item is SUM(costEntries.amount), computed, never stored.
/// Unlike change orders, logging a cost isn't gated by job status: real
/// spending happens throughout the job, especially once work is in
/// progress.
model CostEntry {
  id          String       @id @default(cuid())
  lineItemId  String
  lineItem    JobLineItem  @relation(fields: [lineItemId], references: [id])
  description String
  amount      Decimal      @db.Decimal(12, 2)
  category    CostCategory @default(OTHER)

  /// Independent of the parent JobLineItem's tradeScope — a "general
  /// conditions" line can carry cost entries spanning several trades, so
  /// this is tagged per-expense, not just inherited from the line item.
  tradeScope TradeScope?
  incurredAt DateTime    @default(now())
  createdAt  DateTime    @default(now())

  @@index([lineItemId])
}

/// Crew assignment: which company Users are on a Job. Genuinely many-to-many
/// (a job can have several people, a person can be on several jobs), so —
/// unlike startDate/endDate — this needs a join table. References Job and
/// User directly; never duplicates their data.
model JobAssignment {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}
