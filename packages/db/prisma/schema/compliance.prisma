// Compliance documents, licensing, insurance and bonding.
//
// Part of the multi-file Prisma schema in this folder.

enum ComplianceDocumentType {
  LIEN_WAIVER
  CERTIFICATE_OF_INSURANCE
  CERTIFIED_PAYROLL
  UNION_FRINGE_BENEFIT_FILING
  UNION_AGREEMENT
}

enum ComplianceDocumentStatus {
  PENDING
  RECEIVED
}

/// Tracks compliance paperwork — lien waivers, certificates of insurance,
/// certified payroll reports, and union fringe/benefit filings. All four
/// share the same shape: a document tied to a party (subcontractor,
/// vendor, or union trust fund), often a specific job, with a lifecycle
/// (requested -> received) and, for COIs, an expiration to track renewal.
///
/// File storage (Vercel Blob) and AI extraction are both wired up now —
/// see extractComplianceDocument in packages/integrations/src/anthropic.ts
/// and uploadComplianceDocument in apps/web/lib/actions.ts. See
/// ARCHITECTURE.md.
model ComplianceDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Optional: some documents are job-specific (a lien waiver, certified
  /// payroll for a job's crew); others are company-level (a general
  /// liability COI covering all jobs).
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  type ComplianceDocumentType

  /// The subcontractor, vendor, or union trust fund this document is
  /// about. Free text rather than a new Subcontractor/Vendor directory
  /// model — that's a separate modeling decision this phase doesn't need
  /// to make yet.
  partyName String

  status ComplianceDocumentStatus @default(PENDING)

  /// Lien waiver amount, or fringe-benefit contribution amount. Null for
  /// a COI (no dollar amount).
  amount Decimal? @db.Decimal(12, 2)

  /// The billing/reporting period this document covers — a certified
  /// payroll week, a fringe filing month, a lien waiver's covered payment
  /// period. Null for a COI (it doesn't cover a period).
  periodStart DateTime?
  periodEnd   DateTime?

  /// When the document took effect — a COI's effective date, a lien
  /// waiver's signed date.
  effectiveDate DateTime?

  /// A COI's expiration date. Whether a document is "expired" or
  /// "expiring soon" is computed at read time from this field, never
  /// stored as a separate status — same rule as every computed total
  /// elsewhere in this schema (it would just go stale otherwise).
  expiresAt DateTime?

  notes String?

  /// The uploaded source file (Vercel Blob URL) and its original name.
  /// Both null for a document created without an upload (manual entry).
  fileUrl  String?
  fileName String?

  /// True when type/partyName/amount/dates were populated by
  /// extractComplianceDocument (Claude reading the uploaded file) rather
  /// than typed in by hand. Extracted fields are still editable — this is
  /// a "please verify" signal for the UI, not a lock.
  aiExtracted Boolean @default(false)

  uploadedByUserId String?
  uploadedByUser   User?   @relation(fields: [uploadedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A CBA (type UNION_AGREEMENT) can be linked from CompanyUnionAgreement
  /// as its source document.
  companyUnionAgreements CompanyUnionAgreement[]

  @@index([companyId])
  @@index([jobId])
  @@index([expiresAt])
}

enum JurisdictionType {
  STATE
  COUNTY
  CITY
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
  INACTIVE
}

/// One row per license HELD, not per state — some jurisdictions (Colorado)
/// have no state license at all, only municipal ones, so a company working
/// in two Colorado cities holds two separate rows here, not one "Colorado"
/// row. classificationCode/Label are free text rather than a hardcoded
/// enum: licensing structure isn't uniform across jurisdictions (CA/AZ
/// split by trade, UT combines several trades into one code, CO has no
/// classification system at all) — see LicenseClassificationReference for
/// the jurisdictions where a fixed code list actually exists.
model CompanyLicense {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  jurisdictionType JurisdictionType
  /// e.g. "California", "Arizona", or "City of Longmont, CO" for a
  /// municipal license.
  jurisdictionName String

  classificationCode  String?
  classificationLabel String?

  licenseNumber  String
  issueDate      DateTime?
  /// Whether a license is "expiring soon" is computed at read time from
  /// this field, same rule as ComplianceDocument.expiresAt.
  expirationDate DateTime?
  status         LicenseStatus @default(ACTIVE)
  /// Only for jurisdictions that tie a bond to the license itself —
  /// distinct from the company's general bonding capacity (CompanyBond,
  /// a later phase).
  bondNumber     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([expirationDate])
}

/// A global lookup, not scoped to a Company — the same CA/AZ/UT
/// classification codes apply to every company licensed in those states.
/// Only seeded for jurisdictions with a real, verified, fixed
/// classification list (CA, AZ, UT). Deliberately NOT seeded for Nevada:
/// the exact NAC 624 subclassification wasn't available from a public
/// source, and a wrong guess here is worse than an empty table — see
/// ARCHITECTURE.md. Jurisdictions with no classification system at all
/// (Colorado's municipal licenses) never get rows here; CompanyLicense's
/// classificationCode/Label just stay free text for those.
model LicenseClassificationReference {
  id               String   @id @default(cuid())
  jurisdictionName String
  code             String
  label            String
  createdAt        DateTime @default(now())

  @@unique([jurisdictionName, code])
}

enum InsurancePolicyType {
  GENERAL_LIABILITY
  WORKERS_COMP
  AUTO
  UMBRELLA_EXCESS
}

/// The company's own insurance record — distinct from ComplianceDocument,
/// which tracks documents flowing between this company and GCs/subs on a
/// per-job basis. This is the source data those per-job COIs eventually
/// get generated from (future phase).
model CompanyInsurancePolicy {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  policyType   InsurancePolicyType
  carrier      String
  policyNumber String

  /// Free text rather than structured limit fields — what "coverage
  /// limits" means varies by policy type (GL: per-occurrence + aggregate;
  /// auto: combined single limit; workers' comp: statutory + employer's
  /// liability), so a fixed set of columns would be wrong for at least
  /// one type.
  coverageLimits String?

  effectiveDate  DateTime?
  /// Whether a policy is expiring/expired is computed at read time from
  /// this field, never stored — same rule as CompanyLicense.
  expirationDate DateTime?

  /// Reusable boilerplate used as the starting point when generating a
  /// COI to send a GC — e.g. standard additional-insured language. Not
  /// per-job or per-GC; that customization happens when a COI actually
  /// gets generated (future phase, not built here).
  defaultCertificateHolderTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([expirationDate])
}

enum BondType {
  LICENSE_BOND
  PERFORMANCE_PAYMENT_CAPACITY
}

/// The company's own bonding record. Deliberately NOT linked to
/// CompanyLicense.bondNumber (a jurisdiction-specific bond number entered
/// on the license itself) — the two can reference the same real-world bond
/// without a forced foreign key between them; connecting them explicitly
/// is a future refinement, not guessed at here.
model CompanyBond {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  suretyName String
  bondType   BondType

  aggregateBondingCapacity Decimal? @db.Decimal(12, 2)
  singleJobLimit           Decimal? @db.Decimal(12, 2)

  agentContactName  String?
  agentContactPhone String?
  agentContactEmail String?

  /// Whether a bond is up for renewal is computed at read time from this
  /// field, never stored — same rule as everywhere else in this schema.
  renewalDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([renewalDate])
}
