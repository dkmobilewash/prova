// Contracts, invoicing, payments, retainage and accounting sync.
// Diego's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum SignatureStatus {
  PENDING
  SIGNED
}

/// Where a pay application stands with the GC, tracked explicitly rather
/// than inferred from Payment rows — SUM(payments) vs. amount can tell you
/// "paid in full" or "partially paid" by dollars, but not "approved" or
/// "disputed", which are GC-side workflow states with no dollar signal at
/// all. Set by whoever's tracking the job; not auto-transitioned by
/// logPayment, since a fully-paid invoice can still be marked disputed
/// after the fact (a clawback, a warranty deduction argued later).
enum InvoiceStatus {
  SUBMITTED
  APPROVED
  PARTIALLY_PAID
  PAID
  DISPUTED
}

/// A client e-signature request for a Job's contract. The unguessable
/// `token` is the client's access control — there's no client login
/// (that's a separate, not-yet-built phase), so the token stands in for
/// one. Once signed, `snapshot` freezes what the client actually agreed to
/// at that moment: it's an audit record only, exactly like
/// ChangeOrderLineItemEdit — nothing live (the contract summary, the
/// budget) ever reads from it. See ARCHITECTURE.md.
model SignatureRequest {
  id     String          @id @default(cuid())
  jobId  String
  job    Job             @relation(fields: [jobId], references: [id])
  token  String          @unique @default(cuid())
  status SignatureStatus @default(PENDING)

  signerName  String?
  signerEmail String?
  signedAt    DateTime?
  ipAddress   String?
  userAgent   String?
  snapshot    Json?

  createdAt DateTime @default(now())

  @@index([jobId])
}

/// The actual subcontract agreement file (the GC-to-sub contract PDF) and
/// its amendment history — distinct from SignatureRequest.snapshot, which
/// captures Prova's own line-item data at the moment of e-signing, not a
/// document a GC handed over. Each upload is a new version, same pattern
/// as EstimateVersion: a manual checkpoint (versionNumber, an optional
/// note describing what changed), not an automatic log. The original
/// agreement is version 1; a later amendment is version 2, 3, etc. — all
/// kept, never overwritten, so the full history stays visible.
model ContractDocument {
  id            String @id @default(cuid())
  jobId         String
  job           Job    @relation(fields: [jobId], references: [id])
  versionNumber Int

  fileUrl  String
  fileName String
  note     String?

  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@unique([jobId, versionNumber])
  @@index([jobId])
}

/// A bill against a Job. Amount paid and balance are always
/// SUM(payments.amount) vs. amount — computed, never stored, same rule as
/// actual cost on JobLineItem. Only creatable once a job is CONTRACTED or
/// later: you don't invoice an estimate nobody agreed to yet.
model Invoice {
  id          String        @id @default(cuid())
  jobId       String
  job         Job           @relation(fields: [jobId], references: [id])
  number      Int
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  status      InvoiceStatus @default(SUBMITTED)

  /// Retainage withheld from this specific invoice — snapshotted at
  /// creation from Job.retainagePercent × amount, not recomputed live.
  /// Null when the job has no retainage rate set. This is the per-invoice
  /// ledger entry; SUM(retainageWithheld) across a job's invoices is its
  /// running total withheld — see lib/retainage.ts.
  retainageWithheld Decimal? @db.Decimal(12, 2)

  payments Payment[]

  /// Per-SOV-line breakdown, present only for invoices submitted as a full
  /// AIA-style pay application rather than a quick lump-sum bill — see
  /// InvoiceLineItem and lib/pay-application.ts. Empty for a plain invoice.
  lineItems InvoiceLineItem[]

  @@unique([jobId, number])
  @@index([jobId])
}

/// A payment received against an Invoice. No payment processor — this is a
/// manual record (check, cash, card swipe elsewhere), not a charge. An
/// invoice can have several, supporting partial/progress payments.
model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String?
  receivedAt DateTime @default(now())
  note       String?

  @@index([invoiceId])
}

/// One row of an AIA-style G703 continuation sheet: what's billed against
/// one JobLineItem on one pay application (Invoice). Previous-period and
/// cumulative totals are never stored here — lib/pay-application.ts derives
/// them by summing this table across a line item's earlier invoices on the
/// same job, same "derive, don't duplicate" rule as CostEntry vs.
/// JobLineItem actual cost.
model InvoiceLineItem {
  id         String      @id @default(cuid())
  invoiceId  String
  invoice    Invoice     @relation(fields: [invoiceId], references: [id])
  lineItemId String
  lineItem   JobLineItem @relation(fields: [lineItemId], references: [id])

  /// Value of work completed against this line, billed this period.
  thisPeriodBilled Decimal @db.Decimal(12, 2)

  /// Value of materials delivered/stored on site but not yet installed,
  /// billed separately from work-in-place per standard AIA G703 practice
  /// (its own column, not part of "work completed"). Zero rather than
  /// null when nothing's stored, so it always participates in the
  /// total-to-date sum without a null check at every call site.
  materialsStoredValue Decimal @default(0) @db.Decimal(12, 2)

  @@unique([invoiceId, lineItemId])
  @@index([invoiceId])
  @@index([lineItemId])
}

/// A record of retainage actually paid back to the sub — distinct from
/// Payment, which settles a specific Invoice's balance. Retainage
/// accumulates across every invoice on a job (Invoice.retainageWithheld)
/// and is typically released as one lump sum well after the invoices that
/// generated it, often at/after substantial completion, not tied to any
/// single invoice. Job-level withheld minus SUM(RetainageRelease.amount)
/// is the outstanding retainage balance — see lib/retainage.ts.
model RetainageRelease {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  amount     Decimal  @db.Decimal(12, 2)
  releasedAt DateTime @default(now())
  note       String?

  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([jobId])
}

/// One QuickBooks Online connection per Company. Tokens stored as plain
/// columns (sandbox-appropriate; revisit encryption-at-rest before this
/// connects to a real production QuickBooks account — see ARCHITECTURE.md).
/// This is connection infrastructure only: no Contact/Invoice data is
/// pushed to QuickBooks yet. See packages/integrations/src/quickbooks.ts.
model QuickBooksConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  /// The QuickBooks company ID this connection is scoped to.
  realmId String

  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime

  connectedByUserId String?
  connectedByUser   User?   @relation(fields: [connectedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
