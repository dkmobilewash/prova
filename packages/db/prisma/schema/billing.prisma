// Contracts, invoicing, payments, retainage and accounting sync.
// Diego's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum SignatureStatus {
  PENDING
  SIGNED
}

/// Where a pay application stands with the GC, tracked explicitly rather
/// than inferred from Payment rows — SUM(payments) vs. amount can tell you
/// "paid in full" or "partially paid" by dollars, but not "approved" or
/// "disputed", which are GC-side workflow states with no dollar signal at
/// all. Set by whoever's tracking the job; not auto-transitioned by
/// logPayment, since a fully-paid invoice can still be marked disputed
/// after the fact (a clawback, a warranty deduction argued later).
enum InvoiceStatus {
  SUBMITTED
  APPROVED
  PARTIALLY_PAID
  PAID
  DISPUTED
}

/// A client e-signature request for a Job's contract. The unguessable
/// `token` is the client's access control — there's no client login
/// (that's a separate, not-yet-built phase), so the token stands in for
/// one.
///
/// DELIBERATELY NO `@default` ON `token`. It was `@default(cuid())` until
/// 2026-09-03, which made a bearer credential out of an identifier
/// generator: cuid is collision-resistant, not unguessable, and this token
/// is the entire access control on an unauthenticated page that renders the
/// contract and marks it legally SIGNED. `createSignatureRequest` now
/// supplies it from `apps/web/lib/tokens.ts` (randomBytes(24), the same
/// generator as Contact.portalToken). The default is absent rather than
/// changed so that a create which forgets the token fails to compile
/// instead of silently issuing a weak one. Rows created before that date
/// still hold cuid tokens; issue a fresh link to replace one.
///
/// Once signed, `snapshot` freezes what the client actually agreed to
/// at that moment: it's an audit record only, exactly like
/// ChangeOrderLineItemEdit — nothing live (the contract summary, the
/// budget) ever reads from it. See ARCHITECTURE.md.
model SignatureRequest {
  id     String          @id @default(cuid())
  jobId  String
  job    Job             @relation(fields: [jobId], references: [id])
  token  String          @unique
  status SignatureStatus @default(PENDING)

  signerName  String?
  signerEmail String?
  signedAt    DateTime?
  ipAddress   String?
  userAgent   String?
  snapshot    Json?

  createdAt DateTime @default(now())

  @@index([jobId])
}

/// The actual subcontract agreement file (the GC-to-sub contract PDF) and
/// its amendment history — distinct from SignatureRequest.snapshot, which
/// captures Prova's own line-item data at the moment of e-signing, not a
/// document a GC handed over. Each upload is a new version, same pattern
/// as EstimateVersion: a manual checkpoint (versionNumber, an optional
/// note describing what changed), not an automatic log. The original
/// agreement is version 1; a later amendment is version 2, 3, etc. — all
/// kept, never overwritten, so the full history stays visible.
model ContractDocument {
  id            String @id @default(cuid())
  jobId         String
  job           Job    @relation(fields: [jobId], references: [id])
  versionNumber Int

  fileUrl  String
  fileName String
  note     String?

  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@unique([jobId, versionNumber])
  @@index([jobId])
}

/// A bill against a Job. Amount paid and balance are always
/// SUM(payments.amount) vs. amount — computed, never stored, same rule as
/// actual cost on JobLineItem. Only creatable once a job is CONTRACTED or
/// later: you don't invoice an estimate nobody agreed to yet.
model Invoice {
  id          String        @id @default(cuid())
  jobId       String
  job         Job           @relation(fields: [jobId], references: [id])
  number      Int
  description String?
  amount      Decimal       @db.Decimal(12, 2)
  issuedAt    DateTime      @default(now())
  dueAt       DateTime?
  status      InvoiceStatus @default(SUBMITTED)

  /// Retainage withheld from this specific invoice — snapshotted at
  /// creation from Job.retainagePercent × amount, not recomputed live.
  /// Null when the job has no retainage rate set. This is the per-invoice
  /// ledger entry; SUM(retainageWithheld) across a job's invoices is its
  /// running total withheld — see lib/retainage.ts.
  retainageWithheld Decimal? @db.Decimal(12, 2)

  payments Payment[]

  /// Per-SOV-line breakdown, present only for invoices submitted as a full
  /// AIA-style pay application rather than a quick lump-sum bill — see
  /// InvoiceLineItem and lib/pay-application.ts. Empty for a plain invoice.
  lineItems InvoiceLineItem[]

  @@unique([jobId, number])
  @@index([jobId])
}

/// A payment received against an Invoice. No payment processor — this is a
/// manual record (check, cash, card swipe elsewhere), not a charge. An
/// invoice can have several, supporting partial/progress payments.
model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String?
  receivedAt DateTime @default(now())
  note       String?

  @@index([invoiceId])
}

/// One row of an AIA-style G703 continuation sheet: what's billed against
/// one JobLineItem on one pay application (Invoice). Previous-period and
/// cumulative totals are never stored here — lib/pay-application.ts derives
/// them by summing this table across a line item's earlier invoices on the
/// same job, same "derive, don't duplicate" rule as CostEntry vs.
/// JobLineItem actual cost.
model InvoiceLineItem {
  id         String      @id @default(cuid())
  invoiceId  String
  invoice    Invoice     @relation(fields: [invoiceId], references: [id])
  lineItemId String
  lineItem   JobLineItem @relation(fields: [lineItemId], references: [id])

  /// Value of work completed against this line, billed this period.
  thisPeriodBilled Decimal @db.Decimal(12, 2)

  /// Value of materials NEWLY delivered/stored this period, not yet
  /// installed — a per-period delta, same shape as thisPeriodBilled, not a
  /// running balance. lib/pay-application.ts sums it across a line's
  /// earlier invoices to get the stored-to-date figure, exactly like
  /// thisPeriodBilled. Treating this field itself as a running balance was
  /// a real bug: a line's stored materials from an earlier application
  /// silently vanished from the total the moment a later application left
  /// this blank. Zero rather than null when nothing's newly stored, so it
  /// always participates in the sum without a null check at every call
  /// site. Materials later installed have no explicit transition here —
  /// enter a negative value in a later period to move value out of "stored"
  /// and an equal positive thisPeriodBilled to move it into "completed".
  materialsStoredValue Decimal @default(0) @db.Decimal(12, 2)

  @@unique([invoiceId, lineItemId])
  @@index([invoiceId])
  @@index([lineItemId])
}

/// A record of retainage actually paid back to the sub — distinct from
/// Payment, which settles a specific Invoice's balance. Retainage
/// accumulates across every invoice on a job (Invoice.retainageWithheld)
/// and is typically released as one lump sum well after the invoices that
/// generated it, often at/after substantial completion, not tied to any
/// single invoice. Job-level withheld minus SUM(RetainageRelease.amount)
/// is the outstanding retainage balance — see lib/retainage.ts.
model RetainageRelease {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  amount     Decimal  @db.Decimal(12, 2)
  releasedAt DateTime @default(now())
  note       String?

  createdByUserId String?
  createdByUser   User?    @relation(fields: [createdByUserId], references: [id])
  createdAt       DateTime @default(now())

  @@index([jobId])
}

enum QuickBooksConnectionStatus {
  CONNECTED
  /// The refresh token expired or was revoked. A person has to reconnect;
  /// no retry can fix it, which is why it is distinct from ERROR.
  NEEDS_REAUTH
  /// Reachable, but the last attempt failed for some other reason.
  ERROR
}

/// One QuickBooks Online connection per Company. Tokens stored as plain
/// columns (sandbox-appropriate; revisit encryption-at-rest before this
/// connects to a real production QuickBooks account — see ARCHITECTURE.md).
/// This is connection infrastructure only: no Contact/Invoice data is
/// pushed to QuickBooks yet. See packages/integrations/src/quickbooks.ts.
model QuickBooksConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  /// The QuickBooks company ID this connection is scoped to.
  realmId String

  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime

  /// Whether this connection can still reach QuickBooks.
  ///
  /// NOT derivable, which is why it is stored against this codebase's usual
  /// rule. An expiring refresh token has a date to compare against, but a
  /// REVOKED one has no signal at all — someone clicks "disconnect" inside
  /// QuickBooks and the only way to find out is to try and be refused.
  /// Intuit's refresh tokens also roll roughly every 100 days, so this
  /// arrives on a schedule whether or not anyone is watching.
  ///
  /// Before this existed, a dead refresh token threw out of accessTokenFor
  /// and a production build redacted it to a digest — so the person saw an
  /// opaque error on a page that had nothing to do with QuickBooks, and no
  /// screen anywhere said the connection was the problem.
  status QuickBooksConnectionStatus @default(CONNECTED)

  /// Why it stopped, in Intuit's own words, for the screen that asks
  /// someone to reconnect.
  statusDetail String?
  statusAt     DateTime?

  connectedByUserId String?
  connectedByUser   User?   @relation(fields: [connectedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Which of OUR records corresponds to which QuickBooks record.
///
/// The single most-corroborated complaint in the contractor-software
/// research is that accounting sync "silently diverges" — the two systems
/// stop agreeing about which invoice is which, and nobody can see when it
/// happened. That is what this table exists to make impossible: a push is
/// only ever a create when no link exists, and only ever an update when
/// one does.
///
/// entityType/entityId rather than a foreign key per kind: the same
/// question ("what is this in QuickBooks?") is asked of invoices,
/// payments, contacts and vendors, and a column per kind would mean a
/// migration for every new one. The tradeoff is no referential integrity,
/// which is why deletes on our side must clear the link explicitly.
model QuickBooksEntityLink {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// "Invoice" | "Payment" | "Contact" | "Vendor" — our model name.
  entityType String
  /// The cuid of our record.
  entityId   String

  /// The id QuickBooks assigned. Ours to store, never to invent.
  qboId String

  /// QuickBooks requires the current SyncToken on every update and rejects
  /// a stale one. That rejection is a FEATURE — it means someone changed
  /// the record in QuickBooks and our update would have overwritten them —
  /// so it is surfaced rather than retried blindly.
  qboSyncToken String?

  /// When we last pushed, and when we last read the record back and
  /// confirmed it matched. A push is not evidence; the read-back is.
  lastPushedAt   DateTime?
  lastVerifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// One link per record, and one QuickBooks record per link — both
  /// directions, because a duplicate in either is the double-posting bug
  /// every platform in the research is criticised for.
  @@unique([companyId, entityType, entityId])
  @@unique([companyId, entityType, qboId])
  @@index([companyId])
}

/// Which QuickBooks account each kind of money posts to.
///
/// Deliberately configured, never guessed. A contractor's accountant has
/// opinions about which account labor hits, and picking one silently is
/// how you corrupt someone's books in a way they find out about at tax
/// time.
model QuickBooksAccountMapping {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// What is being posted: a CostCategory value (LABOR, MATERIAL,
  /// SUBCONTRACTOR, OTHER), or "INCOME" for invoice revenue.
  purpose String

  /// The QuickBooks account, and its name at the time it was chosen so the
  /// UI can show something readable without a round trip.
  qboAccountId   String
  qboAccountName String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, purpose])
  @@index([companyId])
}

enum QuickBooksSyncOutcome {
  SUCCEEDED
  FAILED
  /// Pushed, but reading the record back showed something different. This
  /// is its own outcome because it is the failure mode that matters most
  /// and the one every competitor reports as success.
  VERIFY_MISMATCH
  /// Refused before contacting QuickBooks — no mapping, no connection, or
  /// a record that is not in a pushable state.
  SKIPPED
}

/// Every attempt to push something to QuickBooks, append-only.
///
/// Exists because "successfully applied" is exactly the claim that turned
/// out not to be a result when this project's migrations were reporting
/// success against a database nobody read. An accounting integration
/// deserves the same suspicion: record what was sent, what came back, and
/// whether reading it back agreed.
model QuickBooksSyncAttempt {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  entityType String
  entityId   String

  /// Stable across retries of the same logical push, so a retry can be
  /// recognised rather than duplicating a document. See
  /// lib/quickbooks-sync.ts.
  idempotencyKey String

  outcome QuickBooksSyncOutcome

  /// What we sent and what QuickBooks said, in human-readable summary
  /// form. Never the raw payload: it carries customer names and amounts
  /// that do not need a second copy, and tokens must never be logged.
  summary String
  /// The mismatch or error detail, when there is one.
  detail  String?

  /// The QuickBooks id involved, once known.
  qboId String?

  attemptedByUserId String?
  attemptedByUser   User?   @relation(fields: [attemptedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
}
