// Labor, time and union compliance: time entry, dispatch, prevailing wage,
// fringe rates. Diego's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum TimeEntryPayType {
  STRAIGHT
  OVERTIME
  DOUBLE_TIME
  SHIFT_DIFFERENTIAL
}

/// A single day's hours worked by one employee on one job — the field
/// time-tracking record job costing and (eventually) certified payroll
/// both need. Optionally tied to a specific JobLineItem (cost code/SOV
/// line) and CraftClassification, since not every entry is craft-specific
/// (e.g. a foreman's supervision time) but most union labor entries are.
/// payType tracks straight/overtime/double-time/shift-differential hours
/// as separate rows rather than one row with a rate multiplier, so a
/// worker's mixed day (6 straight + 2 OT) is two clean rows instead of one
/// row needing a blended-rate calculation. This tracks hours by category
/// only — it does not compute dollar cost; that needs a wage-rate engine
/// over FringeRateSchedule, a separate future step (same boundary
/// JobLineItem.laborHours already draws on the estimating side).
model TimeEntry {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  lineItemId String?
  lineItem   JobLineItem? @relation(fields: [lineItemId], references: [id])

  employeeUserId String?
  /// Named only because this model now has TWO relations to User (the other
  /// is lastCorrectedByUser below) and Prisma cannot disambiguate two
  /// unnamed ones — same precedent as WorkerCertification's holder /
  /// recordedBy pair. A relation NAME changes nothing in SQL: the foreign key
  /// is still "TimeEntry_employeeUserId_fkey" on the same column, so this
  /// carries no migration of its own.
  employeeUser   User?   @relation("TimeEntryEmployee", fields: [employeeUserId], references: [id], onDelete: Restrict)

  /// The crew member this entry is for, when the worker has no login. See
  /// crew.prisma. WIRED since #292 (corrected 2026-09-18 — this line said
  /// "NULL on every row today and read by nothing" for a week after that
  /// stopped being true): the phone's time screen writes it through
  /// POST /api/v1/jobs/[id]/time-entries, which checks the crew member is
  /// this company's and not archived, and the crew schedule and the Ask
  /// tools read it.
  ///
  /// employeeUserId is now NULLABLE — the relaxation this comment held back.
  /// An entry names a User (employeeUserId) OR a crew member (crewMemberId),
  /// never both and never neither; the XOR CHECK constraint in the migration
  /// enforces it.
  ///
  /// WHAT THIS COLUMN IS PROTECTED BY, AND IT CHANGED ON 2026-09-13.
  ///
  /// This block said the opposite for a week — "There is NO database trigger
  /// stopping this column being reassigned", and that the guarantee rested on
  /// there being no update path to TimeEntry at all. Both sentences were true
  /// when written and are false now, which is the perishable-claim shape
  /// CLAUDE.md records paying for twice: a claim about what the code does NOT
  /// have expires exactly as fast as a claim about what it does.
  ///
  /// THERE IS A DATABASE TRIGGER AGAIN. `prova_time_entry_identity_lock`, a
  /// BEFORE UPDATE trigger installed by
  /// 20260913120000_add_time_entry_correction, refuses any UPDATE that changes
  /// jobId, employeeUserId or date (and, since 20260918130000, the three
  /// clock-capture columns below), and refuses a crewMemberId that is already
  /// set from becoming a different one (NULL -> an id is still allowed: that
  /// is attribution, not reassignment). It is the trigger
  /// 20260905183000_add_crew_members deliberately did not ship, and the reason
  /// it held back — TimeEntry is live payroll and nothing would have exercised
  /// the trigger before real rows met it — is the thing that stopped being
  /// true: issue #63 added the first update path, a correction form, so the
  /// ordinary act of fixing an hour now exercises the lock.
  ///
  /// apps/web/lib/timeEntryWriteCensus.test.ts is still the source census and
  /// is still worth reading before you add a write, but what it asks has
  /// changed with the trigger: not "does an update path exist" (one does) but
  /// "does any update name a locked column". A source scan cannot see a raw
  /// UPDATE and never could; the trigger can.
  ///
  /// The XOR CHECK constraint (an entry names a User OR a crew member, not
  /// both) landed in the same commit that made employeeUserId nullable.
  ///
  /// onDelete: Restrict IS real — the database refuses to orphan the
  /// identity behind an hour that may already have been certified.
  crewMemberId String?
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)

  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  date    DateTime
  hours   Decimal          @db.Decimal(5, 2)
  payType TimeEntryPayType @default(STRAIGHT)

  /// Clock-capture evidence: the timestamps the phone recorded when this
  /// interval was clocked in and out, and the unpaid break subtracted from
  /// the worked duration. IMMUTABLE after creation — a correction fixes
  /// `hours` (the authoritative figure), never these. The phone computes
  /// DURATION only and never derives the pay-type split (lib/prevailing-wage.ts:
  /// TimeEntry.payType is entered by a person, nothing rewrites it). All three
  /// are null for web/typed/backfill entries that were not clocked.
  clockStartedAt    DateTime?
  clockEndedAt      DateTime?
  clockBreakMinutes Int?

  /// Flat daily allowances, independent of hours/payType — a per diem or
  /// travel day is still one row on this date for this employee/job, not
  /// a second entry. Both null for a normal local day with no allowance.
  perDiemAmount   Decimal? @db.Decimal(10, 2)
  travelPayAmount Decimal? @db.Decimal(10, 2)

  note String?

  /// Idempotency key from the phone, so a retried offline POST replays
  /// instead of duplicating. Null for web writes.
  clientOperationId String?

  createdAt DateTime @default(now())

  /// WHEN this entry was last corrected and BY WHOM. Issue #63: until then a
  /// logged hour could only be deleted and retyped, so a correction left no
  /// trace of itself at all — on the rows a WH-347 is built from.
  ///
  /// Both NULL means nobody has corrected it, which is every row that existed
  /// before the migration and every row logged right the first time. They are
  /// not derived from anything and cannot disagree with anything: this is a
  /// record of an event, the way createdAt is, which is also why
  /// lastCorrectedAt is STAMPED rather than entered. The date that matters and
  /// is entered by a human is `date` above, and that one is locked.
  ///
  /// WHAT THESE TWO COLUMNS DO NOT DO, so nobody reads more into them than is
  /// there: they do not record what the figure USED to be. "Corrected on the
  /// 13th by Cyrus" is three of the four things the issue asks for, and
  /// recovering the previous hours needs the amendment row it suggests — a
  /// locked original with a correction beside it, the way SubmittalRevision
  /// handles a package going again. That is held back deliberately, not
  /// forgotten: every read path (WH-347, certified payroll, apprentice ratio,
  /// burdened labor cost, the job page totals) would have to learn to ignore a
  /// superseded row, and one that missed the memo would DOUBLE the hours on a
  /// signed filing. Half of that model is worse than none of it.
  lastCorrectedAt       DateTime?
  lastCorrectedByUserId String?
  lastCorrectedByUser   User?     @relation("TimeEntryCorrectedBy", fields: [lastCorrectedByUserId], references: [id])

  @@unique([jobId, clientOperationId])
  @@index([jobId])
  @@index([lineItemId])
  @@index([employeeUserId])
  @@index([crewMemberId])
  @@index([craftClassificationId])
  @@index([lastCorrectedByUserId])
}

/// A union hiring hall's dispatch of one worker to one job — the referral
/// record that authorizes them to work under that local's agreement on
/// this job, distinct from TimeEntry (which logs hours actually worked
/// afterward). The physical dispatch slip is often a paper form the hall
/// hands the worker; fileUrl/fileName are optional since some halls
/// dispatch by phone with just a referral number, no scanned document.
model DispatchSlip {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  /// WHO THE HALL SENT: a User (employeeUserId) OR a crew member
  /// (crewMemberId), never both and never neither — the XOR CHECK
  /// "DispatchSlip_employee_or_crew" in 20260921120000_allow_crew_dispatch_slips
  /// enforces it, the same shape as TimeEntry's since #412.
  ///
  /// employeeUserId was REQUIRED until that migration, which made the one
  /// person a hiring hall exists to send — a field worker with no login — the
  /// one person this form could not record. It was loosened, not replaced:
  /// the column, its index and its foreign key are unchanged, so a build that
  /// still reads it keeps working through the deploy window (CLAUDE.md, #378).
  ///
  /// onDelete: Restrict is spelled out rather than left to Prisma's default,
  /// and that is load-bearing: an OPTIONAL relation defaults to SET NULL, so
  /// leaving it off would have made the migration drop and re-add this
  /// foreign key — and a SET NULL on a user delete would then trip the XOR
  /// check instead of the RESTRICT removeTeamMember explains to the owner.
  employeeUserId String?
  employeeUser   User?   @relation(fields: [employeeUserId], references: [id], onDelete: Restrict)

  /// The crew member dispatched, when the worker has no login. RESTRICT for
  /// the reason TimeEntry.crewMemberId gives: crew members archive, they
  /// never delete, and a referral on file must not lose the person it names.
  crewMemberId String?
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Restrict)

  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  dispatchNumber String?
  dispatchDate   DateTime

  fileUrl  String?
  fileName String?
  note     String?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([employeeUserId])
  @@index([crewMemberId])
  @@index([craftClassificationId])
}

/// The government wage-determination document for a job's jurisdiction
/// (e.g. a SAM.gov federal determination, or a state DOL prevailing-wage
/// schedule) — attached storage, not a live lookup. There's no licensed
/// or scraped prevailing-wage dataset in this app to look one up
/// automatically from, same reason NV licensing data was left unseeded
/// in LicenseClassificationReference. sourceUrl covers the common case of
/// linking to the determination on the issuing agency's site instead of
/// uploading a copy.
model PrevailingWageDetermination {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  jurisdiction String

  /// The rules in force where this job is, if the company has recorded
  /// them. Nullable and additive: every determination that exists today
  /// predates rule sets, and a determination is perfectly useful without
  /// one — it is the wage document either way. See prevailing-wage.prisma.
  ruleSetId String?
  ruleSet   PrevailingWageRuleSet? @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)

  fileUrl   String?
  fileName  String?
  sourceUrl String?
  note      String?

  /// What the determination DOCUMENT says about itself, ENTERED off the
  /// document by a person. All nullable and additive: every row that
  /// existed before these columns has none of them and is reported as
  /// "unchecked" rather than judged. Nothing here is a wage rate — there is
  /// no rate column and none is planned; the rate is read off the linked
  /// document by a person.
  ///
  /// The document's own number, e.g. "SC-023-31-2, issue 2026-1".
  determinationRef String?
  /// The issue date printed on the determination. DIR issues general
  /// determinations twice a year (22 Feb / 22 Aug) and each takes effect
  /// ten days later; the standing line derives the effective window from
  /// this date rather than storing it (lib/determination-standing.ts).
  issuedOn         DateTime?
  /// The expiration date printed on the determination.
  expiresOn        DateTime?
  /// The mark after that expiration date: SINGLE (holds for the life of
  /// the project) or DOUBLE (a predetermined increase applies to work after
  /// `expiresOn`). NONE = the document carries no mark. Null = not recorded,
  /// which the standing line reports as unchecked rather than guessing.
  expirationMarker DeterminationExpirationMarker?

  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([jobId])
}

/// The asterisk a DIR general prevailing wage determination prints after
/// its expiration date. What each one means is a published DIR rule, quoted
/// in lib/determination-standing.ts with its source.
enum DeterminationExpirationMarker {
  NONE
  SINGLE
  DOUBLE
}

/// A global reference table (not scoped to a Company) — the same union
/// local applies to every company that works under it. Deliberately NOT
/// seeded: no verified source for real local numbers/jurisdictions, and a
/// wrong entry here would misattribute a company's CBA to the wrong local.
/// COMPANY-SCOPED as of #136 finding 1. Until 2026-09-08 this table (and
/// CraftClassification, FringeRateSchedule, ApprenticeRatioRule below) had
/// no companyId at all: the only access check was holding a
/// CompanyUnionAgreement with the local, and that agreement was
/// self-asserted -- createUnionLocalAndAgreement adopted any existing local
/// by (parentInternational, localNumber), both public information. Anyone
/// who signed up and typed a real local's name/number got an agreement with
/// it for free, and from there: read access to another company's craft
/// wage rates, a cross-company row count (fixed separately in #169), and a
/// destructive delete on shared ApprenticeRatioRule/FringeRateSchedule rows
/// with no usage check.
///
/// A read-only production audit (`scripts/union-tenancy-audit.mjs`, run
/// 2026-09-07) settled the question a scoped fix depends on: whether any
/// real local was already shared by two companies, which would make a
/// per-company backfill ambiguous. It was not -- `ep-little-sea` held
/// exactly one local, one agreement, one company, zero crafts, zero
/// schedules. The backfill below is therefore single-valued by
/// construction, not by luck, and NOT NULL is safe because every local had
/// an owning agreement (0 orphans).
///
/// Each company now records its OWN local rather than sharing one global
/// row. Two companies signatory to the real Carpenters Local 300 get two
/// separate UnionLocal rows -- duplicated data about the same real-world
/// local, exactly like two companies each holding their own Contact row for
/// the same real GC. That duplication is the fix, not a side effect of it:
/// the old "adopt the existing global row" behavior IS the vulnerability.
model UnionLocal {
  id                  String   @id @default(cuid())
  companyId           String
  company             Company  @relation(fields: [companyId], references: [id])
  parentInternational String // "United Brotherhood of Carpenters", "OPCMIA", "IUPAT", "LIUNA"
  localNumber         String
  jurisdictionName    String
  tradeJurisdiction   String?
  createdAt           DateTime @default(now())

  craftClassifications      CraftClassification[]
  apprenticeRatioRules      ApprenticeRatioRule[]
  companyAgreements         CompanyUnionAgreement[]
  apprenticeshipEnrollments ApprenticeshipEnrollment[]

  @@unique([companyId, parentInternational, localNumber])
  @@index([companyId])
}

/// One CBA between a Company and a UnionLocal. `complianceDocument` links
/// to the actual agreement document (type UNION_AGREEMENT) if one's been
/// uploaded — reuses the existing document-tracking table rather than a
/// separate file reference.
model CompanyUnionAgreement {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  unionLocalId String
  unionLocal   UnionLocal @relation(fields: [unionLocalId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  complianceDocumentId String?
  complianceDocument   ComplianceDocument? @relation(fields: [complianceDocumentId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([unionLocalId])
}

/// Craft classifications and their progression aren't standardized across
/// locals (journeyman, apprentice period 1-5, foreman — the exact steps
/// vary), so this is tied to a specific UnionLocal rather than a shared
/// list.
/// Whether a classification is journeyman-side or apprentice-side.
///
/// Needed because an apprentice-to-journeyman ratio cannot be checked
/// against a list of names: "Drywall Finisher Apprentice Period 3" is only
/// an apprentice to a human reader, and deriving the tier by looking for
/// the word "apprentice" in a free-text name would be a guess that fails
/// silently on the first local that words it differently.
///
/// FOREMAN counts on the journeyman side of a ratio — a foreman is a
/// journeyman-level worker by definition — which is stated here because it
/// is a judgement, not an obvious fact.
enum CraftTier {
  JOURNEYMAN
  APPRENTICE
  FOREMAN
}

/// COMPANY-SCOPED as of #136 finding 1 -- see the comment on UnionLocal
/// above for why. companyId here is redundant with unionLocal.companyId in
/// principle, but every other table in this app is checked directly against
/// its own companyId rather than through a join chain (the #136 audit
/// called this out as the pattern that keeps IDOR out of this codebase), so
/// this carries its own column rather than being the one exception.
model CraftClassification {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  unionLocalId String
  unionLocal   UnionLocal @relation(fields: [unionLocalId], references: [id])
  name         String

  /// Nullable with NO backfill. Existing rows predate this, and inferring
  /// a tier from the name string would be exactly the guess this column
  /// exists to replace. Hours logged against an unclassified craft are
  /// reported as unclassified by the ratio check — never counted as
  /// journeyman hours, which would make a job look compliant because
  /// nobody had finished setting it up.
  tier CraftTier?

  /// 1-5 for an apprentice, null otherwise. Only meaningful when `tier` is
  /// APPRENTICE; the period drives the wage step, which FringeRateSchedule
  /// already carries per classification, so this is here to identify the
  /// step rather than to price it.
  apprenticePeriod Int?

  createdAt DateTime @default(now())

  fringeRateSchedules       FringeRateSchedule[]
  jobLineItems              JobLineItem[]
  catalogEntries            LineItemCatalogEntry[]
  wallTypeComponents        WallTypeComponent[]
  timeEntries               TimeEntry[]
  dispatchSlips             DispatchSlip[]
  apprenticeshipEnrollments ApprenticeshipEnrollment[]
  crewScheduleDays          CrewScheduleDay[]
  workerCrafts              WorkerCraft[]

  @@unique([unionLocalId, name])
  @@index([unionLocalId])
  @@index([companyId])
}

/// Which crafts a person can be logged under — "Tino works as a Journeyman
/// Carpenter". It drives one thing: the phone's craft picker shows a worker
/// only their own crafts, so a foreman is not choosing from every craft the
/// company has (teardown D-12, filtered by the worker, kept deliberately
/// simple). A worker with no rows here is shown every craft rather than
/// none, so a company that has not set this up is never blocked.
///
/// It is NOT a certification record and proves nothing to an agency —
/// WorkerCertification is the safety-card table, and this is separate from
/// it on purpose. Nor is it enforced when an hour is saved: the phone's
/// offline queue stops at the first refused write, so a server-side refusal
/// would strand every entry queued behind it. What a filing reads is the
/// craft on the TimeEntry itself.
///
/// A person is a login (userId) OR a crew member (crewMemberId), never both
/// and never neither — the same XOR as TimeEntry, CHECKed in the migration.
/// Cascades from every parent: a row means nothing once its craft or its
/// person is gone, and nothing reads it historically.
model WorkerCraft {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  craftClassificationId String
  craftClassification   CraftClassification @relation(fields: [craftClassificationId], references: [id], onDelete: Cascade)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  crewMemberId String?
  crewMember   CrewMember? @relation(fields: [crewMemberId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([craftClassificationId, userId])
  @@unique([craftClassificationId, crewMemberId])
  @@index([companyId])
  @@index([userId])
  @@index([crewMemberId])
}

/// Effective-dated, not a flat current-rate field: CBA rates typically
/// change annually, and job costing or certified payroll on an older job
/// needs the rate that was in effect AT THE TIME, not today's rate. A flat
/// rate field would quietly corrupt historical job costing the first time
/// a rate changed mid-project. `effectiveTo` null means currently in
/// effect. Non-overlapping ranges per craft classification are enforced
/// at the database level below (an EXCLUDE constraint — see the migration
/// SQL; Prisma's schema language has no declarative way to express this,
/// so it's hand-written raw SQL in the migration rather than generated
/// from this model).
/// COMPANY-SCOPED as of #136 finding 1 -- see UnionLocal above.
model FringeRateSchedule {
  id                    String              @id @default(cuid())
  companyId             String
  company               Company             @relation(fields: [companyId], references: [id])
  craftClassificationId String
  craftClassification   CraftClassification @relation(fields: [craftClassificationId], references: [id])

  baseWage          Decimal  @db.Decimal(12, 2)
  pensionRate       Decimal? @db.Decimal(12, 2)
  vacationRate      Decimal? @db.Decimal(12, 2)
  healthWelfareRate Decimal? @db.Decimal(12, 2)
  trainingRate      Decimal? @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([craftClassificationId])
  @@index([effectiveFrom])
  @@index([companyId])
}

/// Captures the ratio rule itself (e.g. 1 apprentice per 3 journeymen).
///
/// This comment used to say the daily compliance check could not be built
/// because there was no labor/time-entry data model. TimeEntry landed, and
/// CraftClassification.tier above supplies the other missing half, so the
/// check now exists: lib/apprentice-ratio.ts measures it per job per day
/// against these counts. Nothing is stored — a day's compliance is derived
/// from the hours logged for it, every time it is read.
/// COMPANY-SCOPED as of #136 finding 1 -- see UnionLocal above. This is the
/// table the issue named directly: setApprenticeRatioRule's
/// deleteMany({ where: { unionLocalId } }) used to wipe another company's
/// rule for a shared local with no ownership check at all. Once unionLocalId
/// itself resolves to one company, that deleteMany can no longer reach
/// anyone else's row -- the company column here makes that true by
/// construction rather than by remembering to check it at every call site.
model ApprenticeRatioRule {
  id                       String     @id @default(cuid())
  companyId                String
  company                  Company    @relation(fields: [companyId], references: [id])
  unionLocalId             String
  unionLocal               UnionLocal @relation(fields: [unionLocalId], references: [id])
  apprenticeCount          Int
  journeymenCount          Int
  programStandardReference String?
  createdAt                DateTime   @default(now())

  @@index([unionLocalId])
  @@index([companyId])
}

/// A foreman's signature on one job's hours for one day, and the office's
/// approval of it — the step that turns typed hours into a payroll record.
///
/// THE DAY'S STATE IS DERIVED, NEVER STORED (CLAUDE.md: derived state is never
/// stored). The newest sign-off for (jobId, date) with `reopenedAt` NULL is the
/// live one: no live sign-off = OPEN; live and `approvedAt` NULL = SUBMITTED;
/// live and approved = APPROVED. There is no status column to disagree with
/// the timestamps.
///
/// APPEND-ONLY. Reopening does not delete or un-sign anything: it stamps
/// `reopenedAt` on the row, which leaves it in the history, and the next
/// signature is a NEW row. A partial unique index in the migration allows only
/// one live (un-reopened) sign-off per job per day. A BEFORE UPDATE trigger,
/// `prova_timesheet_signoff_lock`, refuses any change to what was signed and
/// lets `approvedAt` and `reopenedAt` be set once each.
///
/// WHILE A DAY HAS A LIVE SIGN-OFF, ITS HOURS ARE LOCKED. The trigger
/// `prova_time_entry_day_lock` on TimeEntry refuses an INSERT, UPDATE or
/// DELETE of an entry on a signed day. The API and the actions check first so
/// that people see a sentence; the trigger is the rule. Cleanup scripts delete
/// sign-offs BEFORE time entries for exactly that reason.
model TimesheetSignoff {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// The day signed for. UTC midnight, the same as TimeEntry.date.
  date DateTime

  /// The printed name under the signature.
  signerName     String
  /// The drawn signature: an SVG path in exactly one shape, `M<x> <y>` and
  /// `L<x> <y>` in whole pixels on a 320x160 box. The server refuses anything
  /// else, so a signature can never carry markup into a page that draws it.
  signaturePath  String
  signedByUserId String?
  signedByUser   User?    @relation("TimesheetSignoffSignedBy", fields: [signedByUserId], references: [id])
  signedAt       DateTime

  /// What the signature covered, counted at signing: the number of entries
  /// and their total hours. Nothing can change under a live sign-off, so
  /// these can only disagree with the entries after a reopen — which is
  /// exactly when you want to know what was signed originally.
  entryCount Int
  totalHours Decimal @db.Decimal(7, 2)

  /// The day's crew by craft at signing, from its TimeEntry rows:
  /// `{ headcount, hours, byCraft: [{ craft, headcount, hours }] }`.
  manpower       Json?
  /// The daily report and its delays as they stood at signing — work
  /// performed, weather, other trades, and each DelayEvent. Null when no
  /// report had been filed. Nothing can change under a live sign-off, so
  /// this only differs from the live rows after a reopen, which is exactly
  /// when you want to know what was signed.
  reportSnapshot Json?

  approvedAt       DateTime?
  approvedByUserId String?
  approvedByUser   User?     @relation("TimesheetSignoffApprovedBy", fields: [approvedByUserId], references: [id])

  reopenedAt       DateTime?
  reopenedByUserId String?
  reopenedByUser   User?     @relation("TimesheetSignoffReopenedBy", fields: [reopenedByUserId], references: [id])
  reopenReason     String?

  /// Idempotency key from the phone, so a retried offline POST replays
  /// instead of signing twice.
  clientOperationId String?

  createdAt DateTime @default(now())

  @@unique([companyId, clientOperationId])
  @@index([companyId])
  @@index([jobId, date])
  @@index([signedByUserId])
  @@index([approvedByUserId])
  @@index([reopenedByUserId])
}

enum DelayCause {
  WEATHER
  GC_SCHEDULE
  OTHER_TRADE
  MATERIAL
  INSPECTION
  DESIGN_RFI
  SITE_ACCESS
  EQUIPMENT
  OTHER
}

enum DelayResponsibleParty {
  GC
  OWNER
  OTHER_TRADE
  SUPPLIER
  OURSELVES
  NOBODY
}

enum NotificationMethod {
  PHONE
  EMAIL
  TEXT
  IN_PERSON
  MEETING
  OTHER
}

/// One thing that cost the crew time on one job on one day — the record a
/// delay claim or a change order is argued from months later.
///
/// Replaces the free-text DailyFieldReport.delays. Keyed on (jobId, date)
/// rather than on a report, so a delay can be logged before the day's report
/// exists, and it is locked by the same day sign-off as the hours and the
/// report (`prova_delay_event_day_lock`). The one change that trigger lets
/// through on a signed day is `changeOrderId`: drafting a change order from a
/// delay is exactly what the office does after the day is signed.
model DelayEvent {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// The day it happened. UTC midnight, like every date that matters.
  date DateTime

  cause            DelayCause
  responsibleParty DelayResponsibleParty
  /// "Acme Electric", "the GC's super" — who, in words, when the category
  /// is not enough.
  responsibleName  String?

  /// Minutes after midnight, site time. Optional: a delay is often known
  /// only as "most of the morning".
  startMinute Int?
  endMinute   Int?

  workersAffected Int?
  /// Crew-hours lost. Entered, or worked out from workers x (end - start)
  /// when those are given and this is left blank.
  hoursLost       Decimal? @db.Decimal(7, 2)

  description String

  /// Whether, how, when and to whom the GC was told. Null method = not yet.
  gcNotifiedHow NotificationMethod?
  gcNotifiedWho String?
  gcNotifiedAt  DateTime?

  /// The change order drafted from this delay, if one was.
  changeOrderId String?
  changeOrder   ChangeOrder? @relation(fields: [changeOrderId], references: [id], onDelete: SetNull)

  loggedByUserId String?
  loggedBy       User?   @relation("DelayEventLoggedBy", fields: [loggedByUserId], references: [id])

  /// Idempotency key from the phone.
  clientOperationId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, clientOperationId])
  @@index([companyId])
  @@index([jobId, date])
  @@index([changeOrderId])
  @@index([loggedByUserId])
}
