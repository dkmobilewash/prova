// Labor, time and union compliance: time entry, dispatch, prevailing wage,
// fringe rates. Diego's lane.
//
// Part of the multi-file Prisma schema in this folder.

enum TimeEntryPayType {
  STRAIGHT
  OVERTIME
  DOUBLE_TIME
  SHIFT_DIFFERENTIAL
}

/// A single day's hours worked by one employee on one job — the field
/// time-tracking record job costing and (eventually) certified payroll
/// both need. Optionally tied to a specific JobLineItem (cost code/SOV
/// line) and CraftClassification, since not every entry is craft-specific
/// (e.g. a foreman's supervision time) but most union labor entries are.
/// payType tracks straight/overtime/double-time/shift-differential hours
/// as separate rows rather than one row with a rate multiplier, so a
/// worker's mixed day (6 straight + 2 OT) is two clean rows instead of one
/// row needing a blended-rate calculation. This tracks hours by category
/// only — it does not compute dollar cost; that needs a wage-rate engine
/// over FringeRateSchedule, a separate future step (same boundary
/// JobLineItem.laborHours already draws on the estimating side).
model TimeEntry {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  lineItemId String?
  lineItem   JobLineItem? @relation(fields: [lineItemId], references: [id])

  employeeUserId String
  employeeUser   User   @relation(fields: [employeeUserId], references: [id])

  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  date    DateTime
  hours   Decimal          @db.Decimal(5, 2)
  payType TimeEntryPayType @default(STRAIGHT)

  /// Flat daily allowances, independent of hours/payType — a per diem or
  /// travel day is still one row on this date for this employee/job, not
  /// a second entry. Both null for a normal local day with no allowance.
  perDiemAmount   Decimal? @db.Decimal(10, 2)
  travelPayAmount Decimal? @db.Decimal(10, 2)

  note String?

  createdAt DateTime @default(now())

  corrections TimeEntryCorrection[]

  @@index([jobId])
  @@index([lineItemId])
  @@index([employeeUserId])
  @@index([craftClassificationId])
}

/// One correction to a logged TimeEntry, holding the row exactly as it
/// stood BEFORE the change.
///
/// These are certified payroll hours: the record produced when somebody
/// asks what a person was paid and for what. Until this existed the only
/// way to fix a wrong figure was to DELETE the row and type a new one, so
/// nothing showed that a correction had been made, when, or by whom — and
/// a foreman's honest 10-becomes-8 was indistinguishable from a number
/// being quietly rewritten. CLAUDE.md's rule that evidence records lock
/// their identity fields and that sent correspondence can close but never
/// delete had simply never been applied here.
///
/// Same shape as SubmittalRevision: the original stays, and each amendment
/// is its own row. The identity of the entry — its job, its employee, its
/// DATE — is locked by `updateTimeEntry` and cannot be corrected at all; a
/// wrong day is a different day's work, which is a new entry and a deleted
/// one, not an edit.
///
/// Every "previous" column is a SNAPSHOT and deliberately carries no
/// foreign key. A craft classification that is later renamed, or a line
/// item that is later removed, must not silently rewrite what this row says
/// was there at the time — that is the difference between a record and a
/// view. Labels are stored as text for the same reason.
model TimeEntryCorrection {
  id          String    @id @default(cuid())
  timeEntryId String
  timeEntry   TimeEntry @relation(fields: [timeEntryId], references: [id], onDelete: Cascade)

  /// Who corrected it, and when the correction was RECORDED. Stamped, not
  /// entered — unlike TimeEntry.date, this is not a fact about the work,
  /// it is the audit fact of somebody changing the record, and only the
  /// system can know it. The name is free text for the same reason
  /// ApprenticeshipPeriod.signedOffBy is: it must keep saying what it said
  /// even if the account is later renamed or removed.
  correctedByUserId String
  correctedByName   String
  correctedAt       DateTime @default(now())

  /// Why the figure changed. REQUIRED: a correction with no stated reason
  /// is a silent replacement wearing a timestamp, which is the thing this
  /// table exists to stop.
  reason String

  previousHours   Decimal          @db.Decimal(5, 2)
  previousPayType TimeEntryPayType

  previousCraftLabel    String?
  previousLineItemLabel String?

  previousPerDiemAmount   Decimal? @db.Decimal(10, 2)
  previousTravelPayAmount Decimal? @db.Decimal(10, 2)
  previousNote            String?

  @@index([timeEntryId])
}

/// A union hiring hall's dispatch of one worker to one job — the referral
/// record that authorizes them to work under that local's agreement on
/// this job, distinct from TimeEntry (which logs hours actually worked
/// afterward). The physical dispatch slip is often a paper form the hall
/// hands the worker; fileUrl/fileName are optional since some halls
/// dispatch by phone with just a referral number, no scanned document.
model DispatchSlip {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  employeeUserId String
  employeeUser   User   @relation(fields: [employeeUserId], references: [id])

  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id])

  dispatchNumber String?
  dispatchDate   DateTime

  fileUrl  String?
  fileName String?
  note     String?

  createdAt DateTime @default(now())

  @@index([jobId])
  @@index([employeeUserId])
  @@index([craftClassificationId])
}

/// The government wage-determination document for a job's jurisdiction
/// (e.g. a SAM.gov federal determination, or a state DOL prevailing-wage
/// schedule) — attached storage, not a live lookup. There's no licensed
/// or scraped prevailing-wage dataset in this app to look one up
/// automatically from, same reason NV licensing data was left unseeded
/// in LicenseClassificationReference. sourceUrl covers the common case of
/// linking to the determination on the issuing agency's site instead of
/// uploading a copy.
model PrevailingWageDetermination {
  id    String @id @default(cuid())
  jobId String
  job   Job    @relation(fields: [jobId], references: [id])

  jurisdiction String

  /// The rules in force where this job is, if the company has recorded
  /// them. Nullable and additive: every determination that exists today
  /// predates rule sets, and a determination is perfectly useful without
  /// one — it is the wage document either way. See prevailing-wage.prisma.
  ruleSetId String?
  ruleSet   PrevailingWageRuleSet? @relation(fields: [ruleSetId], references: [id], onDelete: SetNull)

  fileUrl   String?
  fileName  String?
  sourceUrl String?
  note      String?

  uploadedByUserId String?
  uploadedByUser   User?    @relation(fields: [uploadedByUserId], references: [id])
  createdAt        DateTime @default(now())

  @@index([jobId])
}

/// A global reference table (not scoped to a Company) — the same union
/// local applies to every company that works under it. Deliberately NOT
/// seeded: no verified source for real local numbers/jurisdictions, and a
/// wrong entry here would misattribute a company's CBA to the wrong local.
model UnionLocal {
  id                  String   @id @default(cuid())
  parentInternational String // "United Brotherhood of Carpenters", "OPCMIA", "IUPAT", "LIUNA"
  localNumber         String
  jurisdictionName    String
  tradeJurisdiction   String?
  createdAt           DateTime @default(now())

  craftClassifications CraftClassification[]
  apprenticeRatioRules ApprenticeRatioRule[]
  companyAgreements    CompanyUnionAgreement[]

  @@unique([parentInternational, localNumber])
  apprenticeshipEnrollments ApprenticeshipEnrollment[]
}

/// One CBA between a Company and a UnionLocal. `complianceDocument` links
/// to the actual agreement document (type UNION_AGREEMENT) if one's been
/// uploaded — reuses the existing document-tracking table rather than a
/// separate file reference.
model CompanyUnionAgreement {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  unionLocalId String
  unionLocal   UnionLocal @relation(fields: [unionLocalId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  complianceDocumentId String?
  complianceDocument   ComplianceDocument? @relation(fields: [complianceDocumentId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([unionLocalId])
}

/// Craft classifications and their progression aren't standardized across
/// locals (journeyman, apprentice period 1-5, foreman — the exact steps
/// vary), so this is tied to a specific UnionLocal rather than a shared
/// list.
/// Whether a classification is journeyman-side or apprentice-side.
///
/// Needed because an apprentice-to-journeyman ratio cannot be checked
/// against a list of names: "Drywall Finisher Apprentice Period 3" is only
/// an apprentice to a human reader, and deriving the tier by looking for
/// the word "apprentice" in a free-text name would be a guess that fails
/// silently on the first local that words it differently.
///
/// FOREMAN counts on the journeyman side of a ratio — a foreman is a
/// journeyman-level worker by definition — which is stated here because it
/// is a judgement, not an obvious fact.
enum CraftTier {
  JOURNEYMAN
  APPRENTICE
  FOREMAN
}

model CraftClassification {
  id           String     @id @default(cuid())
  unionLocalId String
  unionLocal   UnionLocal @relation(fields: [unionLocalId], references: [id])
  name         String

  /// Nullable with NO backfill. Existing rows predate this, and inferring
  /// a tier from the name string would be exactly the guess this column
  /// exists to replace. Hours logged against an unclassified craft are
  /// reported as unclassified by the ratio check — never counted as
  /// journeyman hours, which would make a job look compliant because
  /// nobody had finished setting it up.
  tier CraftTier?

  /// 1-5 for an apprentice, null otherwise. Only meaningful when `tier` is
  /// APPRENTICE; the period drives the wage step, which FringeRateSchedule
  /// already carries per classification, so this is here to identify the
  /// step rather than to price it.
  apprenticePeriod Int?

  createdAt    DateTime   @default(now())

  fringeRateSchedules FringeRateSchedule[]
  jobLineItems        JobLineItem[]
  catalogEntries      LineItemCatalogEntry[]
  timeEntries         TimeEntry[]
  dispatchSlips       DispatchSlip[]

  @@unique([unionLocalId, name])
  @@index([unionLocalId])
  apprenticeshipEnrollments ApprenticeshipEnrollment[]
}

/// Effective-dated, not a flat current-rate field: CBA rates typically
/// change annually, and job costing or certified payroll on an older job
/// needs the rate that was in effect AT THE TIME, not today's rate. A flat
/// rate field would quietly corrupt historical job costing the first time
/// a rate changed mid-project. `effectiveTo` null means currently in
/// effect. Non-overlapping ranges per craft classification are enforced
/// at the database level below (an EXCLUDE constraint — see the migration
/// SQL; Prisma's schema language has no declarative way to express this,
/// so it's hand-written raw SQL in the migration rather than generated
/// from this model).
model FringeRateSchedule {
  id                    String              @id @default(cuid())
  craftClassificationId String
  craftClassification   CraftClassification @relation(fields: [craftClassificationId], references: [id])

  baseWage          Decimal  @db.Decimal(12, 2)
  pensionRate       Decimal? @db.Decimal(12, 2)
  vacationRate      Decimal? @db.Decimal(12, 2)
  healthWelfareRate Decimal? @db.Decimal(12, 2)
  trainingRate      Decimal? @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([craftClassificationId])
  @@index([effectiveFrom])
}

/// Captures the ratio rule itself (e.g. 1 apprentice per 3 journeymen).
///
/// This comment used to say the daily compliance check could not be built
/// because there was no labor/time-entry data model. TimeEntry landed, and
/// CraftClassification.tier above supplies the other missing half, so the
/// check now exists: lib/apprentice-ratio.ts measures it per job per day
/// against these counts. Nothing is stored — a day's compliance is derived
/// from the hours logged for it, every time it is read.
model ApprenticeRatioRule {
  id                       String     @id @default(cuid())
  unionLocalId             String
  unionLocal               UnionLocal @relation(fields: [unionLocalId], references: [id])
  apprenticeCount          Int
  journeymenCount          Int
  programStandardReference String?
  createdAt                DateTime   @default(now())

  @@index([unionLocalId])
}
