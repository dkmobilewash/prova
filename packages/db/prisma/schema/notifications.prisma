// Alerts: the one thing about them that can be stored.
//
// Part of the multi-file Prisma schema in this folder.
//
// There is no Alert table here and there is not going to be one. Every
// alert this app raises is DERIVED — a COI expiring is its expiresAt
// against today, a backcharge going unanswered is its respondByDate
// against its status, retainage coming due is withheld minus released
// against an accepted closeout package. Storing those would create a
// second copy of a fact that already exists, free to disagree with it,
// which is the rule ARCHITECTURE.md opens with and the reason
// lib/compliance-expiry.ts could be built with no migration at all.
//
// What is NOT derivable is a person deciding they have seen something.
// "The office manager has dealt with this and does not want to be told
// again until March" is a fact about a human, not about a COI, and no
// amount of reading the source rows produces it. That is this table, and
// that is all of it.

/// How bad the thing was AT THE MOMENT somebody said they had seen it.
///
/// The same three levels as AlertSeverity in apps/web/lib/alerts.ts, and
/// they must stay the same three: this column exists only to be compared
/// against that type's value for the same alert today.
enum AlertSeverity {
  OVERDUE
  DUE_SOON
  STANDING
}

/// One person saying "I have seen this one".
///
/// Per USER rather than per company, deliberately. Dismissing an alert on
/// a colleague's behalf is the worse failure of the two: the underlying
/// fix — renewing the licence, answering the backcharge — clears the
/// alert for everybody automatically, so a per-user acknowledgement can
/// only ever cause someone to see something twice, while a company-wide
/// one can cause the only person who would have acted to never see it.
model AlertAcknowledgement {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The alert's identity, which deliberately INCLUDES the fact that would
  /// change what it says — "LICENSE_EXPIRING:abc123:2026-11-30", not
  /// "LICENSE_EXPIRING:abc123". Renew that licence to 2027 and the key no
  /// longer matches, so the acknowledgement stops applying and the alert
  /// comes back when it next matters. That is the whole mechanism for
  /// keeping a dismissal from silencing a DIFFERENT situation later, and
  /// it needs no expiry logic of its own. See alertKey() in
  /// apps/web/lib/alerts.ts, which is the only thing allowed to build one.
  ///
  /// WHAT THE KEY CANNOT DO, and why the column below exists. The key is
  /// STABLE as a date approaches — a COI sixty days out and the same COI
  /// after it lapses are byte-identical keys. So an acknowledgement matched
  /// on the key ALONE silenced the alert through the day it went overdue,
  /// forever, and (because the notifier reads the un-silenced set) took the
  /// "week" and "due" emails with it. That is the same objection
  /// NotificationDispatch.dispatchKey already answers with its rung, on the
  /// other half of this story. Issue #110.
  alertKey String

  acknowledgedAt DateTime @default(now())

  /// How bad it was WHEN they said they had seen it.
  ///
  /// The acknowledgement covers that situation and anything no worse than
  /// it. A dismissal recorded while a licence was DUE_SOON stops applying
  /// the day it goes OVERDUE, because that is a different sentence about
  /// the same unchanged fact — which is exactly what the key cannot
  /// express. Compared in partitionAlerts(), the only reader.
  ///
  /// The key's shape is deliberately NOT touched by this. Every
  /// NotificationDispatch row stores a dispatchKey built from the alert
  /// key, so changing that shape would orphan the lot and the next run
  /// would re-send every notice already sent — the nag this whole feature
  /// exists to prevent.
  ///
  /// NULL is a row written before this column existed, and it is READ AS
  /// DUE_SOON, not as "matches anything". See ACK_SEVERITY_WHEN_UNRECORDED
  /// in apps/web/lib/alerts.ts for the argument.
  acknowledgedSeverity AlertSeverity?

  /// Null means dismissed — quiet until the underlying fact changes. A
  /// date means quiet until then, at UTC midnight like every other date
  /// here. Both are the same act; the difference is only how long the
  /// person wanted.
  snoozedUntil DateTime?

  @@unique([userId, alertKey])
  @@index([companyId])
  @@index([userId])
}

/// One notice we have already sent, so we never send it twice.
///
/// The other half of the alert story. `AlertAcknowledgement` records a
/// person deciding they have seen something; this records US having told
/// them. Both exist for the same reason: neither is derivable from the
/// records the alert is about.
///
/// **This table is what stops an alert becoming a nag.** A COI expiring in
/// thirty days is still true tomorrow, so a notifier that reads state and
/// sends would send the same sentence thirty mornings running, and the
/// person would learn to filter it. Nothing is sent for a state — it is
/// sent when a MILESTONE is crossed, and this is the record of which
/// milestones are spent.
model NotificationDispatch {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// The alert's own key plus the rung that fired:
  /// "RENEWAL:lic_1:2026-11-30@week".
  ///
  /// Both halves are load-bearing. The alert key carries the FACT, so
  /// renewing the licence changes the key and every dispatch recorded
  /// against the old date stops applying — the same mechanism that makes a
  /// dismissal lapse, with no expiry logic. The rung distinguishes "this is
  /// coming" from "this has happened" about one UNCHANGED fact, which the
  /// alert key alone cannot: it is stable as the date approaches, so keying
  /// a send on it by itself would send the sixty-day warning and then stay
  /// silent through the day the licence lapsed.
  ///
  /// What is deliberately NOT in here is the date it was sent. A key
  /// carrying today's date is a new key tomorrow, which is the whole
  /// failure this table exists to prevent.
  dispatchKey String

  /// The alert key on its own, and the rung on its own. Neither is read to
  /// decide anything — `dispatchKey` is the only thing matched on. They are
  /// here so that "why did this person get this email" is answerable with a
  /// query instead of by parsing a composite string.
  alertKey String
  rung     String

  /// The message this went out as, when it went out as one.
  ///
  /// MANY dispatches to ONE message, not one to one. A digest is
  /// deliberately a single email covering everything a person has not been
  /// told — three separate emails about three licences is the nagging this
  /// feature exists to avoid, arriving faster. A unique constraint here
  /// would make the second notice in any digest fail to link.
  ///
  /// Nullable because the row is written BEFORE the provider is called, so
  /// a dispatch whose send then failed keeps its claim and has no message.
  /// That is the state a person needs to see, and deleting the row to tidy
  /// it up would re-arm the send.
  messageId String?
  message   OutboundMessage? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  sentAt DateTime @default(now())

  /// The lock, and the reason this is safe to run twice.
  ///
  /// The row is claimed BEFORE the provider call, so a crash between
  /// sending and recording cannot resend tomorrow. The cost is that a
  /// failed send does not retry itself — deliberate, and the same judgement
  /// `sendOutboundEmail` already makes about `mayHaveSent`: a second copy
  /// is worse than a late one. The failure is visible in the delivery log
  /// and a person decides.
  ///
  /// Per USER, not per company, for the reason above `AlertAcknowledgement`
  /// and more sharply. Alerts are capability-filtered, so two people
  /// legitimately have different lists; a company-wide ledger would let the
  /// first person's send suppress the second's — and the person suppressed
  /// is the one whose capability made it their job.
  @@unique([userId, dispatchKey])
  @@index([companyId])
  @@index([userId])
  @@index([alertKey])
  @@index([messageId])
}
