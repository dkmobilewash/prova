// Wall types and the per-job wall schedule. Diego's lane (estimating).
//
// Part of the multi-file Prisma schema in this folder.
//
// Why this exists: every takeoff tool on the market measures a wall's
// plan-view centerline and stops. The height and the TYPE of the wall are not
// on the floor plan — they are in the partition schedule and the sections —
// so "142 LF of wall" becomes studs, track, board and insulation only after
// somebody joins it to a type and a height by hand. These three tables are
// that join: a company's partition schedule (WallType + WallTypeComponent),
// and each job's runs (WallRun), from which the estimate's lines are
// generated. Anything that later measures walls — on-screen tracing, an AI
// read of the plans — writes RUNS, never line items.

/// What quantity of a wall a component is counted against.
///
/// Every value is computed from the run and the type by
/// apps/web/lib/wall-assemblies.ts — nothing is stored per run.
enum WallComponentBasis {
  /// The run's length. Track is LINEAR_FT × 2 (top and bottom).
  LINEAR_FT
  /// Length × height of ONE face, openings deducted — insulation, sound batt.
  FACE_SQFT
  /// Face area × the type's boarded sides — board, tape, finish. Layers are
  /// the factor, so two layers of ⅝″ each side is BOARDED_SQFT × 2 — or, on a
  /// component marked `perLayer`, the factor for one layer × the type's
  /// `boardLayers`.
  BOARDED_SQFT
  /// Studs at the type's spacing, including the one closing the run.
  STUDS
  /// A fixed count per run — end studs at a corner, a head-of-wall detail.
  PER_RUN

  /// ── THE FOUR BELOW ARE NOT WALL-SHAPED ──
  ///
  /// Added 2026-10-16 with takeoff items, which measure ceilings, flooring,
  /// painting and slabs as well as partitions. A `WallRun` cannot produce any
  /// of them and reports zero, which is honest: a run of wall has no area of
  /// its own, only a face.
  ///
  /// THIS ENUM IS THE FORMULA LANGUAGE. A part's quantity is
  /// `basis × factor × (1 + waste)`, and every value names a tested function
  /// of the geometry — so a part cannot ask for a quantity nobody has defined
  /// and a formula cannot be misspelt. See
  /// `docs/TAKEOFF-WORKSPACE-DESIGN.md` §4 for why that beats a parsed
  /// string, and for what would change its mind.

  /// The traced area, cutouts deducted — ceilings, flooring, paint.
  AREA_SQFT
  /// The traced outline's perimeter — wall angle, base, edge trim.
  PERIMETER_FT
  /// How many things were counted — fixtures, doors.
  COUNT_EACH
  /// Area × depth ÷ 27 — slabs and footings.
  VOLUME_CY
}

/// One row of a company's partition schedule — "W2", as the architect's
/// drawings label it. Company-scoped reference data, like LineItemCatalogEntry.
model WallType {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// The tag as it appears on the drawings: "W2", "P-4A". Unique per company.
  code String
  name String

  /// Used for a run that gives no height of its own. Nullable on purpose: a
  /// type without a default and a run without a height produce NOTHING rather
  /// than a guessed 10 feet.
  defaultHeightFt Decimal? @db.Decimal(8, 2)
  /// Finish to finish, in inches — what a tape measure reads across the wall.
  ///
  /// THE ONE THING THAT CONNECTS A DRAWING TO A PRICE. The wall finder measures
  /// thickness off the sheet's own line work and knows nothing else about a
  /// wall; this library knows everything about a wall except how thick it is.
  /// Without this column a detected 4⅞″ group can only be priced when the
  /// architect happened to tag that particular run, which is 25-43% of the
  /// footage on a sheet — an architect tags representative walls, not every
  /// wall.
  ///
  /// NULLABLE, and it stays nullable. A company's own standing assemblies were
  /// typed in by a person who was never asked for a thickness, and backfilling
  /// one by inference from the components would be a guess that prices walls.
  /// Null means "this type cannot be matched by thickness", which is the honest
  /// state and is what the matcher reads it as.
  thicknessIn     Decimal? @db.Decimal(6, 2)
  /// 1 or 2 boarded sides. A demising wall is 2; furring against masonry is 1.
  sides           Int      @default(2)
  studSpacingIn   Decimal  @default(16) @db.Decimal(6, 2)
  /// Layers of board on EACH boarded side: 1 for an ordinary partition, 2 for
  /// most rated and shaft-adjacent walls. A drawing's partition schedule often
  /// names the board and leaves the count to a UL detail nobody attached, and
  /// the count doubles the board — so the sub has to say it.
  ///
  /// NULLABLE, AND NULL MEANS "NOT ANSWERED", not "one". With no answer every
  /// component prices exactly as its factor says, which is what every type did
  /// before this column existed — so an existing estimate does not move.
  ///
  /// It reaches a quantity ONLY through a component marked `perLayer` below:
  /// such a component's factor is for ONE layer, and the quantity is that ×
  /// this count. A component that is not marked is untouched by any answer,
  /// which is what keeps a type whose board factor already says "2" (a
  /// legend-made type writes the layer count INTO the factor) from being
  /// doubled again. A type with no `perLayer` component is never asked
  /// (`lib/bid/guide/boardLayers.ts`), because no answer would change anything.
  boardLayers     Int?
  notes           String?
  sortOrder       Int      @default(0)

  components WallTypeComponent[]
  runs       WallRun[]
  takeoffItems TakeoffItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([companyId, code])
  @@index([companyId])
}

/// One material or labor item in a wall type's assembly.
model WallTypeComponent {
  id         String   @id @default(cuid())
  wallTypeId String
  wallType   WallType @relation(fields: [wallTypeId], references: [id], onDelete: Cascade)

  description String
  unit        String?
  basis       WallComponentBasis
  /// Multiplier on the basis: 2 for top-and-bottom track, the layer count for
  /// board, 1/32 to turn square feet into 4x8 sheets.
  factor       Decimal @default(1) @db.Decimal(12, 4)
  wastePercent Decimal @default(0) @db.Decimal(5, 2)
  /// Round the total up to a whole unit — sheets and studs are bought whole.
  roundUp      Boolean @default(false)
  /// The factor is for ONE layer of board, and the quantity is multiplied by
  /// the wall type's `boardLayers` when that is answered. The board itself is;
  /// tape and finish are NOT — only the face layer is finished, so a finished
  /// square foot does not change with the count.
  ///
  /// Default false, no backfill: an existing component prices exactly as it
  /// did whatever is answered. Guessing "per layer" from the word "board" is
  /// the inference this column replaces (the same call `costCategory` makes).
  perLayer     Boolean @default(false)

  /// The kind of cost this component IS, carried onto the line the wall
  /// schedule derives from it (#513).
  ///
  /// A WALL TYPE IS THE ONE PLACE THIS IS KNOWABLE UP FRONT, which is why the
  /// column is here and not only on the catalog entry. Board, studs and track
  /// are material; the hang-and-finish component is labor. That is a property
  /// of the assembly, decided once when the wall type is built, and every run
  /// of W2 on every job inherits it.
  ///
  /// Takes precedence over the linked catalog entry's own category when both
  /// are set, for the same reason `craftClassificationId` does below: the
  /// component is the more specific statement. A component with none falls
  /// back to its catalog entry, and a line with neither reads as uncoded and is
  /// marked up at nothing — never at a default.
  ///
  /// Nullable, no backfill. Inferring "material" from the word "board" is the
  /// guess this column exists to replace.
  costCategory CostCategory?

  /// Where the line's price comes from when it is created. A template link,
  /// like JobLineItem.sourceCatalogEntryId: re-pricing the catalog never
  /// reaches back into a line already on an estimate.
  catalogEntryId String?
  catalogEntry   LineItemCatalogEntry? @relation(fields: [catalogEntryId], references: [id], onDelete: SetNull)

  /// Units per hour for this component's labor. Generated hours are
  /// quantity ÷ this rate; null means the component carries no labor.
  productionRate        Decimal?             @db.Decimal(10, 4)
  craftClassificationId String?
  craftClassification   CraftClassification? @relation(fields: [craftClassificationId], references: [id], onDelete: SetNull)

  sortOrder Int @default(0)

  /// Estimate lines generated from this component. SET NULL on delete, so
  /// removing a component leaves the line standing as an ordinary line.
  jobLineItems JobLineItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([wallTypeId])
}

/// One run of wall on a job: "Level 2 corridor, 142 LF, type W2, 10 ft".
/// The estimate's wall lines are generated from the runs, so this is the
/// record of what was measured — the thing a revision re-measures.
model WallRun {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])
  /// RESTRICT: a wall type with runs on any job cannot be deleted out from
  /// under the estimate that was built from it.
  wallTypeId String
  wallType   WallType @relation(fields: [wallTypeId], references: [id])

  label    String
  lengthFt Decimal  @db.Decimal(10, 2)
  /// Null means "the type's default height".
  heightFt Decimal? @db.Decimal(8, 2)
  /// [{ widthFt, heightFt }] — deducted per lib/takeoff.ts's threshold rule.
  openings  Json @default("[]")
  sortOrder Int  @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The traced measurements this run was posted from, if any. Deleting the
  /// run releases them rather than deleting them — see `TakeoffMeasurement`.
  measurements TakeoffMeasurement[]

  @@index([companyId])
  @@index([jobId])
  @@index([wallTypeId])
}
