/// Site capture — the photos (and later video) a crew takes on a job.
///
/// ONE TABLE, HUNG OFF `Job`. The same call `ComplianceDocument` makes for
/// its four document types, for the same reason: a photo of a cracked
/// header, a photo proving a punch item was fixed and a photo attached to
/// a safety incident are the same shape of record — a file, a job, a
/// person, a time — differing only in what they are later attached to.
/// Four near-identical tables would each need their own upload path, their
/// own gallery and their own delete guard.
///
/// `jobId` IS REQUIRED, and that is the design. Every other thing this
/// feature will eventually attach to — a punch item, a safety incident, a
/// daily report — already belongs to exactly one job, so the job is the
/// spine and never has to be inferred. It also means the GC question this
/// feature exists to answer ("show me everything from the west wall in
/// August") is one indexed query, not a union across attachment types.
///
/// DELIBERATELY NO ATTACHMENT COLUMNS YET. The obvious next move is a
/// nullable `punchListItemId`, `safetyIncidentId`, `dailyFieldReportId`
/// and so on. Each one arrives with the code that writes and reads it, not
/// before: this repo has a standing scar from columns that were added,
/// documented and never selected by anything (`acknowledgedSeverity`), and
/// a nullable FK nothing populates looks identical to one whose feature is
/// broken.
///
/// NOT AN EVIDENCE RECORD IN THE `Submittal`/`Rfi` SENSE — no counter, no
/// sequence number, no send-then-lock lifecycle. A photo is not
/// correspondence and nobody transmits "photo 14" to a GC. What it does
/// borrow from that family is the locked identity: see `capturedAt` below.
model JobMedia {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])
  jobId     String
  job       Job     @relation(fields: [jobId], references: [id])

  /// Where the file actually lives, and the URL that is rendered. Vercel
  /// Blob, `access: "public"` with a random suffix — unguessable rather
  /// than private, matching every other upload in this app. See
  /// apps/web/lib/blob.ts for why that distinction is written down
  /// everywhere it applies.
  blobUrl String

  /// The store's own path for this blob, which is NOT derivable from the
  /// URL's visible parts once a random suffix is applied. Kept because
  /// deleting the row has to delete the file too — without this, a deleted
  /// photo stays readable forever at a link somebody may already hold.
  blobPathname String

  /// What the browser said it uploaded, and how big it was. `contentType`
  /// is what decides whether this renders as an image or a video: the kind
  /// is DERIVED from it at read time rather than stored beside it, so the
  /// two can never disagree. Same rule as every other computed value here.
  contentType String
  byteSize    Int

  /// What the person typed about the photo. Optional — a photo with no
  /// caption is still worth having, and demanding one gets you "photo".
  caption String?

  /// When the picture was taken, per the DEVICE. Entered rather than
  /// stamped, the same rule the field reports and submittals follow: a
  /// crew uploading Friday's photos on Monday must not have them recorded
  /// as Monday's.
  ///
  /// A full timestamp, NOT the UTC-midnight date this schema uses
  /// elsewhere, and the deviation is deliberate — on a jobsite the hour
  /// matters ("before the pour", "after the inspector left") and rounding
  /// it to a calendar day throws away the ordering within a day, which is
  /// most of what a walkthrough is.
  capturedAt DateTime

  /// When the server received it. Kept ALONGSIDE `capturedAt` rather than
  /// instead of it because a device clock is set by its owner and is
  /// routinely wrong — a phone fresh off a charger in a trailer with no
  /// signal can be days out. When the two disagree materially the UI can
  /// say so; with only one of them stored, it could not.
  createdAt DateTime @default(now())

  capturedByUserId String?
  capturedBy       User?   @relation(fields: [capturedByUserId], references: [id])

  @@index([companyId])
  /// The gallery's own query: one job, newest first.
  @@index([jobId, capturedAt])
}
