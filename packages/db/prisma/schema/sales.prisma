// Prova's own internal sales CRM -- for selling Prova itself, not a
// tenant's own GC/customer relationships (that's Contact/ContactPerson/
// ContactInteraction, in company.prisma and crm.prisma). Scoped to
// Company like every other model, but only ever populated on the one
// Company with isProvaOperator set -- see the field's comment on
// company.prisma. New domain, new file, same reasoning as crm.prisma.

enum SalesLeadSource {
  REFERRAL
  OUTBOUND
  INBOUND
  EVENT
  OTHER
}

enum OpportunityStage {
  NEW
  CONTACTED
  DEMO_SCHEDULED
  TRIAL
  WON
  LOST
}

/// A prospective PROVA customer -- a construction subcontractor who might
/// sign up. Not a second Contact: a Contact is a tenant's own GC/developer/
/// vendor, and every tenant has their own; a SalesLead belongs only to
/// Prova's operating company.
model SalesLead {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  companyName String
  contactName String?
  email       String?
  phone       String?
  source      SalesLeadSource?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  opportunities SalesOpportunity[]
  activities    SalesActivity[]

  @@index([companyId])
}

/// One deal in progress with a SalesLead. A lead can have more than one
/// opportunity over time (a lost deal revisited, a second product) -- this
/// is the thing that moves through the pipeline, not the lead itself.
model SalesOpportunity {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  leadId    String
  lead      SalesLead @relation(fields: [leadId], references: [id])

  stage             OpportunityStage @default(NEW)
  /// Estimated monthly recurring revenue if won. Null until there's a
  /// number worth naming -- not defaulted to 0, which would read as "worth
  /// nothing" rather than "not yet estimated."
  estimatedMrr      Decimal?         @db.Decimal(10, 2)
  expectedCloseDate DateTime?
  notes             String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  activities   SalesActivity[]
  stageChanges SalesStageChange[]

  @@index([companyId])
  @@index([leadId])
}

enum SalesActivityType {
  CALL
  EMAIL
  DEMO
  MEETING
  NOTE
}

/// A logged touchpoint with a SalesLead -- the memory of the relationship.
/// Before this existed, the whole of it was SalesOpportunity.notes: one
/// mutable free-text field that the next edit overwrote.
///
/// Modelled on ContactInteraction (crm.prisma), with three deliberate
/// differences, each because this CRM is Prova selling itself rather than
/// a tenant managing its GCs:
///
///   - SITE_VISIT is gone and DEMO is here. Nobody visits a software
///     prospect's site; the demo is the meeting that moves the deal.
///   - There is no followUpAssignedToUserId. ContactInteraction separates
///     who logged a call from whose job the follow-up is, because a
///     company has estimators and PMs who hand work to each other. This
///     feature is gated on role === "OWNER", so every follow-up already
///     belongs to the only person who can see the page; a field naming an
///     assignee who cannot open /sales would be worse than no field.
///   - The follow-up is attached to the lead, not to a person at it --
///     there is no ContactPerson equivalent here yet.
model SalesActivity {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  leadId    String
  lead      SalesLead @relation(fields: [leadId], references: [id])

  type SalesActivityType
  /// Entered, not stamped -- logging Monday's call on Wednesday must record
  /// Monday. Same rule as every other date in this schema.
  occurredOn DateTime
  summary    String

  /// Null = nothing owed. Set = the date the next contact is due.
  ///
  /// Read at most ONE open follow-up per lead, from its LATEST activity --
  /// see lib/sales-activity.ts. An older activity's followUpOn is history,
  /// superseded by definition, not a second thing owed. That is a real
  /// trade and worth stating: it means logging a new activity replaces
  /// whatever the lead owed, so clearing a follow-up is the explicit act of
  /// logging the next contact with the date left blank. The alternative --
  /// every followUpOn stays open forever until someone ticks it off -- needs
  /// a stored done-flag, and a lead you owe three separate calls to is not a
  /// thing that happens.
  followUpOn DateTime?

  /// Which deal this was about, when it was about one. Optional because
  /// plenty of contact is not: an intro call happens before any opportunity
  /// exists, and a check-in with a lost lead belongs to no deal at all.
  /// SetNull rather than the RESTRICT on leadId above, for the same reason
  /// ContactInteraction.contactPersonId is: deleting a deal should not be
  /// blocked by old history, and those rows fall back to being attributed
  /// to the lead alone.
  opportunityId String?
  opportunity   SalesOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: SetNull)

  /// Who recorded it. Audit-only, not editable after creation. Nullable
  /// like ContactInteraction.loggedByUserId -- a deleted user must not take
  /// the history with them.
  loggedByUserId String?
  loggedByUser   User?   @relation("SalesActivityLogger", fields: [loggedByUserId], references: [id])

  createdAt DateTime @default(now())

  @@index([leadId])
  @@index([companyId])
  @@index([followUpOn])
  @@index([opportunityId])
}

/// When an opportunity moved from one stage to the next.
///
/// SalesOpportunity.stage is a single mutable field, so before this
/// existed "how long has this sat in DEMO_SCHEDULED" -- the most useful
/// number a pipeline has -- could not be answered at all, no matter how
/// many times somebody updated the stage.
///
/// Written only by createSalesOpportunity and updateSalesOpportunity, in
/// the same transaction as the row itself, and never edited or deleted.
/// A wrong move is corrected by making the move again; the history keeps
/// both rows, which is what an audit trail is for. There are deliberately
/// no create/update/delete actions of its own.
///
/// NO BACKFILL, on purpose. The tempting migration is one row per existing
/// opportunity with effectiveOn = createdAt, and it would assert that every
/// deal has been in its current stage since the day it was created -- false
/// for any that has moved, and false invisibly, as a plausible number.
/// Opportunities that predate this model read "not recorded" and their
/// history starts at their next change. Blank means nobody wrote it down.
model SalesStageChange {
  id            String           @id @default(cuid())
  companyId     String
  company       Company          @relation(fields: [companyId], references: [id])
  opportunityId String
  opportunity   SalesOpportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)

  /// Null on the opening record -- the opportunity did not come from
  /// anywhere, it was created at this stage. Every later row has one.
  fromStage OpportunityStage?
  toStage   OpportunityStage

  /// The day the DEAL moved, entered by the person recording it. Not
  /// stamped: recording on Wednesday that the demo happened on Monday must
  /// record Monday, same rule as SalesActivity.occurredOn. A stamped
  /// changedAt would measure when somebody got round to updating Prova,
  /// which is a different quantity wearing the same name.
  effectiveOn DateTime

  /// Why it moved, if anyone said. Optional -- most moves need no
  /// explanation and a required box would just collect "moved".
  note String?

  /// When the row was written, as distinct from when the deal moved.
  /// Audit only, and the tie-break when two moves share an effectiveOn.
  recordedAt       DateTime @default(now())
  recordedByUserId String?
  recordedByUser   User?    @relation("SalesStageChangeRecorder", fields: [recordedByUserId], references: [id])

  @@index([opportunityId])
  @@index([companyId])
}
