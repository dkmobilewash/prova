// Company, users, invites and GC contacts.
//
// Part of the multi-file Prisma schema in this folder.

model Company {
  id   String @id @default(cuid())
  name String

  /// Company profile fields — all optional since existing companies
  /// predate them and there's no backfill source. `name` stays the
  /// existing display name; `dbaName` is a separate "doing business as"
  /// name where one exists.
  dbaName        String?
  ein            String?
  hqAddressLine1 String?
  hqAddressLine2 String?
  hqCity         String?
  hqState        String?
  hqZip          String?
  phone          String?
  website        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                   User[]
  contacts                Contact[]
  jobs                    Job[]
  invites                 Invite[]
  quickBooksConnection    QuickBooksConnection?
  quickBooksEntityLinks   QuickBooksEntityLink[]
  quickBooksAccountMaps   QuickBooksAccountMapping[]
  quickBooksSyncAttempts  QuickBooksSyncAttempt[]
  integrationConnections  IntegrationConnection[]
  complianceDocuments     ComplianceDocument[]
  licenses                CompanyLicense[]
  tradeScopes             CompanyTradeScope[]
  unionAgreements         CompanyUnionAgreement[]
  insurancePolicies       CompanyInsurancePolicy[]
  bonds                   CompanyBond[]
  locations               CompanyLocation[]
  bidInvitations          BidInvitation[]
  vendors                 Vendor[]
  equipment               Equipment[]
  lineItemCatalogEntries  LineItemCatalogEntry[]
  punchListItems          PunchListItem[]
  dailyFieldReports       DailyFieldReport[]
  rfis                    Rfi[]
  backcharges             Backcharge[]
  closeoutSubmissions     CloseoutSubmission[]
  alertAcknowledgements   AlertAcknowledgement[]
  prevailingWageRuleSets  PrevailingWageRuleSet[]
  submittals              Submittal[]
  safetyCaseCounters      SafetyCaseCounter[]
  safetyIncidents         SafetyIncident[]
  toolboxTalks            ToolboxTalk[]
  materialOrders          MaterialOrder[]
  drawingSets             DrawingSet[]
  closeoutItems           CloseoutItem[]
  warrantyPeriods         WarrantyPeriod[]
  warrantyServiceRequests WarrantyServiceRequest[]
  vendorPriceQuotes       VendorPriceQuote[]
  outboundMessages        OutboundMessage[]
  contactInteractions     ContactInteraction[]
  apprenticeshipEnrollments ApprenticeshipEnrollment[]
  contactPeople           ContactPerson[]
}

enum UserRole {
  OWNER
  MEMBER
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  // Defaults to OWNER (not MEMBER) so the migration backfill is correct for
  // every User row that already exists in production today: pre-this-phase,
  // every user was the sole/first user of their Company, i.e. its owner.
  // New rows always set this explicitly in code (OWNER on first sign-in,
  // MEMBER on invite acceptance) — this default only matters for backfill.
  role      UserRole @default(OWNER)

  /// What this person does, as distinct from `role` above — see
  /// permissions.prisma. Nullable, with no backfill: null means nobody
  /// has said, and the person keeps the full office access every MEMBER
  /// has always had. Only an OWNER can set it, and an OWNER's own
  /// capabilities never depend on it.
  jobFunction JobFunction?

  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments                          JobAssignment[]
  connectedQuickBooks                  QuickBooksConnection[]
  quickBooksSyncAttempts               QuickBooksSyncAttempt[]
  connectedIntegrations                IntegrationConnection[]
  uploadedComplianceDocuments          ComplianceDocument[]
  savedEstimateVersions                EstimateVersion[]
  uploadedContractDocuments            ContractDocument[]
  timeEntries                          TimeEntry[]
  dispatchSlips                        DispatchSlip[]
  uploadedPrevailingWageDeterminations PrevailingWageDetermination[]
  createdRetainageReleases             RetainageRelease[]
  raisedPunchListItems                 PunchListItem[]
  filedDailyFieldReports               DailyFieldReport[]
  askedRfis                            Rfi[]
  loggedBackcharges                    Backcharge[]
  submittedCloseoutPackages            CloseoutSubmission[]
  alertAcknowledgements                AlertAcknowledgement[]
  submittedSubmittals                  Submittal[]
  reportedSafetyIncidents              SafetyIncident[]
  recordedToolboxTalks                 ToolboxTalk[]
  placedMaterialOrders                 MaterialOrder[]
  recordedDrawingRevisions             DrawingRevision[]
  recordedWarrantyServiceRequests      WarrantyServiceRequest[]
  recordedVendorPriceQuotes            VendorPriceQuote[]
  sentOutboundMessages                 OutboundMessage[]
  loggedContactInteractions            ContactInteraction[] @relation("ContactInteractionLogger")
  assignedContactFollowUps             ContactInteraction[] @relation("ContactInteractionFollowUp")

  @@index([companyId])
  apprenticeshipEnrollments ApprenticeshipEnrollment[] @relation("ApprenticeEnrollments")
}

/// A pending invitation for someone to join a Company. Deleted once
/// accepted — see requireCompanyContext() in apps/web/lib/auth.ts, which
/// checks for a matching Invite (by email) before creating a brand new
/// Company on first sign-in.
model Invite {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([companyId])
}

/// PROSPECT: a GC we're talking to but have no history with yet.
/// ACTIVE: a GC we've worked for. INACTIVE: gone quiet / not pursuing.
/// Existing rows backfill to ACTIVE, not a guess — every Contact before
/// this field existed was created because a Job was opened with them, so
/// ACTIVE is the fact already on record, not an invented default.
enum ContactStatus {
  PROSPECT
  ACTIVE
  INACTIVE
}

/// What kind of company this is, independent of ContactStatus (which
/// answers "are we engaging with them," not "what are they"). Nullable
/// with NO backfill: nobody has classified any existing Contact by type,
/// and guessing GENERAL_CONTRACTOR for all of them would be wrong the
/// first time an existing row turns out to be a developer or a vendor —
/// same reasoning as User.jobFunction and CraftClassification.tier.
enum ContactType {
  GENERAL_CONTRACTOR
  DEVELOPER
  VENDOR
  SUBCONTRACTOR
}

model Contact {
  id          String        @id @default(cuid())
  companyId   String
  company     Company       @relation(fields: [companyId], references: [id])
  name        String
  email       String?
  phone       String?
  address     String?
  status      ContactStatus @default(ACTIVE)
  accountType ContactType?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  /// Generated on-demand (client portal "enable" action), null until then.
  /// Same access-control pattern as SignatureRequest.token: an unguessable
  /// link stands in for a client login that doesn't exist yet.
  portalToken String? @unique

  /// Standing terms this GC typically works under — a starting point to
  /// pre-fill Job.retainagePercent when scoping a new job with them, not a
  /// value enforced anywhere itself. Actual per-job retainage withheld/
  /// released tracking lives on Job/Invoice/RetainageRelease — see
  /// ARCHITECTURE.md.
  defaultRetainagePercent Decimal? @db.Decimal(5, 2)
  /// e.g. 30 for "Net 30". Free-standing integer rather than an enum —
  /// real GC payment terms vary too much (Net 30/45/60, "pay when paid")
  /// to fit a fixed list.
  paymentTermsDays        Int?
  /// Free text (e.g. "AIA A401", "ConsensusDocs 750") — which standard
  /// subcontract form this GC typically uses.
  standardFormsUsed       String?

  /// Null = no Master Service Agreement on file. Set = the date it expires;
  /// whether it's active or lapsed is computed at read time from that date,
  /// never stored as a separate status — same rule as every other
  /// expiration in this schema (licenses, insurance, bonds).
  msaExpirationDate DateTime?
  /// Null = never prequalified with this GC. Set = the date the
  /// prequalification expires; current/expiring/expired is derived the
  /// same way as msaExpirationDate, not stored twice.
  prequalificationExpiresAt DateTime?

  jobs           Job[]
  bidInvitations BidInvitation[]
  interactions   ContactInteraction[]
  people         ContactPerson[]

  @@index([companyId])
}
