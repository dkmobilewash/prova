// Prisma schema for Prova.
//
// See /ARCHITECTURE.md for the full explanation of why Job/JobLineItem is a
// single unified object shared by the estimate, contract, budget, change
// orders, and job costing — read that before adding a new model that looks
// like it duplicates line-item data.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local dev; "rhel-openssl-3.0.x" is the runtime Vercel's
  // serverless functions use, which differs from the build machine — without
  // this, the query engine binary generated at build time doesn't match what
  // the deployed function needs. See https://pris.ly/d/engine-not-found-nextjs
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id   String @id @default(cuid())
  name String

  /// Company profile fields — all optional since existing companies
  /// predate them and there's no backfill source. `name` stays the
  /// existing display name; `dbaName` is a separate "doing business as"
  /// name where one exists.
  dbaName        String?
  ein            String?
  hqAddressLine1 String?
  hqAddressLine2 String?
  hqCity         String?
  hqState        String?
  hqZip          String?
  phone          String?
  website        String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                User[]
  contacts             Contact[]
  jobs                 Job[]
  invites              Invite[]
  quickBooksConnection QuickBooksConnection?
  complianceDocuments  ComplianceDocument[]
  licenses             CompanyLicense[]
  tradeScopes          CompanyTradeScope[]
  unionAgreements      CompanyUnionAgreement[]
  insurancePolicies    CompanyInsurancePolicy[]
  bonds                CompanyBond[]
  locations            CompanyLocation[]
}

enum UserRole {
  OWNER
  MEMBER
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  // Defaults to OWNER (not MEMBER) so the migration backfill is correct for
  // every User row that already exists in production today: pre-this-phase,
  // every user was the sole/first user of their Company, i.e. its owner.
  // New rows always set this explicitly in code (OWNER on first sign-in,
  // MEMBER on invite acceptance) — this default only matters for backfill.
  role      UserRole @default(OWNER)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignments                 JobAssignment[]
  connectedQuickBooks         QuickBooksConnection[]
  uploadedComplianceDocuments ComplianceDocument[]

  @@index([companyId])
}

/// A pending invitation for someone to join a Company. Deleted once
/// accepted — see requireCompanyContext() in apps/web/lib/auth.ts, which
/// checks for a matching Invite (by email) before creating a brand new
/// Company on first sign-in.
model Invite {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  email     String   @unique
  createdAt DateTime @default(now())

  @@index([companyId])
}

model Contact {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id])
  name      String
  email     String?
  phone     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Generated on-demand (client portal "enable" action), null until then.
  /// Same access-control pattern as SignatureRequest.token: an unguessable
  /// link stands in for a client login that doesn't exist yet.
  portalToken String? @unique

  jobs Job[]

  @@index([companyId])
}

enum JobStatus {
  ESTIMATE
  CONTRACTED
  IN_PROGRESS
  COMPLETE
}

/// The unified object. A Job's `lineItems` ARE the estimate, the budget, the
/// contract content, and the job-costing structure — there is no separate
/// table for any of those views. See /ARCHITECTURE.md.
model Job {
  id        String    @id @default(cuid())
  companyId String
  company   Company   @relation(fields: [companyId], references: [id])
  contactId String
  contact   Contact   @relation(fields: [contactId], references: [id])
  name      String
  scope     String?
  status    JobStatus @default(ESTIMATE)
  // Single start/end dates on the Job itself — properties of the job, not a
  // list of entries, so (unlike CostEntry/ChangeOrder) this doesn't need a
  // separate table. Nullable: most jobs start unscheduled.
  startDate DateTime?
  endDate   DateTime?

  /// Which office/yard is running this job. Nullable: most existing jobs
  /// predate this and there's no backfill source. This is a place to
  /// RECORD the operating location only — nothing yet reads it to
  /// auto-derive the applicable license or union agreement; that's real
  /// application logic for a future phase, not built here.
  operatingLocationId String?
  operatingLocation   CompanyLocation? @relation(fields: [operatingLocationId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  lineItems           JobLineItem[]
  changeOrders        ChangeOrder[]
  assignments         JobAssignment[]
  signatureRequests   SignatureRequest[]
  invoices            Invoice[]
  complianceDocuments ComplianceDocument[]

  @@index([companyId])
  @@index([contactId])
  @@index([operatingLocationId])
}

/// The five WWCCA trade families a wall-and-ceiling specialty subcontractor
/// self-performs. A flat categorization tag, not a hierarchy — a company
/// may hold several of these in-house and job costing needs to separate
/// them. Deliberately not a self-performed-vs-subcontracted model or full
/// CSI MasterFormat coding: this ICP is a narrow-trade-family sub, not a
/// diversified GC coordinating many subs.
enum TradeScope {
  METAL_FRAMING_DRYWALL
  LATH_PLASTER
  EIFS
  ACOUSTICAL_CEILINGS
  FIREPROOFING
}

/// Which trade scopes a Company actually holds/self-performs — reuses the
/// TradeScope enum above rather than a parallel reference table, so there's
/// one source of truth for "what are the five trade scopes." A company may
/// add a trade scope later as it grows rather than holding all five from
/// day one, hence `activeSince` rather than assuming everything started at
/// company creation.
model CompanyTradeScope {
  id          String     @id @default(cuid())
  companyId   String
  company     Company    @relation(fields: [companyId], references: [id])
  tradeScope  TradeScope
  isPrimary   Boolean    @default(false)
  activeSince DateTime?
  createdAt   DateTime   @default(now())

  @@unique([companyId, tradeScope])
  @@index([companyId])
}

/// A single line item, referenced everywhere: estimate, contract summary,
/// budget total, and job costing. A change order mutates rows in this table
/// (or adds new ones) — it never forks them into a parallel shape.
model JobLineItem {
  id          String  @id @default(cuid())
  jobId       String
  job         Job     @relation(fields: [jobId], references: [id])
  description String
  quantity    Decimal @default(1) @db.Decimal(12, 2)
  unit        String?

  /// Optional — a categorization dimension on top of the cost/WIP fields
  /// below, not a prerequisite for them.
  tradeScope TradeScope?
  /// Nullable: a cost-only budget line (general conditions, overhead,
  /// contingency) has no client-facing sale price. Contract value /
  /// invoicing totals treat a null unitPrice as $0 revenue — the line still
  /// carries quantity and cost fields, it just isn't billed directly.
  unitPrice Decimal? @db.Decimal(12, 2)
  sortOrder Int      @default(0)

  /// The estimated unit cost at the time this line was priced (estimate
  /// approval). Set once, stays put as the historical baseline for WIP
  /// reporting — never silently overwritten by later re-forecasting.
  budgetedUnitCost Decimal? @db.Decimal(12, 2)

  /// The PM's current forecast of unit cost, re-estimated as the job
  /// progresses. Defaults to budgetedUnitCost at creation (app-level, not a
  /// DB default) but is independently mutable afterward. This is what
  /// feeds the live percent-complete calculation — see lib/wip.ts.
  currentEstimatedUnitCost Decimal? @db.Decimal(12, 2)

  /// PM override for cost-to-complete. When null, it's derived mechanically
  /// as (currentEstimatedUnitCost * quantity) - actual costs to date. When
  /// set, it overrides that mechanical number — e.g. the PM knows a sub is
  /// behind schedule or a change order is coming before the cost data
  /// reflects it. See lib/wip.ts.
  estimatedCostToComplete Decimal? @db.Decimal(12, 2)

  /// Soft delete: a change order can remove scope without losing history.
  /// Deleted line items are excluded from budget/contract totals.
  isDeleted Boolean @default(false)

  /// Set only when this row was created BY a change order (added scope).
  /// Null for line items that were part of the original estimate.
  originChangeOrderId String?
  originChangeOrder   ChangeOrder? @relation("OriginChangeOrder", fields: [originChangeOrderId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  edits       ChangeOrderLineItemEdit[]
  costEntries CostEntry[]

  @@index([jobId])
  @@index([originChangeOrderId])
}

/// A change order groups: (a) newly added JobLineItems (via
/// JobLineItem.originChangeOrderId), and (b) edits to existing JobLineItems
/// (logged in ChangeOrderLineItemEdit). It never stores its own copy of
/// line-item data.
model ChangeOrder {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id])
  number      Int
  title       String
  description String?
  createdAt   DateTime @default(now())

  addedLineItems JobLineItem[]             @relation("OriginChangeOrder")
  edits          ChangeOrderLineItemEdit[]

  @@unique([jobId, number])
  @@index([jobId])
}

/// Audit log only. Records what a change order changed on an EXISTING
/// JobLineItem (old value -> new value). The live value always lives on
/// JobLineItem itself — nothing reads totals from this table.
model ChangeOrderLineItemEdit {
  id            String      @id @default(cuid())
  changeOrderId String
  changeOrder   ChangeOrder @relation(fields: [changeOrderId], references: [id])
  lineItemId    String
  lineItem      JobLineItem @relation(fields: [lineItemId], references: [id])
  field         String
  oldValue      String
  newValue      String
  createdAt     DateTime    @default(now())

  @@index([changeOrderId])
  @@index([lineItemId])
}

enum CostCategory {
  LABOR
  MATERIAL
  SUBCONTRACTOR
  OTHER
}

/// An actual expense logged against a JobLineItem — references the line
/// item rather than duplicating it, the same way ChangeOrder does. Actual
/// cost per line item is SUM(costEntries.amount), computed, never stored.
/// Unlike change orders, logging a cost isn't gated by job status: real
/// spending happens throughout the job, especially once work is in
/// progress.
model CostEntry {
  id          String       @id @default(cuid())
  lineItemId  String
  lineItem    JobLineItem  @relation(fields: [lineItemId], references: [id])
  description String
  amount      Decimal      @db.Decimal(12, 2)
  category    CostCategory @default(OTHER)

  /// Independent of the parent JobLineItem's tradeScope — a "general
  /// conditions" line can carry cost entries spanning several trades, so
  /// this is tagged per-expense, not just inherited from the line item.
  tradeScope TradeScope?
  incurredAt  DateTime     @default(now())
  createdAt   DateTime     @default(now())

  @@index([lineItemId])
}

/// Crew assignment: which company Users are on a Job. Genuinely many-to-many
/// (a job can have several people, a person can be on several jobs), so —
/// unlike startDate/endDate — this needs a join table. References Job and
/// User directly; never duplicates their data.
model JobAssignment {
  id        String   @id @default(cuid())
  jobId     String
  job       Job      @relation(fields: [jobId], references: [id])
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@unique([jobId, userId])
  @@index([jobId])
  @@index([userId])
}

enum SignatureStatus {
  PENDING
  SIGNED
}

/// A client e-signature request for a Job's contract. The unguessable
/// `token` is the client's access control — there's no client login
/// (that's a separate, not-yet-built phase), so the token stands in for
/// one. Once signed, `snapshot` freezes what the client actually agreed to
/// at that moment: it's an audit record only, exactly like
/// ChangeOrderLineItemEdit — nothing live (the contract summary, the
/// budget) ever reads from it. See ARCHITECTURE.md.
model SignatureRequest {
  id     String          @id @default(cuid())
  jobId  String
  job    Job             @relation(fields: [jobId], references: [id])
  token  String          @unique @default(cuid())
  status SignatureStatus @default(PENDING)

  signerName  String?
  signerEmail String?
  signedAt    DateTime?
  ipAddress   String?
  userAgent   String?
  snapshot    Json?

  createdAt DateTime @default(now())

  @@index([jobId])
}

/// A bill against a Job. Amount paid and balance are always
/// SUM(payments.amount) vs. amount — computed, never stored, same rule as
/// actual cost on JobLineItem. Only creatable once a job is CONTRACTED or
/// later: you don't invoice an estimate nobody agreed to yet.
model Invoice {
  id          String    @id @default(cuid())
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  number      Int
  description String?
  amount      Decimal   @db.Decimal(12, 2)
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?

  payments Payment[]

  @@unique([jobId, number])
  @@index([jobId])
}

/// A payment received against an Invoice. No payment processor — this is a
/// manual record (check, cash, card swipe elsewhere), not a charge. An
/// invoice can have several, supporting partial/progress payments.
model Payment {
  id         String   @id @default(cuid())
  invoiceId  String
  invoice    Invoice  @relation(fields: [invoiceId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String?
  receivedAt DateTime @default(now())
  note       String?

  @@index([invoiceId])
}

/// One QuickBooks Online connection per Company. Tokens stored as plain
/// columns (sandbox-appropriate; revisit encryption-at-rest before this
/// connects to a real production QuickBooks account — see ARCHITECTURE.md).
/// This is connection infrastructure only: no Contact/Invoice data is
/// pushed to QuickBooks yet. See packages/integrations/src/quickbooks.ts.
model QuickBooksConnection {
  id        String  @id @default(cuid())
  companyId String  @unique
  company   Company @relation(fields: [companyId], references: [id])

  /// The QuickBooks company ID this connection is scoped to.
  realmId String

  accessToken           String
  refreshToken          String
  accessTokenExpiresAt  DateTime
  refreshTokenExpiresAt DateTime

  connectedByUserId String?
  connectedByUser   User?   @relation(fields: [connectedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ComplianceDocumentType {
  LIEN_WAIVER
  CERTIFICATE_OF_INSURANCE
  CERTIFIED_PAYROLL
  UNION_FRINGE_BENEFIT_FILING
  UNION_AGREEMENT
}

enum ComplianceDocumentStatus {
  PENDING
  RECEIVED
}

/// Tracks compliance paperwork — lien waivers, certificates of insurance,
/// certified payroll reports, and union fringe/benefit filings. All four
/// share the same shape: a document tied to a party (subcontractor,
/// vendor, or union trust fund), often a specific job, with a lifecycle
/// (requested -> received) and, for COIs, an expiration to track renewal.
///
/// Not yet wired to file storage — no infrastructure decision has been
/// made about where uploaded PDFs live, and AI extraction (reading a
/// scanned lien waiver/COI into these fields) may not even need to
/// persist the source file, just the structured data. Both are future
/// phases, blocked on a real Anthropic API key. See ARCHITECTURE.md.
model ComplianceDocument {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  /// Optional: some documents are job-specific (a lien waiver, certified
  /// payroll for a job's crew); others are company-level (a general
  /// liability COI covering all jobs).
  jobId String?
  job   Job?    @relation(fields: [jobId], references: [id])

  type ComplianceDocumentType

  /// The subcontractor, vendor, or union trust fund this document is
  /// about. Free text rather than a new Subcontractor/Vendor directory
  /// model — that's a separate modeling decision this phase doesn't need
  /// to make yet.
  partyName String

  status ComplianceDocumentStatus @default(PENDING)

  /// Lien waiver amount, or fringe-benefit contribution amount. Null for
  /// a COI (no dollar amount).
  amount Decimal? @db.Decimal(12, 2)

  /// The billing/reporting period this document covers — a certified
  /// payroll week, a fringe filing month, a lien waiver's covered payment
  /// period. Null for a COI (it doesn't cover a period).
  periodStart DateTime?
  periodEnd   DateTime?

  /// When the document took effect — a COI's effective date, a lien
  /// waiver's signed date.
  effectiveDate DateTime?

  /// A COI's expiration date. Whether a document is "expired" or
  /// "expiring soon" is computed at read time from this field, never
  /// stored as a separate status — same rule as every computed total
  /// elsewhere in this schema (it would just go stale otherwise).
  expiresAt DateTime?

  notes String?

  uploadedByUserId String?
  uploadedByUser   User?   @relation(fields: [uploadedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// A CBA (type UNION_AGREEMENT) can be linked from CompanyUnionAgreement
  /// as its source document.
  companyUnionAgreements CompanyUnionAgreement[]

  @@index([companyId])
  @@index([jobId])
  @@index([expiresAt])
}

enum JurisdictionType {
  STATE
  COUNTY
  CITY
}

enum LicenseStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
  PENDING
  INACTIVE
}

/// One row per license HELD, not per state — some jurisdictions (Colorado)
/// have no state license at all, only municipal ones, so a company working
/// in two Colorado cities holds two separate rows here, not one "Colorado"
/// row. classificationCode/Label are free text rather than a hardcoded
/// enum: licensing structure isn't uniform across jurisdictions (CA/AZ
/// split by trade, UT combines several trades into one code, CO has no
/// classification system at all) — see LicenseClassificationReference for
/// the jurisdictions where a fixed code list actually exists.
model CompanyLicense {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  jurisdictionType JurisdictionType
  /// e.g. "California", "Arizona", or "City of Longmont, CO" for a
  /// municipal license.
  jurisdictionName String

  classificationCode  String?
  classificationLabel String?

  licenseNumber String
  issueDate     DateTime?
  /// Whether a license is "expiring soon" is computed at read time from
  /// this field, same rule as ComplianceDocument.expiresAt.
  expirationDate DateTime?
  status         LicenseStatus @default(ACTIVE)
  /// Only for jurisdictions that tie a bond to the license itself —
  /// distinct from the company's general bonding capacity (CompanyBond,
  /// a later phase).
  bondNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([expirationDate])
}

/// A global lookup, not scoped to a Company — the same CA/AZ/UT
/// classification codes apply to every company licensed in those states.
/// Only seeded for jurisdictions with a real, verified, fixed
/// classification list (CA, AZ, UT). Deliberately NOT seeded for Nevada:
/// the exact NAC 624 subclassification wasn't available from a public
/// source, and a wrong guess here is worse than an empty table — see
/// ARCHITECTURE.md. Jurisdictions with no classification system at all
/// (Colorado's municipal licenses) never get rows here; CompanyLicense's
/// classificationCode/Label just stay free text for those.
model LicenseClassificationReference {
  id               String   @id @default(cuid())
  jurisdictionName String
  code             String
  label            String
  createdAt        DateTime @default(now())

  @@unique([jurisdictionName, code])
}

/// A global reference table (not scoped to a Company) — the same union
/// local applies to every company that works under it. Deliberately NOT
/// seeded: no verified source for real local numbers/jurisdictions, and a
/// wrong entry here would misattribute a company's CBA to the wrong local.
model UnionLocal {
  id                  String @id @default(cuid())
  parentInternational String // "United Brotherhood of Carpenters", "OPCMIA", "IUPAT", "LIUNA"
  localNumber         String
  jurisdictionName    String
  tradeJurisdiction   String?
  createdAt           DateTime @default(now())

  craftClassifications CraftClassification[]
  apprenticeRatioRules ApprenticeRatioRule[]
  companyAgreements    CompanyUnionAgreement[]

  @@unique([parentInternational, localNumber])
}

/// One CBA between a Company and a UnionLocal. `complianceDocument` links
/// to the actual agreement document (type UNION_AGREEMENT) if one's been
/// uploaded — reuses the existing document-tracking table rather than a
/// separate file reference.
model CompanyUnionAgreement {
  id           String     @id @default(cuid())
  companyId    String
  company      Company    @relation(fields: [companyId], references: [id])
  unionLocalId String
  unionLocal   UnionLocal @relation(fields: [unionLocalId], references: [id])

  effectiveFrom DateTime
  effectiveTo   DateTime?

  complianceDocumentId String?
  complianceDocument   ComplianceDocument? @relation(fields: [complianceDocumentId], references: [id])

  createdAt DateTime @default(now())

  @@index([companyId])
  @@index([unionLocalId])
}

/// Craft classifications and their progression aren't standardized across
/// locals (journeyman, apprentice period 1-5, foreman — the exact steps
/// vary), so this is tied to a specific UnionLocal rather than a shared
/// list.
model CraftClassification {
  id           String     @id @default(cuid())
  unionLocalId String
  unionLocal   UnionLocal @relation(fields: [unionLocalId], references: [id])
  name         String
  createdAt    DateTime   @default(now())

  fringeRateSchedules FringeRateSchedule[]

  @@unique([unionLocalId, name])
  @@index([unionLocalId])
}

/// Effective-dated, not a flat current-rate field: CBA rates typically
/// change annually, and job costing or certified payroll on an older job
/// needs the rate that was in effect AT THE TIME, not today's rate. A flat
/// rate field would quietly corrupt historical job costing the first time
/// a rate changed mid-project. `effectiveTo` null means currently in
/// effect. Non-overlapping ranges per craft classification are enforced
/// at the database level below (an EXCLUDE constraint — see the migration
/// SQL; Prisma's schema language has no declarative way to express this,
/// so it's hand-written raw SQL in the migration rather than generated
/// from this model).
model FringeRateSchedule {
  id                    String @id @default(cuid())
  craftClassificationId String
  craftClassification   CraftClassification @relation(fields: [craftClassificationId], references: [id])

  baseWage          Decimal  @db.Decimal(12, 2)
  pensionRate       Decimal? @db.Decimal(12, 2)
  vacationRate      Decimal? @db.Decimal(12, 2)
  healthWelfareRate Decimal? @db.Decimal(12, 2)
  trainingRate      Decimal? @db.Decimal(12, 2)

  effectiveFrom DateTime
  effectiveTo   DateTime?

  createdAt DateTime @default(now())

  @@index([craftClassificationId])
  @@index([effectiveFrom])
}

/// Captures the ratio rule itself (e.g. 1 apprentice per 3 journeymen).
/// Does NOT implement the actual daily compliance check — ratios are
/// enforced daily, not on a monthly rollup, which needs a labor/time-entry
/// data model that doesn't exist anywhere in this schema yet. That check
/// is real future work, not something this table alone can drive.
model ApprenticeRatioRule {
  id                       String     @id @default(cuid())
  unionLocalId             String
  unionLocal               UnionLocal @relation(fields: [unionLocalId], references: [id])
  apprenticeCount          Int
  journeymenCount          Int
  programStandardReference String?
  createdAt                DateTime   @default(now())

  @@index([unionLocalId])
}

enum InsurancePolicyType {
  GENERAL_LIABILITY
  WORKERS_COMP
  AUTO
  UMBRELLA_EXCESS
}

/// The company's own insurance record — distinct from ComplianceDocument,
/// which tracks documents flowing between this company and GCs/subs on a
/// per-job basis. This is the source data those per-job COIs eventually
/// get generated from (future phase).
model CompanyInsurancePolicy {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  policyType   InsurancePolicyType
  carrier      String
  policyNumber String

  /// Free text rather than structured limit fields — what "coverage
  /// limits" means varies by policy type (GL: per-occurrence + aggregate;
  /// auto: combined single limit; workers' comp: statutory + employer's
  /// liability), so a fixed set of columns would be wrong for at least
  /// one type.
  coverageLimits String?

  effectiveDate  DateTime?
  /// Whether a policy is expiring/expired is computed at read time from
  /// this field, never stored — same rule as CompanyLicense.
  expirationDate DateTime?

  /// Reusable boilerplate used as the starting point when generating a
  /// COI to send a GC — e.g. standard additional-insured language. Not
  /// per-job or per-GC; that customization happens when a COI actually
  /// gets generated (future phase, not built here).
  defaultCertificateHolderTemplate String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([expirationDate])
}

enum BondType {
  LICENSE_BOND
  PERFORMANCE_PAYMENT_CAPACITY
}

/// The company's own bonding record. Deliberately NOT linked to
/// CompanyLicense.bondNumber (a jurisdiction-specific bond number entered
/// on the license itself) — the two can reference the same real-world bond
/// without a forced foreign key between them; connecting them explicitly
/// is a future refinement, not guessed at here.
model CompanyBond {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  suretyName String
  bondType   BondType

  aggregateBondingCapacity Decimal? @db.Decimal(12, 2)
  singleJobLimit           Decimal? @db.Decimal(12, 2)

  agentContactName  String?
  agentContactPhone String?
  agentContactEmail String?

  /// Whether a bond is up for renewal is computed at read time from this
  /// field, never stored — same rule as everywhere else in this schema.
  renewalDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
  @@index([renewalDate])
}

enum LocationType {
  HQ
  BRANCH_YARD
  WAREHOUSE
}

/// A physical office/yard/warehouse. `state` is broken out from the
/// address specifically because it's what would eventually let the app
/// auto-derive which CompanyLicense/CompanyUnionAgreement applies to a
/// Job via Job.operatingLocationId — that derivation logic isn't built
/// yet, but the field exists for it.
model CompanyLocation {
  id        String  @id @default(cuid())
  companyId String
  company   Company @relation(fields: [companyId], references: [id])

  locationType LocationType
  /// Friendly label ("Denver Yard") for picking a location in a list —
  /// not explicitly requested, but without one a picker would just show
  /// raw addresses.
  name String?

  addressLine1 String
  addressLine2 String?
  city         String
  state        String
  zip          String

  primaryContactName  String?
  primaryContactPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  jobs Job[]

  @@index([companyId])
}
